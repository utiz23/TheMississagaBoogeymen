#!/usr/bin/env bash
#
# Change-aware pre-push hook (Tier 0 WS0.2; scoped to video-stats changes
# 2026-10-05).
#
# A push is classified before anything else runs:
#   - a push that touches video-stats code (tools/game_ocr/, tools/video_ingest/,
#     apps/worker/scripts/, or any non-notes path with an "ocr" segment), or
#     that the classifier cannot read reliably (tags, non-fast-forward updates,
#     malformed stdin, a new branch with no common history with origin/main),
#     runs the full scripts/verify-ocr.sh harness, fail-closed on missing
#     verification-database configuration.
#   - every other push takes a fast path: a committed-range `git diff --check`
#     and nothing more. No verification-database credentials are read or
#     required. A new branch is compared with where it left origin/main.
#
# The classifier lives in .githooks/lib/classify-push.mjs (unit-tested) and
# .githooks/lib/classify-push-cli.mjs (thin stdin/exit-code wrapper). See
# ops/README.md for the full policy and the EANHL_PRE_PUSH_FULL=1 override
# that forces full verification regardless of classification — use it when
# pushing video-stats work in files without "ocr" in their path.
#
# Self-installing: the root package.json `prepare` script points
# core.hooksPath at .githooks on `pnpm install`, so this hook is active for
# anyone who sets the repo up the normal way.
#
# Like any client-side git hook this is technically bypassable
# (`git push --no-verify`). That is not the normal mechanism for a push
# without video-stats changes — the fast path already skips the heavy
# suite — and it is not the normal mechanism for anything else either: the
# authoritative, fail-closed enforcement for OCR correctness is the
# `decoder-runs activate` quality gate (WS0.1A), which does not depend on
# local git config. If verification is blocking a push that should be
# skippable, that is a signal to inspect and fix the classification (see
# ops/README.md), not to reach for --no-verify. EANHL_PRE_PUSH_FULL=1 forces
# the full ~20-minute suite; it does not fix classification or documentation
# whitespace problems, so it is not a remedy for a push that should have
# taken the fast path.
#
# THIS HOOK NEVER SOURCES THE APPLICATION `.env`.
# It used to, which meant a push silently handed the PRODUCTION DATABASE_URL to
# suites that write. Verification now requires an explicitly configured,
# attested nonproduction cluster; see ops/README.md. If that configuration is
# absent and full verification is required, the hook FAILS rather than
# skipping — a missing safety configuration must not read as "nothing to
# check".

set -uo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Verification must never inherit an application DSN, on any path.
unset DATABASE_URL

STDIN_DATA="$(cat)"

CLASSIFY_OUTPUT="$(printf '%s' "$STDIN_DATA" | node "$REPO_ROOT/.githooks/lib/classify-push-cli.mjs" "$REPO_ROOT" 2>&1)"
CLASSIFY_EXIT=$?

case "$CLASSIFY_EXIT" in
  0)
    # fast path, git diff --check passed: push allowed, nothing heavy ran.
    echo "$CLASSIFY_OUTPUT" >&2
    exit 0
    ;;
  1)
    # fast path, but git diff --check found a problem in the committed range: block.
    echo "$CLASSIFY_OUTPUT" >&2
    exit 1
    ;;
  2)
    # Full verification required (or explicitly forced).
    echo "$CLASSIFY_OUTPUT" >&2
    ;;
  *)
    # Classifier crashed in a way its own fallback didn't catch. Fail closed
    # to full verification rather than silently allowing the push.
    echo "[pre-push] classifier exited unexpectedly (code=$CLASSIFY_EXIT); falling back to full verification." >&2
    echo "$CLASSIFY_OUTPUT" >&2
    ;;
esac

MISSING=()
for var in TEST_DATABASE_URL TEST_DB_CONTAINER TEST_DB_COMPOSE_PROJECT TEST_DB_COMPOSE_SERVICE; do
  [ -n "${!var:-}" ] || MISSING+=("$var")
done

if [ "${#MISSING[@]}" -gt 0 ]; then
  {
    echo "[pre-push] BLOCKED: verification-database configuration is incomplete."
    printf '[pre-push]   missing: %s\n' "${MISSING[@]}"
    echo "[pre-push]"
    echo "[pre-push] These have no defaults and are deliberately NOT read from the application"
    echo "[pre-push] .env — a default or an .env fallback would point verification at the"
    echo "[pre-push] production database. Set up the disposable verification cluster once"
    echo "[pre-push] (ops/README.md), then load its env file into your shell:"
    echo "[pre-push]"
    echo "[pre-push]   set -a && . ~/.config/eanhl/verify.env && set +a"
  } >&2
  exit 1
fi

echo "[pre-push] running scripts/verify-ocr.sh (fail-closed full verification)" >&2
exec bash "$REPO_ROOT/scripts/verify-ocr.sh"
