{
  "name": "@eanhl/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack",
    "start": "next start",
    "test": "pnpm run test:unit && pnpm run test:auth-disabled && pnpm run test:http-404",
    "test:unit": "node --test \"src/**/*.test.ts\"",
    "test:auth-disabled": "node --import ./test/register-loader.mjs --test test/auth-routes-disabled.test.ts",
    "test:http-404": "node --test test/disabled-routes-http.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src \"test/**/*.ts\""
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.10",
    "@eanhl/db": "workspace:*",
    "@tailwindcss/postcss": "^4.2.2",
    "better-auth": "^1.6.10",
    "next": "^15.3.0",
    "postcss": "^8.5.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  }
}
