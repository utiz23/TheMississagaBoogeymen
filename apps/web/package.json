{
  "name": "@eanhl/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "start": "next start",
    "test": "pnpm run test:unit && pnpm run test:http-auth && pnpm run test:http-legal && pnpm run test:http-stats",
    "test:unit": "node --test \"src/**/*.test.ts\"",
    "test:http-auth": "node --test test/auth-http.test.ts",
    "test:http-legal": "node --test test/legal-http.test.ts",
    "test:http-stats": "node --test test/stats-http.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src \"test/**/*.ts\""
  },
  "dependencies": {
    "@better-auth/core": "~1.6.33",
    "@better-auth/drizzle-adapter": "~1.6.33",
    "@eanhl/db": "workspace:*",
    "@tailwindcss/postcss": "^4.2.2",
    "better-auth": "~1.6.33",
    "lucide-react": "^1.52.0",
    "next": "^15.5.27",
    "postcss": "^8.5.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  }
}
