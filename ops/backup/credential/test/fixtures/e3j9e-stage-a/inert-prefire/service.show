User=@SVC@
Group=@SVC@
WorkingDirectory=/var/lib/eanhl-cloud
UMask=0077
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
NoNewPrivileges=yes
KillMode=control-group
Type=oneshot
RemainAfterExit=yes
StandardInput=null
StandardOutput=journal
StandardError=journal
PrivateNetwork=yes
Restart=no
After=sysinit.target system.slice network-online.target basic.target
Description=eanhl-cloud credential timer diagnostic (inert)
FragmentPath=@TRANSIENT@/@STEM@.service
ExecStart={ path=/usr/bin/true ; argv[]=/usr/bin/true ; ignore_errors=no ; start_time=[n/a] ; stop_time=[n/a] ; pid=0 ; code=(null) ; status=0/0 }
Environment=
