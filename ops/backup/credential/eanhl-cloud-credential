#!/usr/bin/bash -p
# /usr/local/sbin/eanhl-cloud-credential — E3J9 root-only credential launcher
# (design §4, §6, §8, §11, §12). Install root:root 0750. Non-secret.
#
#   sudo eanhl-cloud-credential keygen
#   sudo eanhl-cloud-credential pass-init <primary-fingerprint>
#   sudo eanhl-cloud-credential probe <local-mode>     (validation only)
#   sudo eanhl-cloud-credential probe-stop <unit>      (validation only)
#   sudo eanhl-cloud-credential pty-marker             (validation only; needs a terminal)
#   sudo eanhl-cloud-credential env-proof              (validation only)
#   sudo eanhl-cloud-credential auth-login             (operator ceremony, E3J9D; PTY)
#   sudo eanhl-cloud-credential auth-logout            (local logout only; rollback)
#   sudo eanhl-cloud-credential entry-remove           (rollback/recovery only)
#   sudo eanhl-cloud-credential canary-remove          (rollback only)
#   sudo eanhl-cloud-credential key-delete <fpr>       (rollback/rotation only)
#   sudo eanhl-cloud-credential provider-probe run <mode>        (E3J9D/E3J9E; contacts Proton)
#   sudo eanhl-cloud-credential provider-probe schedule <slot>   (E3J9E only)
#   sudo eanhl-cloud-credential provider-probe collect <slot>    (E3J9E only)
#   sudo eanhl-cloud-credential provider-probe discard <slot>    (provenance-checked removal)
#
# Fixed subcommands only; there is no generic command runner. Every unit it
# builds runs the wrapper /usr/local/lib/eanhl-cloud/credential-exec as its
# only command, so every credential command runs under the credential lock and
# starts from the wrapper's twelve literals. No unit gets EnvironmentFile=; the
# only --setenv values (transient Environment=) are the validation-only nonce
# and decoys of pty-marker and env-proof and the fixed decoys of the single
# validation-only provider mode e4-decoy, which stay in the wrapper's own
# environment.
#
# Exit status: every subcommand exits 0 ONLY when every required operation AND
# every stated postcondition succeeded. A printed result line never stands in
# for success; a failed operation, a failed check or an indeterminate result
# exits non-zero (64 usage/refusal, 65 precondition, 70 operation or
# postcondition, 1 validation result not accepted).
#
# Every subcommand is a template capability, not an authorization: each host
# use is separately authorized (design §10, §12, §13). The destructive
# subcommands (entry-remove, canary-remove, key-delete) are fixed and
# precondition-checked, and belong to rollback, recovery or rotation only.
#
# Root never opens, reads or searches a path inside the eanhl-cloud-owned trees
# directly: those reads run as eanhl-cloud through setpriv, so a symlink or FIFO
# planted by that identity cannot redirect a root read.
#
# This launcher is a consistency control for root-authored units. It is not
# access control against code already running as eanhl-cloud.
#
# Output: only lines matching ^E3J9 [a-z_]+=[a-z0-9_.:-]+$ (public key metadata,
# booleans, counts, exit codes). auth-login is the exception by design: the
# CLI's own PTY output goes to the operator's terminal and nowhere else.

set -u
set -o pipefail
umask 077
PATH=/usr/sbin:/usr/bin
export PATH

readonly SVC=eanhl-cloud
readonly WRAPPER=/usr/local/lib/eanhl-cloud/credential-exec
readonly VALIDATION_DIR=/usr/local/lib/eanhl-cloud/validation
readonly SVC_HOME=/var/lib/eanhl-cloud
readonly SVC_CACHE=/var/cache/eanhl-cloud
readonly STORE=/var/lib/eanhl-cloud/password-store
readonly GNUPG_DIR=/var/lib/eanhl-cloud/gnupg
readonly LOCK_FILE=/var/lib/eanhl-cloud/locks/credential.lock
readonly CLI=/opt/eanhl-cloud/bin/proton-drive
readonly CLI_PIN=cf61c2688c45e1055d8add6221d9471a5a5b64bf3bcdb86460f5cb18414596cc4df3cdb6627c9097c94bec32a3c9915ada3211ef2ae5be33c46ebbc996ccaa28
readonly AUTH_ENTRY=ch.proton.drive/drive-sdk-cli/auth-session
readonly CANARY_ENTRY=e3j9-canary/probe
readonly KEY_UID='EANHL cloud uploader credential store (Hotel-Echo)'
readonly VOCAB='^E3J9 [a-z_]+=[a-z0-9_.:-]+$'
readonly PROC_ROOT=/proc
# The store and GNUPGHOME relative to SVC_HOME: the fixed contract paths that
# svc_exists looks up from its trusted root (checked against the absolute
# constants at startup).
readonly STORE_REL=password-store
readonly GNUPG_REL=gnupg

# Resident GnuPG daemons the auth-login preflight may tolerate. One entry per
# permitted daemon: `<final executable path>|<exact PPid>|<cgroup v2 path regex>`.
# Each rule must come from host evidence collected at M8/L2 (design §6,
# [VALIDATE]); none has been observed, so the list is EMPTY and ANY resident
# eanhl-cloud process refuses the ceremony. Filling it is a template revision
# (its sha256 changes) citing that evidence.
readonly RESIDENT_AGENT_RULES=()

# External tools, by absolute path.
readonly SYSTEMCTL=/usr/bin/systemctl
readonly SYSTEMD_RUN=/usr/bin/systemd-run
readonly JOURNALCTL=/usr/bin/journalctl
readonly SETPRIV=/usr/bin/setpriv
readonly PGREP=/usr/bin/pgrep
readonly FLOCK=/usr/bin/flock
readonly OD=/usr/bin/od
readonly PERL=/usr/bin/perl

# Provider probes (E3J9D-R, design §20). Fixed paths only.
readonly BOOT_ID_FILE=/proc/sys/kernel/random/boot_id
readonly UNIT_DIR=/etc/systemd/system
readonly WANTS_DIR=/etc/systemd/system/timers.target.wants
readonly TRANSIENT_DIR=/run/systemd/transient
readonly UNIT_PUBLISH=/usr/local/lib/eanhl-cloud/validation/unit-publish
readonly ROOT_UID=0
readonly ROOT_GID=0

emit() { # emit <name> <value>; a value outside the vocabulary prints as `invalid`
  local value=$2
  [[ $value =~ ^[a-z0-9_.:-]+$ ]] || value=invalid
  printf 'E3J9 %s=%s\n' "$1" "$value"
}
refuse() { # refuse <reason> [exit-code]
  emit launcher_refused "$1"
  exit "${2:-64}"
}
fail_post() { # fail_post <reason>: a failed operation or postcondition
  emit launcher_failed "$1"
  exit 70
}

[ "$(/usr/bin/id -u)" = 0 ] || refuse not_root
/usr/bin/getent passwd "$SVC" >/dev/null || refuse identity_missing
[ -x "$WRAPPER" ] || refuse wrapper_missing
[ "$STORE" = "$SVC_HOME/$STORE_REL" ] && [ "$GNUPG_DIR" = "$SVC_HOME/$GNUPG_REL" ] || refuse layout_inconsistent 70

# Run a command as eanhl-cloud (no supplementary groups). Used for every read,
# lock acquisition and deletion inside the eanhl-cloud-owned trees.
#
# Safe working directory (E3J9C §19.5): setpriv keeps the caller's cwd. Run
# from an operator home (e.g. /home/utiz, 0750) the service identity cannot use
# it, and GNU find exits 1 ("Failed to restore initial working directory"), so
# keygen refused gnupghome_unreadable on Hotel-Echo. The subshell enters / —
# fixed, traversable by every identity — before exec'ing setpriv, so no
# privilege-dropped command inherits the caller's cwd. It is function-local
# (the launcher's own cwd is unchanged), adds no shell after the privilege drop
# (exec replaces the subshell with setpriv), and passes argv, redirections and
# the exit status through unchanged. Failing to enter / exits 70 without
# running setpriv: every caller treats that as a failure (fail closed).
as_svc() ( cd / || exit 70; exec "$SETPRIV" --reuid="$SVC" --regid="$SVC" --clear-groups -- "$@" )

# The §8 property set shared by every unit this launcher builds. There is
# deliberately no StateDirectory=/CacheDirectory=: M3 creates the directories,
# and a missing one fails unit setup (ReadWritePaths=, WorkingDirectory=)
# instead of being created or recursively re-owned by systemd.
readonly BASE_PROPS=(
  --uid="$SVC"
  --gid="$SVC"
  --property=WorkingDirectory=/var/lib/eanhl-cloud
  --property=UMask=0077
  --property=PrivateTmp=yes
  --property=ProtectHome=yes
  --property=ProtectSystem=strict
  "--property=ReadWritePaths=/var/lib/eanhl-cloud /var/cache/eanhl-cloud"
  --property=NoNewPrivileges=yes
  --property=KillMode=control-group
  --property=Type=oneshot
)
# Local-only units: no network namespace access at all (design §8).
readonly LOCAL_PROPS=(
  "${BASE_PROPS[@]}"
  --property=PrivateNetwork=yes
  --property=TimeoutStartSec=300
)
# Units that start the Proton CLI (auth-login, auth-logout) only.
readonly NETWORK_PROPS=(
  --property=After=network-online.target
  --property=Wants=network-online.target
)
# Invocation-bound local units (the `probe` operation and env-proof).
readonly LOCAL_BOUND_PROPS=(
  "${LOCAL_PROPS[@]}"
  --property=RemainAfterExit=yes
  --property=StandardInput=null
  --property=StandardOutput=journal
  --property=StandardError=journal
)
# The property set of every provider probe unit (design §4.4), in unit-file
# form. It is rendered as --property=<K>=<V> for systemd-run and as unit-file
# lines for the boot pair, so the two cannot drift. Network access (no
# PrivateNetwork=, network-online ordering) exists for provider units only.
readonly PROVIDER_UNIT_PROPS=(
  "User=$SVC"
  "Group=$SVC"
  WorkingDirectory=/var/lib/eanhl-cloud
  UMask=0077
  PrivateTmp=yes
  ProtectHome=yes
  ProtectSystem=strict
  "ReadWritePaths=/var/lib/eanhl-cloud /var/cache/eanhl-cloud"
  NoNewPrivileges=yes
  KillMode=control-group
  Type=oneshot
  PrivateNetwork=no
  After=network-online.target
  Wants=network-online.target
  TimeoutStartSec=300
  RemainAfterExit=yes
  Restart=no
  StandardInput=null
  StandardOutput=journal
  StandardError=journal
)
PROVIDER_RUN_PROPS=()
for _kv in "${PROVIDER_UNIT_PROPS[@]}"; do PROVIDER_RUN_PROPS+=("--property=$_kv"); done
unset _kv
readonly PROVIDER_RUN_PROPS

rand_hex() { "$OD" -An -N"$1" -tx1 /dev/urandom | /usr/bin/tr -d ' \n'; }
new_unit() { printf 'eanhl-cloud-cred-%s-%s' "$1" "$(rand_hex 4)"; }
# fresh_nonce <bytes>: exactly 2*<bytes> lowercase hex from /dev/urandom, or fails.
fresh_nonce() {
  local h
  h=$(rand_hex "$1") || return 1
  [[ $h =~ ^[0-9a-f]+$ ]] && [ "${#h}" -eq $(($1 * 2)) ] || return 1
  printf '%s' "$h"
}

# read_boot_id: the current boot id in ONE representation (design §4.10): the
# whole file must be one canonical lowercase UUID plus exactly one LF; it is
# normalised to 32 lowercase hex, journald's _BOOT_ID form. `read -d ''`
# returns 1 at end of file without a NUL (the only accepted case) and 0 when a
# NUL is present; an unreadable file leaves the content empty.
readonly BOOT_ID_RE=$'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\n$'
read_boot_id() {
  local content='' rc id
  IFS= read -r -d '' content 2>/dev/null <"$BOOT_ID_FILE"
  rc=$?
  [ "$rc" -eq 1 ] || return 1
  [[ $content =~ $BOOT_ID_RE ]] || return 1
  id=${content%$'\n'}
  id=${id//-/}
  [[ $id =~ ^[0-9a-f]{32}$ ]] || return 1
  printf '%s' "$id"
}

# Output discarded; returns the unit's exit status.
run_quiet() { # run_quiet <label> <lockmode> <command-id> [args...]
  local label=$1
  shift
  "$SYSTEMD_RUN" --quiet --wait --collect --unit="$(new_unit "$label")" \
    --description="eanhl-cloud credential $label" "${LOCAL_PROPS[@]}" \
    --property=StandardInput=null --property=StandardOutput=null --property=StandardError=null \
    "$WRAPPER" "$@"
}

# Stdout returned to this script (parsed, never printed raw); stderr discarded.
run_capture() { # run_capture <label> <lockmode> <command-id> [args...]
  local label=$1
  shift
  "$SYSTEMD_RUN" --quiet --wait --collect --pipe --unit="$(new_unit "$label")" \
    --description="eanhl-cloud credential $label" "${LOCAL_PROPS[@]}" \
    "$WRAPPER" "$@" </dev/null 2>/dev/null
}

# Global journal search for a marker. Prints a count, or `invalid` when the
# journal cannot be read (fail closed: `invalid` never equals 0).
journal_hits_since() { # journal_hits_since <epoch> <marker>
  local out rc
  "$JOURNALCTL" --sync >/dev/null 2>&1
  out=$("$JOURNALCTL" --no-pager --quiet --since "@$1" -o json --all 2>/dev/null)
  rc=$?
  if [ "$rc" -ne 0 ]; then
    printf invalid
    return
  fi
  printf '%s\n' "$out" | /usr/bin/grep -c -F -- "$2"
}

# ── unit cleanup (part of every result) ─────────────────────────────────────
# cleanup_unit <unit>: stop + reset. Succeeds only if the unit ends inactive (or
# is no longer loaded). A unit that is already not loaded needs nothing. A show,
# stop or reset failure is a cleanup failure.
cleanup_unit() { cleanup_named "$1.service"; }
cleanup_named() { # cleanup_named <full unit name, e.g. x.service or x.timer>
  local u=$1 load state
  load=$("$SYSTEMCTL" show -p LoadState --value -- "$u" 2>/dev/null) || return 1
  [ "$load" = not-found ] && return 0
  "$SYSTEMCTL" stop -- "$u" >/dev/null 2>&1 || return 1
  load=$("$SYSTEMCTL" show -p LoadState --value -- "$u" 2>/dev/null) || return 1
  [ "$load" = not-found ] && return 0
  if ! "$SYSTEMCTL" reset-failed -- "$u" >/dev/null 2>&1; then
    load=$("$SYSTEMCTL" show -p LoadState --value -- "$u" 2>/dev/null) || return 1
    [ "$load" = not-found ] && return 0
    return 1
  fi
  load=$("$SYSTEMCTL" show -p LoadState --value -- "$u" 2>/dev/null) || return 1
  [ "$load" = not-found ] && return 0
  state=$("$SYSTEMCTL" show -p ActiveState --value -- "$u" 2>/dev/null) || return 1
  [ "$state" = inactive ]
}

# ── invocation-bound unit runner (design §11, §20) ──────────────────────────
# A unit with a fresh, never-reused name is started once; its InvocationID is
# bound; the runner waits for that invocation to finish, attests the unit's
# fixed properties, proves from the journal that nothing but this invocation in
# the expected boot ever logged under the name, and reads ONLY that
# invocation's records. Results land in the B_* globals. The caller decides
# whether a successful unit is kept; every other path cleans up via
# bound_cleanup, whose result is printed and is part of the outcome.
#
# Never-reused proof (E3J9D-R): before the start, LoadState must be not-found
# AND the journal must hold no record for the name. Single-invocation proof:
# every journal record of the name (all boots; only the invocation-id field is
# requested, never MESSAGE) must carry the bound InvocationID and the expected
# _BOOT_ID. Both, and the property attestation, run for local units too, so
# the host exercises every new journal and systemctl format before any
# provider contact (Q6).
B_UNIT='' B_ID='' B_STATUS='' B_RECORDS=() B_NONVOCAB=0 B_OK=0
B_KIND=local B_FILTER=local B_MODE='' B_OWNED=0 B_DISALLOWED=0 B_JN=0
B_ACTIVE='' B_SUB='' B_RESULT='' B_NRESTARTS='' B_BOOT=''
B_EXPECT_ARGV='' B_EXPECT_ENV='' B_EXPECT_DESC='' B_EXPECT_FRAG=''

bound_reset() {
  B_UNIT='' B_ID='' B_STATUS='' B_RECORDS=() B_NONVOCAB=0 B_OK=0
  B_OWNED=0 B_DISALLOWED=0 B_JN=0 B_ACTIVE='' B_SUB='' B_RESULT='' B_NRESTARTS=''
}

# The closed provenance failure line for this run's kind.
emit_provenance() {
  if [ "$B_KIND" = provider ]; then emit pp_provenance "$1"; else emit probe_provenance "$1"; fi
}

unit_prop() { "$SYSTEMCTL" show -p "$2" --value -- "$1" 2>/dev/null; }

# The fixed property expectations every bound or provider unit carries (§4.7).
readonly ATTEST_COMMON=(
  "User=$SVC"
  "Group=$SVC"
  WorkingDirectory=/var/lib/eanhl-cloud
  UMask=0077
  PrivateTmp=yes
  ProtectHome=yes
  ProtectSystem=strict
  NoNewPrivileges=yes
  KillMode=control-group
  Type=oneshot
  RemainAfterExit=yes
  StandardInput=null
  StandardOutput=journal
  StandardError=journal
)

# attest_service <unit.service> <local|provider> <argv> <environment|@e4> <description> <fragment>
# 0 only if every fixed property, the single ExecStart argv, the exact
# environment (or, for a persisted e4-decoy unit, the exact E4 decoy set with a
# generated marker), the description and the fragment path match. Values are
# compared in memory and never printed.
attest_service() {
  local unit=$1 kind=$2 argv=$3 env=$4 desc=$5 frag=$6 kv v raw rest
  for kv in "${ATTEST_COMMON[@]}"; do
    v=$(unit_prop "$unit" "${kv%%=*}") || return 1
    [ "$v" = "${kv#*=}" ] || return 1
  done
  case "$kind" in
    local)
      [ "$(unit_prop "$unit" PrivateNetwork)" = yes ] || return 1
      ;;
    provider)
      [ "$(unit_prop "$unit" PrivateNetwork)" = no ] || return 1
      [ "$(unit_prop "$unit" Restart)" = no ] || return 1
      v=$(unit_prop "$unit" After) || return 1
      [[ " $v " == *' network-online.target '* ]] || return 1
      ;;
    *) return 1 ;;
  esac
  [ "$(unit_prop "$unit" Description)" = "$desc" ] || return 1
  [ "$(unit_prop "$unit" FragmentPath)" = "$frag" ] || return 1
  raw=$(unit_prop "$unit" ExecStart) || return 1
  [[ $raw != *$'\n'* ]] || return 1
  [[ $raw == "{ path=${argv%% *} ; argv[]="* ]] || return 1
  rest=${raw#*' argv[]='}
  [[ $rest != *'argv[]='* ]] || return 1
  [ "${rest%% ; ignore_errors=*}" = "$argv" ] || return 1
  v=$(unit_prop "$unit" Environment) || return 1
  if [ "$env" = @e4 ]; then
    e4_env_matches "$v" || return 1
  else
    [ "$v" = "$env" ] || return 1
  fi
  return 0
}

attest_bound() {
  attest_service "$B_UNIT.service" "$B_KIND" "$B_EXPECT_ARGV" "$B_EXPECT_ENV" "$B_EXPECT_DESC" "$B_EXPECT_FRAG"
}

# journal_unit_ids <unit.service> <expected-invocation> <expected-boot>: the
# json view of every record of the unit (all boots), with only the
# invocation-id field requested (journald adds its cursor, timestamps and
# _BOOT_ID); MESSAGE is never requested. Sets J_N (records), J_FOREIGN
# (records without exactly one well-formed id equal to the expected one) and
# J_BOOT_BAD (records whose _BOOT_ID is not the expected one). Fails on a
# journal failure.
J_N=0 J_FOREIGN=0 J_BOOT_BAD=0
journal_unit_ids() {
  local out line
  J_N=0 J_FOREIGN=0 J_BOOT_BAD=0
  "$JOURNALCTL" --sync >/dev/null 2>&1
  out=$("$JOURNALCTL" --no-pager --quiet -o json --output-fields=_SYSTEMD_INVOCATION_ID \
    "_SYSTEMD_UNIT=$1" 2>/dev/null) || return 1
  [ -n "$out" ] || return 0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    J_N=$((J_N + 1))
    if [[ $line =~ \"_SYSTEMD_INVOCATION_ID\":\"([0-9a-f]{32})\" ]] && [ "${BASH_REMATCH[1]}" = "$2" ] &&
      ! [[ $line =~ \"_SYSTEMD_INVOCATION_ID\".*\"_SYSTEMD_INVOCATION_ID\" ]]; then
      :
    else
      J_FOREIGN=$((J_FOREIGN + 1))
    fi
    if [[ $line =~ \"_BOOT_ID\":\"([0-9a-f]{32})\" ]] && [ "${BASH_REMATCH[1]}" = "$3" ] &&
      ! [[ $line =~ \"_BOOT_ID\".*\"_BOOT_ID\" ]]; then
      :
    else
      J_BOOT_BAD=$((J_BOOT_BAD + 1))
    fi
  done <<<"$out"
  return 0
}

# unit_history_count <unit.service>: journal records ever logged under the name.
unit_history_count() {
  journal_unit_ids "$1" '' '' || return 1
  printf '%s' "$J_N"
}

bound_cleanup() {
  [ -n "$B_UNIT" ] || return 0
  if cleanup_unit "$B_UNIT"; then
    emit bound_cleanup_ok true
    return 0
  fi
  emit bound_cleanup_ok false
  return 1
}

# After a failed start the name may belong to a unit this run did not create (a
# race with a foreign unit cannot be told apart from our own), so cleanup
# requires the fixed-property attestation, never in-process provenance.
bound_cleanup_unowned() {
  local load
  load=$("$SYSTEMCTL" show -p LoadState --value -- "$B_UNIT.service" 2>/dev/null) || load=error
  if [ "$load" = not-found ]; then
    emit bound_cleanup_ok true
    return 0
  fi
  if [ "$load" = loaded ] && attest_bound; then
    bound_cleanup
    return
  fi
  emit_provenance unproven
  emit bound_cleanup_ok false
  return 1
}

# setenv_values <--setenv=K=V...>: the systemd Environment= rendering (space-separated K=V).
setenv_values() {
  local a out=''
  for a in "$@"; do out+="${out:+ }${a#--setenv=}"; done
  printf '%s' "$out"
}

bound_start() { # bound_start <label> <decoy-array-name> <wrapper-args...>
  local label=$1 decoys_name=$2 nonce boot
  local -n decoys_ref=$2
  shift 2
  bound_reset
  B_KIND=local B_FILTER=local B_MODE=''
  if ! nonce=$(fresh_nonce 8); then
    emit launcher_failed rand_failed
    return 1
  fi
  if ! boot=$(read_boot_id); then
    emit bound_boot_id_ok false
    return 1
  fi
  B_BOOT=$boot
  B_EXPECT_ARGV="$WRAPPER $*"
  B_EXPECT_ENV=$(setenv_values "${decoys_ref[@]}")
  B_EXPECT_DESC=$BOUND_DESC
  bound_launch "eanhl-cloud-cred-$label-$nonce" LOCAL_BOUND_PROPS "$decoys_name" "$BOUND_DESC" 100 "$@"
}

# bound_launch <candidate> <props-array-name> <extra-array-name> <description> <bind-tries> <wrapper-args...>
bound_launch() {
  local candidate=$1 desc=$4 tries=$5 i id load hist
  local -n props_ref=$2 extra_ref=$3
  shift 5
  emit bound_unit "$candidate"
  load=$("$SYSTEMCTL" show -p LoadState --value -- "$candidate.service" 2>/dev/null)
  if [ "$load" != not-found ]; then
    # Not ours: never stop or reset a unit this run did not start.
    emit bound_unit_collision true
    return 1
  fi
  if ! hist=$(unit_history_count "$candidate.service"); then
    emit bound_unit_history_count invalid
    emit bound_unit_collision true
    return 1
  fi
  emit bound_unit_history_count "$hist"
  if [ "$hist" != 0 ]; then
    emit bound_unit_collision true
    return 1
  fi
  B_UNIT=$candidate
  B_EXPECT_FRAG="$TRANSIENT_DIR/$candidate.service"
  if ! "$SYSTEMD_RUN" --quiet --no-block --unit="$B_UNIT" --description="$desc" \
    "${props_ref[@]}" "${extra_ref[@]}" "$WRAPPER" "$@" >/dev/null 2>&1; then
    emit bound_start_ok false
    bound_cleanup_unowned
    return 1
  fi
  B_OWNED=1
  emit bound_start_ok true
  for i in $(/usr/bin/seq 1 "$tries"); do
    id=$("$SYSTEMCTL" show -p InvocationID --value -- "$B_UNIT.service" 2>/dev/null)
    if [[ $id =~ ^[0-9a-f]{32}$ ]]; then
      B_ID=$id
      emit bound_invocation true
      return 0
    fi
    /usr/bin/sleep 0.1
  done
  emit bound_invocation false
  bound_cleanup
  return 1
}

# Waits, attests, proves the single invocation, and reads. On a timeout, a
# changed invocation, a failed attestation or proof, or a journal failure it
# returns 1 with B_OK=0; the CALLER then cleans up (and reports that result).
bound_wait_read() { # bound_wait_read <seconds-bound>
  local limit=$1 end state sub id out rc line
  end=$((SECONDS + limit))
  while :; do
    state=$("$SYSTEMCTL" show -p ActiveState --value -- "$B_UNIT.service" 2>/dev/null)
    sub=$("$SYSTEMCTL" show -p SubState --value -- "$B_UNIT.service" 2>/dev/null)
    if [ "$state" = failed ] || [ "$state" = inactive ] || { [ "$state" = active ] && [ "$sub" = exited ]; }; then
      break
    fi
    if [ "$SECONDS" -ge "$end" ]; then
      emit bound_wait_timeout true
      return 1
    fi
    /usr/bin/sleep 0.2
  done
  id=$("$SYSTEMCTL" show -p InvocationID --value -- "$B_UNIT.service" 2>/dev/null)
  if [ "$id" != "$B_ID" ]; then
    emit bound_invocation_changed true
    return 1
  fi
  B_ACTIVE=$state B_SUB=$sub
  B_STATUS=$("$SYSTEMCTL" show -p ExecMainStatus --value -- "$B_UNIT.service" 2>/dev/null)
  [[ $B_STATUS =~ ^[0-9]+$ ]] || B_STATUS=unknown
  emit bound_exit_status "$B_STATUS"
  B_RESULT=$(unit_prop "$B_UNIT.service" Result)
  B_NRESTARTS=$(unit_prop "$B_UNIT.service" NRestarts)
  [[ $B_NRESTARTS =~ ^[0-9]+$ ]] || B_NRESTARTS=unknown
  emit bound_nrestarts "$B_NRESTARTS"
  if ! attest_bound; then
    emit bound_attest_ok false
    return 1
  fi
  emit bound_attest_ok true
  if ! journal_unit_ids "$B_UNIT.service" "$B_ID" "$B_BOOT"; then
    emit bound_single_invocation false
    return 1
  fi
  B_JN=$J_N
  if [ "$J_FOREIGN" -ne 0 ]; then
    emit bound_single_invocation false
    return 1
  fi
  emit bound_single_invocation true
  if [ "$J_BOOT_BAD" -ne 0 ]; then
    emit bound_boot_id_match false
    return 1
  fi
  emit bound_boot_id_match true
  "$JOURNALCTL" --sync >/dev/null 2>&1
  out=$("$JOURNALCTL" --no-pager --quiet -o cat \
    "_SYSTEMD_UNIT=$B_UNIT.service" "_SYSTEMD_INVOCATION_ID=$B_ID" 2>/dev/null)
  rc=$?
  if [ "$rc" -ne 0 ]; then
    emit bound_journal_ok false
    return 1
  fi
  emit bound_journal_ok true
  if [ -n "$out" ]; then
    while IFS= read -r line; do
      if ! [[ $line =~ $VOCAB ]]; then
        B_NONVOCAB=$((B_NONVOCAB + 1))
      elif [ "$B_FILTER" = provider ] && ! record_allowed "$line"; then
        B_DISALLOWED=$((B_DISALLOWED + 1))
      else
        B_RECORDS+=("$line")
      fi
    done <<<"$out"
  fi
  for line in "${B_RECORDS[@]}"; do printf '%s\n' "$line"; done
  emit bound_nonvocab_lines "$B_NONVOCAB"
  [ "$B_FILTER" != provider ] || emit bound_disallowed_lines "$B_DISALLOWED"
  B_OK=1
  return 0
}

# Classify a bound probe run: pass | busy | fail (design §11).
classify_probe() { # classify_probe <mode>
  local mode=$1 line modes=0 passes=0 fails=0
  if [ "$B_OK" -ne 1 ]; then printf fail; return; fi
  if [ "$B_STATUS" = 75 ] && [ "${#B_RECORDS[@]}" -eq 0 ] && [ "$B_NONVOCAB" -eq 0 ]; then
    printf busy
    return
  fi
  if [ "$B_NONVOCAB" -ne 0 ] || [ "${#B_RECORDS[@]}" -eq 0 ] || [ "$B_STATUS" != 0 ]; then
    printf fail
    return
  fi
  [ "${B_RECORDS[0]}" = "E3J9 probe_mode=$mode" ] || { printf fail; return; }
  for line in "${B_RECORDS[@]}"; do
    case "$line" in
      'E3J9 probe_mode='*) modes=$((modes + 1)) ;;
      'E3J9 probe_result=pass') passes=$((passes + 1)) ;;
      'E3J9 probe_result='*) fails=$((fails + 1)) ;;
    esac
  done
  if [ "$modes" -eq 1 ] && [ "$passes" -eq 1 ] && [ "$fails" -eq 0 ]; then printf pass; else printf fail; fi
}

# Classify a bound non-probe run (env-inspect boundary): pass | fail.
classify_plain() {
  if [ "$B_OK" -eq 1 ] && [ "$B_STATUS" = 0 ] && [ "$B_NONVOCAB" -eq 0 ] && [ "${#B_RECORDS[@]}" -gt 0 ]; then
    printf pass
  else
    printf fail
  fi
}

# ── key metadata ─────────────────────────────────────────────────────────────

list_secret_keys() {
  run_capture keylist --nonblock gpg --batch --with-colons --fixed-list-mode --list-secret-keys
}

secret_key_count() { # secret_key_count <listing>
  local n
  n=$(printf '%s\n' "$1" | /usr/bin/grep -c '^sec:')
  printf '%s' "${n:-0}"
}

lower_or_none() { local v=${1,,}; printf '%s' "${v:-none}"; }
own_caps() { printf '%s' "${1//[!a-z]/}"; }
total_caps() { local u=${1//[!A-Z]/}; printf '%s' "${u,,}"; }
secret_flag() {
  case "$1" in
    +) printf present ;;
    '#') printf stub ;;
    '') printf none ;;
    *) printf token ;;
  esac
}

# Public metadata only: fingerprints, algorithm ids, capability letters,
# creation/expiry fields, counts. Keygrips and user-ID text are not printed.
emit_key_metadata() { # emit_key_metadata <listing>
  local listing=$1 line last="" sec=0 ssb=0 uids=0 uid_match=false
  local f=()
  while IFS= read -r line; do
    IFS=: read -r -a f <<<"$line"
    case "${f[0]-}" in
      sec | ssb)
        if [ "${f[0]}" = sec ]; then
          sec=$((sec + 1))
          last=primary
        else
          ssb=$((ssb + 1))
          last=subkey
        fi
        emit "key_${last}_algo" "${f[3]-}"
        emit "key_${last}_curve" "$(lower_or_none "${f[16]-}")"
        emit "key_${last}_usage" "$(own_caps "${f[11]-}")"
        [ "$last" = primary ] && emit key_total_caps "$(total_caps "${f[11]-}")"
        emit "key_${last}_created" "${f[5]-}"
        emit "key_${last}_expires" "${f[6]:-never}"
        emit "key_${last}_secret" "$(secret_flag "${f[14]-}")"
        ;;
      fpr)
        [ -n "$last" ] && emit "key_${last}_fpr" "$(lower_or_none "${f[9]-}")"
        last=""
        ;;
      uid)
        uids=$((uids + 1))
        [ "${f[9]-}" = "$KEY_UID" ] && uid_match=true
        ;;
    esac
  done <<<"$listing"
  emit key_secret_count "$sec"
  emit key_subkey_count "$ssb"
  emit key_uid_count "$uids"
  emit key_uid_match "$uid_match"
}

# The keygen postcondition (design §5): exactly one primary secret key with its
# certify capability and a 40-hex fingerprint, exactly one encryption-capable
# secret subkey and no other subkey, exactly one user ID equal to KEY_UID, both
# secret parts present, and no expiry. Algorithms are recorded, not asserted
# (future-default is [VALIDATE]). Returns 0 only if all hold.
check_key_topology() { # check_key_topology <listing>
  local listing=$1 line last="" sec=0 ssb=0 enc=0 uids=0 uid_ok=0 fpr_ok=0 certify=0 secret_ok=1 expiry_ok=1
  local f=()
  while IFS= read -r line; do
    IFS=: read -r -a f <<<"$line"
    case "${f[0]-}" in
      sec)
        sec=$((sec + 1))
        last=primary
        [[ $(own_caps "${f[11]-}") == *c* ]] && certify=1
        [ "${f[14]-}" = + ] || secret_ok=0
        [ -z "${f[6]-}" ] || expiry_ok=0
        ;;
      ssb)
        ssb=$((ssb + 1))
        last=subkey
        [[ $(own_caps "${f[11]-}") == *e* ]] && enc=$((enc + 1))
        [ "${f[14]-}" = + ] || secret_ok=0
        [ -z "${f[6]-}" ] || expiry_ok=0
        ;;
      fpr)
        if [ "$last" = primary ] && [[ ${f[9]-} =~ ^[0-9A-F]{40}$ ]]; then fpr_ok=1; fi
        last=""
        ;;
      uid)
        uids=$((uids + 1))
        [ "${f[9]-}" = "$KEY_UID" ] && uid_ok=1
        ;;
    esac
  done <<<"$listing"
  if [ "$sec" -eq 1 ] && [ "$fpr_ok" -eq 1 ] && [ "$certify" -eq 1 ] && [ "$ssb" -eq 1 ] \
    && [ "$enc" -eq 1 ] && [ "$uids" -eq 1 ] && [ "$uid_ok" -eq 1 ] && [ "$secret_ok" -eq 1 ] \
    && [ "$expiry_ok" -eq 1 ]; then
    emit key_topology_ok true
    return 0
  fi
  emit key_topology_ok false
  return 1
}

primary_fpr_upper() { # primary_fpr_upper <listing>: the fingerprint after the first sec record
  printf '%s\n' "$1" | /usr/bin/awk -F: '$1 == "sec" { want = 1; next } want && $1 == "fpr" { print toupper($10); exit }'
}

# ── metadata helpers (all reads as eanhl-cloud) ──────────────────────────────

svc_meta() { # svc_meta <path>: `%F %a %U %G` without following symlinks, or empty
  as_svc /usr/bin/stat -c '%F %a %U %G' -- "$1" 2>/dev/null
}

# svc_exists <relative path under SVC_HOME>: prints present | absent | error.
#
# Presence proof, run as eanhl-cloud (setpriv). Starting at the trusted root
# SVC_HOME (a real directory, `cd -P`, `pwd -P` must equal it), each component is
# looked up by LISTING the current directory with the fixed expression
# `find . -mindepth 1 -maxdepth 1 -print` and comparing whole lines with
# `./<component>`; the caller's text never enters the find expression.
#   - listed as the final component            → present (a symlink, dangling
#                                                 or not, counts as present);
#   - not listed, and that listing succeeded   → absent;
#   - any listing that fails (unreadable directory, I/O), an intermediate
#     component that is a symlink or not a directory, a failed `cd` into it
#     (e.g. mode 000), or a malformed path     → error.
# "absent" is therefore only ever reported after the containing directory was
# reached from the root and listed successfully. No native error text is read.
# The path is validated here and again in the script: components of
# [A-Za-z0-9._-], no empty, `.`, `..` or leading-`-` component, no leading or
# trailing `/`. NOT race-free: each component is listed, checked (`-L`, `-d`)
# and entered in separate steps, so a concurrent change by eanhl-cloud itself
# (outside the protection boundary) can race them. What holds: an intermediate
# symlink seen at check time is refused; after every `cd -P` the physical cwd
# must still be inside SVC_HOME, so a swap that escapes the tree is detected
# as `error`. A swap that redirects WITHIN SVC_HOME, or a change right after the
# final listing, can give an answer that is stale for that instant.
readonly SVC_EXISTS_SCRIPT='
set -u
root=$1 rel=$2
case "$root" in /*) ;; *) exit 12 ;; esac
case "$rel" in "" | /* | */ | *//*) exit 12 ;; esac
[ -d "$root" ] && [ ! -L "$root" ] || exit 12
cd -P -- "$root" 2>/dev/null || exit 12
[ "$(pwd -P)" = "$root" ] || exit 12
IFS=/ read -r -a parts <<<"$rel"
n=${#parts[@]}
[ "$n" -ge 1 ] || exit 12
i=0
for part in "${parts[@]}"; do
  i=$((i + 1))
  case "$part" in "" | . | .. | -*) exit 12 ;; esac
  [[ $part =~ ^[A-Za-z0-9._-]+$ ]] || exit 12
  listing=$(/usr/bin/find . -mindepth 1 -maxdepth 1 -print 2>/dev/null) || exit 12
  found=0
  while IFS= read -r entry; do
    [ "$entry" = "./$part" ] && found=1
  done <<<"$listing"
  [ "$found" -eq 1 ] || exit 11
  [ "$i" -eq "$n" ] && exit 10
  [ -L "$part" ] && exit 12
  [ -d "$part" ] || exit 12
  cd -P -- "$part" 2>/dev/null || exit 12
  case "$(pwd -P)/" in "$root"/*) ;; *) exit 12 ;; esac
done
exit 12
'
svc_exists() {
  local rel=$1 part
  case "$rel" in "" | /* | */ | *//*)
    printf error
    return
    ;;
  esac
  local parts=()
  IFS=/ read -r -a parts <<<"$rel"
  for part in "${parts[@]}"; do
    case "$part" in "" | . | .. | -*)
      printf error
      return
      ;;
    esac
    [[ $part =~ ^[A-Za-z0-9._-]+$ ]] || {
      printf error
      return
    }
  done
  as_svc /usr/bin/bash -p -c "$SVC_EXISTS_SCRIPT" _ "$SVC_HOME" "$rel" >/dev/null 2>&1
  case $? in
    10) printf present ;;
    11) printf absent ;;
    *) printf error ;;
  esac
}

# Count entries below <dir> (find as eanhl-cloud). Prints the count, or fails
# (non-zero) when find fails, so an unreadable tree never counts as empty.
svc_count() { # svc_count <dir> [find-predicates...]
  local dir=$1 out rc lines=()
  shift
  out=$(as_svc /usr/bin/find "$dir" -mindepth 1 "$@" -print 2>/dev/null)
  rc=$?
  [ "$rc" -eq 0 ] || return 1
  if [ -z "$out" ]; then
    printf 0
  else
    mapfile -t lines <<<"$out"
    printf '%s' "${#lines[@]}"
  fi
}

# Read the single-line .gpg-id as eanhl-cloud after proving it a regular file.
read_gpg_id() {
  local meta
  meta=$(svc_meta "$STORE/.gpg-id")
  case "$meta" in
    "regular file 600 $SVC $SVC") ;;
    *) return 1 ;;
  esac
  as_svc /usr/bin/cat -- "$STORE/.gpg-id" 2>/dev/null
}

store_dir_ok() { [ "$(svc_meta "$STORE")" = "directory 700 $SVC $SVC" ]; }

no_active_credential_unit() {
  local out
  out=$("$SYSTEMCTL" list-units --all --plain --no-legend \
    --state=activating,active,deactivating,reloading 'eanhl-cloud-*' 2>/dev/null) || return 1
  [ -z "$out" ]
}

# ── subcommands ──────────────────────────────────────────────────────────────

cmd_keygen() {
  local listing count rc n
  # GNUPGHOME must be the M3 directory, still empty, checked before any gpg run
  # creates files in it.
  [ "$(svc_meta "$GNUPG_DIR")" = "directory 700 $SVC $SVC" ] || refuse gnupghome_wrong 65
  n=$(svc_count "$GNUPG_DIR") || refuse gnupghome_unreadable 70
  emit gnupghome_entry_count_before "$n"
  [ "$n" = 0 ] || refuse gnupghome_not_empty 65
  listing=$(list_secret_keys) || refuse keylist_failed 70
  count=$(secret_key_count "$listing")
  if [ "$count" != 0 ]; then
    emit keygen_existing_secret_keys "$count"
    refuse keyring_not_empty 65
  fi
  # The empty passphrase is not a secret: the key is deliberately unprotected
  # (§5). A dropped empty argv element makes gpg fail (fail closed); L1 under
  # `pinentry-mode error` then proves the key needs no passphrase.
  run_quiet keygen --nonblock gpg --batch --pinentry-mode loopback --passphrase '' \
    --quick-generate-key "$KEY_UID" future-default default never
  rc=$?
  emit keygen_unit_rc "$rc"
  [ "$rc" -eq 0 ] || fail_post keygen_unit
  listing=$(list_secret_keys) || fail_post keylist_after_keygen
  emit_key_metadata "$listing"
  check_key_topology "$listing" || fail_post key_topology
  emit keygen_postconditions_ok true
}

cmd_pass_init() {
  local fpr=${1^^} listing count entries rc gpg_id
  [[ $fpr =~ ^[0-9A-F]{40}$ ]] || refuse bad_fingerprint
  # A9: the store is the M3 directory, correctly owned, and empty now. That it
  # is the one M3 created is established by the session record, not metadata.
  store_dir_ok || refuse store_dir_wrong 65
  entries=$(svc_count "$STORE") || refuse store_unreadable 70
  emit store_entry_count_before "$entries"
  [ "$entries" = 0 ] || refuse store_not_empty 65
  listing=$(list_secret_keys) || refuse keylist_failed 70
  count=$(secret_key_count "$listing")
  emit key_secret_count "$count"
  [ "$count" = 1 ] || refuse key_count_not_one 65
  [ "$(primary_fpr_upper "$listing")" = "$fpr" ] || refuse fingerprint_mismatch 65
  emit pass_init_key_match true
  run_quiet pass-init --nonblock pass init "$fpr"
  rc=$?
  emit pass_init_unit_rc "$rc"
  [ "$rc" -eq 0 ] || fail_post pass_init_unit
  # Postconditions: .gpg-id is a 0600 regular file owned by the identity,
  # holding exactly the one fingerprint, and it is the store's only entry.
  if ! gpg_id=$(read_gpg_id); then
    emit gpg_id_meta_ok false
    fail_post gpg_id_unreadable
  fi
  emit gpg_id_meta_ok true
  if [ "$gpg_id" != "$fpr" ]; then
    emit gpg_id_single_line_match false
    fail_post gpg_id_mismatch
  fi
  emit gpg_id_single_line_match true
  entries=$(svc_count "$STORE" ! -path "$STORE/.gpg-id") || fail_post store_unreadable_after
  emit store_other_entry_count_after "$entries"
  [ "$entries" = 0 ] || fail_post store_not_gpg_id_only
  emit pass_init_postconditions_ok true
}

require_validation_tool() {
  [ -x "$VALIDATION_DIR/$1" ] || refuse validation_tool_missing
}

# Local probe modes the launcher may start: <mode>:<accepted outcomes>:<keep>.
# Provider modes are deliberately absent (they run only through
# `provider-probe`, E3J9D-R). A keep-mode unit is left running ONLY after it
# reached `pass`; any other outcome is cleaned up.
readonly PROBE_MODES=(
  precheck:pass:0
  local:pass:0
  canary:pass:1
  canary-a:pass,busy:0
  canary-b:pass,busy:0
  neg-uninit:pass:0
  lockhold-hold:pass:0
  lockhold-long:pass:1
  lockhold-detach:pass:1
  busy-a:busy:0
  busy-b:busy:0
  busy-c:busy:0
  busy-d:busy:0
)

cmd_probe() {
  local mode=$1 spec accept="" keep=0 outcome none=()
  for spec in "${PROBE_MODES[@]}"; do
    if [ "${spec%%:*}" = "$mode" ]; then
      accept=${spec#*:}
      keep=${accept#*:}
      accept=${accept%:*}
    fi
  done
  [ -n "$accept" ] || refuse usage
  require_validation_tool eanhl-cloud-credential-probe.sh
  emit probe_requested_mode "$mode"
  if ! bound_start "probe-$mode" none --nonblock probe "local:$mode"; then
    emit probe_run_result fail
    exit 70
  fi
  bound_wait_read 330
  outcome=$(classify_probe "$mode")
  if [ "$keep" -eq 1 ] && [ "$outcome" = pass ]; then
    emit probe_unit_kept true
  else
    bound_cleanup || outcome=fail
  fi
  emit probe_run_result "$outcome"
  case ",$accept," in
    *",$outcome,"*) exit 0 ;;
    *) exit 1 ;;
  esac
}

# attest_local_keep <unit> <keep-mode>: the unit is a kept local probe unit this
# launcher builds (fixed properties, `probe local:<keep-mode>` argv, no
# environment, transient fragment).
attest_local_keep() {
  attest_service "$1.service" local "$WRAPPER --nonblock probe local:$2" '' "$BOUND_DESC" "$TRANSIENT_DIR/$1.service"
}

# Stop a kept probe unit. It must exist (a typo never "succeeds"), it must be
# proven to be a kept local probe unit this launcher built (E3J9D-R: never
# stop an object only because its name matches), and both the stop and the
# reset/cleanup must succeed.
cmd_probe_stop() {
  local unit=$1 load m proven=0
  [[ $unit =~ ^eanhl-cloud-cred-probe-[a-z0-9-]+$ ]] || refuse usage
  load=$("$SYSTEMCTL" show -p LoadState --value -- "$unit.service" 2>/dev/null) || load=error
  if [ "$load" != loaded ]; then
    emit probe_unit_found false
    emit probe_stopped false
    exit 1
  fi
  for m in canary lockhold-long lockhold-detach; do
    if [[ $unit =~ ^eanhl-cloud-cred-probe-$m-[0-9a-f]{16}$ ]] && attest_local_keep "$unit" "$m"; then
      proven=1
    fi
  done
  if [ "$proven" -ne 1 ]; then
    emit probe_provenance unproven
    emit probe_stopped false
    exit 1
  fi
  if cleanup_unit "$unit"; then
    emit probe_stopped true
  else
    emit probe_stopped false
    exit 1
  fi
}

cmd_pty_marker() {
  local nonce t0 rc hits
  require_validation_tool pty-marker
  [ -t 0 ] && [ -t 1 ] || refuse no_terminal
  nonce=$(rand_hex 16)
  t0=$(/usr/bin/date +%s)
  "$SYSTEMD_RUN" --quiet --pty --wait --collect --unit="$(new_unit pty)" \
    --description="eanhl-cloud credential pty-marker" "${LOCAL_PROPS[@]}" \
    --setenv=E3J9_PTY_NONCE="$nonce" "$WRAPPER" --nonblock pty-marker
  rc=$?
  /usr/bin/sleep 2
  emit pty_marker_unit_rc "$rc"
  hits=$(journal_hits_since "$t0" "$nonce")
  emit pty_marker_journal_hits "$hits"
  if [ "$rc" -eq 0 ] && [ "$hits" = 0 ]; then
    emit pty_marker_result pass
    return 0
  fi
  emit pty_marker_result fail
  exit 1
}

cmd_env_proof() {
  local nonce t0 result hits all=pass
  require_validation_tool env-inspect
  require_validation_tool eanhl-cloud-credential-probe.sh
  require_validation_tool lockhold
  nonce="e3j9nonce$(rand_hex 16)"
  # E3: effect-bearing decoys on the unit. They reach the wrapper's environment
  # only; env -i must keep every one of them away from the credential command.
  local decoys=(
    --setenv=E3J9_INJECTED="$nonce"
    --setenv=GNUPGHOME=/nonexistent-e3j9
    --setenv=PASSWORD_STORE_DIR=/nonexistent-e3j9
    --setenv=PASSWORD_STORE_GPG_OPTS=--e3j9-invalid
    --setenv=PATH=/nonexistent-e3j9
    --setenv=GPG_TTY=/dev/e3j9-decoy
    --setenv=PROTON_DRIVE_BASE_URL=http://127.0.0.1:9
  )
  t0=$(/usr/bin/date +%s)

  # E1(b) + E2 wrapper side: env-inspect exec'd directly as the credential command.
  emit envproof_step boundary
  if bound_start envproof-boundary decoys --nonblock env-inspect boundary; then
    bound_wait_read 330
    result=$(classify_plain)
    bound_cleanup || result=fail
  else
    result=fail
  fi
  emit envproof_step_result "$result"
  [ "$result" = pass ] || all=fail

  # E3(b)(c) + E2 downstream: the probe (local mode, L1 canary) under the decoys.
  emit envproof_step canary
  if bound_start envproof-canary decoys --nonblock probe local:local; then
    bound_wait_read 330
    result=$(classify_probe local)
    bound_cleanup || result=fail
  else
    result=fail
  fi
  emit envproof_step_result "$result"
  [ "$result" = pass ] || all=fail

  # Supplementary only: root reads /proc/<pid>/environ of live pass/GPG processes
  # while a lockhold canary runs under the same decoys. Its own output never
  # decides the outcome; the step's probe result does.
  emit envproof_step observe
  if bound_start envproof-observe decoys --nonblock probe local:lockhold-hold; then
    "$VALIDATION_DIR/env-inspect" observe "$B_UNIT.service" 60
    bound_wait_read 330
    result=$(classify_probe lockhold-hold)
    bound_cleanup || result=fail
  else
    result=fail
  fi
  emit envproof_step_result "$result"
  [ "$result" = pass ] || all=fail

  /usr/bin/sleep 1
  hits=$(journal_hits_since "$t0" "$nonce")
  emit envproof_nonce_journal_hits "$hits"
  [ "$hits" = 0 ] || all=fail
  emit envproof_result "$all"
  [ "$all" = pass ] || exit 1
}

# One resident-agent rule check. Returns 0 only if <pid>'s evidence satisfies
# <rule> = `<exe>|<ppid>|<cgroup regex>`: the exe was matched by the caller;
# here the PPid must equal the rule and /proc/<pid>/cgroup must be exactly one
# cgroup v2 line `0::<path>` whose path matches the rule's regex.
agent_rule_holds() { # agent_rule_holds <pid> <rule>
  local pid=$1 rule=$2 r_exe r_ppid r_cg ppid_line ppid cg_lines=()
  IFS='|' read -r r_exe r_ppid r_cg <<<"$rule"
  [[ $r_ppid =~ ^[0-9]+$ ]] && [ -n "$r_cg" ] || return 1
  ppid_line=$(/usr/bin/grep -m 1 '^PPid:' "$PROC_ROOT/$pid/status" 2>/dev/null) || return 1
  read -r _ ppid _ <<<"$ppid_line"
  [ "$ppid" = "$r_ppid" ] || {
    emit preflight_agent_parent_mismatch true
    return 1
  }
  mapfile -t cg_lines <"$PROC_ROOT/$pid/cgroup" 2>/dev/null || return 1
  if [ "${#cg_lines[@]}" -ne 1 ] || [[ ${cg_lines[0]} != 0::* ]] || ! [[ ${cg_lines[0]#0::} =~ $r_cg ]]; then
    emit preflight_agent_cgroup_mismatch true
    return 1
  fi
  return 0
}

# §6 fail-closed preflight for the ceremony. Metadata only: per process it
# reads /proc/<pid>/exe (readlink), the Uid:/PPid: lines of status, and cgroup —
# never cmdline or environ, and never a credential.
preflight_auth_login() {
  local listing count fpr gpg_id n a pids pid exe uid_line u1 u2 u3 u4 svc_uid seen_exes=() rule matched dup
  # 1. static checks
  if [ -f "$CLI" ] && [ "$(/usr/bin/sha512sum -- "$CLI" 2>/dev/null | /usr/bin/cut -d ' ' -f 1)" = "$CLI_PIN" ]; then
    emit preflight_cli_pin_match true
  else
    emit preflight_cli_pin_match false
    return 1
  fi
  listing=$(list_secret_keys) || { emit preflight_keylist_ok false; return 1; }
  count=$(secret_key_count "$listing")
  emit preflight_key_secret_count "$count"
  [ "$count" = 1 ] || return 1
  fpr=$(primary_fpr_upper "$listing")
  store_dir_ok || { emit preflight_store_dir_ok false; return 1; }
  n=$(svc_count "$STORE" ! -path "$STORE/.gpg-id") || { emit preflight_store_readable false; return 1; }
  emit preflight_store_other_entries "$n"
  [ "$n" = 0 ] || return 1
  gpg_id=$(read_gpg_id) || { emit preflight_gpg_id_ok false; return 1; }
  if [ "$gpg_id" = "$fpr" ]; then emit preflight_gpg_id_match true; else
    emit preflight_gpg_id_match false
    return 1
  fi
  n=$(svc_count "$SVC_HOME" -name auth-session.json) || { emit preflight_fallback_scan_ok false; return 1; }
  a=$(svc_count "$SVC_CACHE" -name auth-session.json) || { emit preflight_fallback_scan_ok false; return 1; }
  emit preflight_fallback_file_count "$((n + a))"
  [ "$((n + a))" -eq 0 ] || return 1
  # 2. no credential unit is active
  if no_active_credential_unit; then emit preflight_no_active_unit true; else
    emit preflight_no_active_unit false
    return 1
  fi
  # 3. every eanhl-cloud process satisfies a resident-agent rule, at most once
  svc_uid=$(/usr/bin/id -u "$SVC") || return 1
  pids=$("$PGREP" -u "$SVC" 2>/dev/null)
  case $? in
    0 | 1) ;;
    *)
      emit preflight_process_scan_ok false
      return 1
      ;;
  esac
  for pid in $pids; do
    [[ $pid =~ ^[0-9]+$ ]] || { emit preflight_process_scan_ok false; return 1; }
    if ! exe=$(/usr/bin/readlink -- "$PROC_ROOT/$pid/exe" 2>/dev/null); then
      if [ ! -d "$PROC_ROOT/$pid" ]; then emit preflight_scan_race true; else emit preflight_unexpected_process true; fi
      return 1
    fi
    uid_line=$(/usr/bin/grep -m 1 '^Uid:' "$PROC_ROOT/$pid/status" 2>/dev/null) || { emit preflight_scan_race true; return 1; }
    read -r _ u1 u2 u3 u4 <<<"$uid_line"
    if [ "$u1" != "$svc_uid" ] || [ "$u2" != "$svc_uid" ] || [ "$u3" != "$svc_uid" ] || [ "$u4" != "$svc_uid" ]; then
      emit preflight_unexpected_process true
      return 1
    fi
    case "$exe" in *' (deleted)')
      emit preflight_unexpected_process true
      return 1
      ;;
    esac
    if [ "$exe" = "$CLI" ]; then
      emit preflight_cli_running true
      return 1
    fi
    matched=''
    for rule in "${RESIDENT_AGENT_RULES[@]}"; do
      [ "${rule%%|*}" = "$exe" ] && matched=$rule
    done
    if [ -z "$matched" ]; then
      emit preflight_unexpected_process true
      return 1
    fi
    agent_rule_holds "$pid" "$matched" || {
      emit preflight_unexpected_process true
      return 1
    }
    for dup in "${seen_exes[@]}"; do
      if [ "$dup" = "$exe" ]; then
        emit preflight_unexpected_process true
        return 1
      fi
    done
    seen_exes+=("$exe")
  done
  emit preflight_resident_agent_count "${#seen_exes[@]}"
  emit preflight_unexpected_process false
  # 4. the lock can be acquired (as eanhl-cloud; the path is never opened as root)
  if [ -L "$LOCK_FILE" ] || [ ! -f "$LOCK_FILE" ]; then
    emit preflight_lock_file_ok false
    return 1
  fi
  if as_svc "$FLOCK" --nonblock --exclusive --conflict-exit-code 75 "$LOCK_FILE" /usr/bin/true; then
    emit preflight_lock_free true
  else
    emit preflight_lock_free false
    return 1
  fi
  return 0
}

# E3J9D only, operator-performed (§6). The agent never runs this.
cmd_auth_login() {
  local rc
  [ -t 0 ] && [ -t 1 ] || refuse no_terminal
  preflight_auth_login || refuse preflight_failed 65
  "$SYSTEMD_RUN" --quiet --pty --wait --collect --unit="$(new_unit auth-login)" \
    --description="eanhl-cloud credential auth-login" "${BASE_PROPS[@]}" "${NETWORK_PROPS[@]}" \
    --property=TimeoutStartSec=900 \
    "$WRAPPER" --nonblock proton-drive auth login
  rc=$?
  emit auth_login_unit_rc "$rc"
  [ "$rc" -eq 0 ] || exit 1
}

# Local logout only: pass rm -f + cleared caches. Not remote revocation (§12).
# Succeeds only if the unit succeeded AND the entry is proven absent afterwards.
cmd_auth_logout() {
  local rc state
  "$SYSTEMD_RUN" --quiet --wait --collect --unit="$(new_unit auth-logout)" \
    --description="eanhl-cloud credential auth-logout" "${BASE_PROPS[@]}" "${NETWORK_PROPS[@]}" \
    --property=TimeoutStartSec=300 \
    --property=StandardInput=null --property=StandardOutput=null --property=StandardError=null \
    "$WRAPPER" --nonblock proton-drive auth logout
  rc=$?
  emit auth_logout_unit_rc "$rc"
  [ "$rc" -eq 0 ] || fail_post auth_logout_unit
  state=$(svc_exists "$STORE_REL/$AUTH_ENTRY.gpg")
  emit auth_entry_after_logout "$state"
  [ "$state" = absent ] || fail_post auth_entry_not_proven_absent
}

# Rollback/recovery: remove one fixed pass entry with `pass rm -f`.
remove_fixed_entry() { # remove_fixed_entry <label> <entry>
  local label=$1 entry=$2 rc meta state
  no_active_credential_unit || refuse credential_unit_active 65
  store_dir_ok || refuse store_dir_wrong 65
  meta=$(svc_meta "$STORE/$entry.gpg")
  case "$meta" in
    "regular file 600 $SVC $SVC") ;;
    *) refuse entry_not_regular_file 65 ;;
  esac
  run_quiet "$label" --nonblock pass rm -f "$entry"
  rc=$?
  emit "${label//-/_}_unit_rc" "$rc"
  state=$(svc_exists "$STORE_REL/$entry.gpg")
  emit entry_after "$state"
  [ "$rc" -eq 0 ] || fail_post "${label//-/_}_unit"
  [ "$state" = absent ] || fail_post entry_not_proven_absent
}

# Rollback/rotation: delete the one secret key, only once no entry needs it.
cmd_key_delete() {
  local fpr=${1^^} listing count n gpg_id rc state rev
  [[ $fpr =~ ^[0-9A-F]{40}$ ]] || refuse bad_fingerprint
  no_active_credential_unit || refuse credential_unit_active 65
  listing=$(list_secret_keys) || refuse keylist_failed 70
  count=$(secret_key_count "$listing")
  emit key_secret_count "$count"
  [ "$count" = 1 ] || refuse key_count_not_one 65
  [ "$(primary_fpr_upper "$listing")" = "$fpr" ] || refuse fingerprint_mismatch 65
  state=$(svc_exists "$STORE_REL")
  case "$state" in
    absent) ;;
    present)
      n=$(svc_count "$STORE" -name '*.gpg') || refuse store_unreadable 70
      emit store_gpg_entry_count "$n"
      [ "$n" = 0 ] || refuse store_has_entries 65
      state=$(svc_exists "$STORE_REL/.gpg-id")
      case "$state" in
        absent) ;;
        present)
          gpg_id=$(read_gpg_id) || refuse gpg_id_wrong 65
          [ "$gpg_id" = "$fpr" ] || refuse gpg_id_mismatch 65
          ;;
        *) refuse gpg_id_state_unknown 70 ;;
      esac
      ;;
    *) refuse store_state_unknown 70 ;;
  esac
  run_quiet key-delete --nonblock gpg --batch --yes --delete-secret-and-public-key "$fpr"
  rc=$?
  emit key_delete_unit_rc "$rc"
  [ "$rc" -eq 0 ] || fail_post key_delete_unit
  rev="$GNUPG_DIR/openpgp-revocs.d/$fpr.rev"
  as_svc /usr/bin/rm -f -- "$rev" || fail_post revocation_file_remove
  state=$(svc_exists "$GNUPG_REL/openpgp-revocs.d/$fpr.rev")
  emit revocation_file_after "$state"
  [ "$state" = absent ] || fail_post revocation_file_not_proven_absent
  listing=$(list_secret_keys) || fail_post keylist_after_delete
  count=$(secret_key_count "$listing")
  emit key_secret_count_after "$count"
  [ "$count" = 0 ] || fail_post secret_key_remains
  emit key_delete_postconditions_ok true
}

# ══ provider probes (E3J9D-R; design §20) ═══════════════════════════════════
# `provider-probe` is the ONLY path that runs a provider probe mode (the probe
# unit file template no longer exists). Every provider unit gets a fresh name
# with a 128-bit nonce, built from the fixed tables below and never from caller
# text; it runs as eanhl-cloud through the wrapper (its twelve literals,
# PROTON_DRIVE_LOG_LEVEL=ERROR), is started exactly once, never retried and
# never kept, and is read through the shared invocation-bound runner with a
# stricter projection: a record is printed only if its NAME is one the running
# mode's probe arm emits and its VALUE is of that name's class. An independent
# cross-field classifier decides the outcome; cleanup is part of it.
#
# Provenance before every mutation: an object this invocation created (after
# the never-reused proof and one successful start or publication) may be
# cleaned by this invocation; any other object is stopped, reset, disabled or
# removed only after the fixed property attestation, and a persistent boot
# file only after byte equality with the canonical renderer. An unproven
# object is never touched (pp_provenance=ambiguous|missing|foreign|mismatch|unproven).
#
#   provider-probe run <mode>        immediate: P0, P1, P2, N1-N3, E4/N4
#   provider-probe schedule <slot>   t20m | t6h15m (transient timer) | boot (persistent pair, M13)
#   provider-probe collect <slot>    read a fired scheduled probe, then remove it
#   provider-probe discard <slot>    now | t20m | t6h15m | boot: provenance-checked removal only
#
# Unit environment: provider units get none, except the single validation-only
# e4-decoy mode, whose four decoys are fixed here (the marker is generated
# here); no caller-supplied name, value, path, URL or marker exists.
#
# Each verb is a template capability, not an authorization (design §10, §13).

readonly PP_PREFIX=eanhl-cloud-cred-pprobe
readonly PP_DESC_BASE='eanhl-cloud credential provider validation'
readonly BOUND_DESC='eanhl-cloud credential validation'
readonly PP_WAIT=330
readonly PP_BIND_TRIES=300
readonly PP_COLLECT_BIND_TRIES=1500
readonly E4_PDCACHE=/tmp/e3j9-e4-pdcache
readonly E4_XDGCACHE=/tmp/e3j9-e4-xdgcache
readonly E4_BASE_URL=http://127.0.0.1:9

# <mode>|<probe argument>|<accepted outcome>|<verbs>|<expected provider_result>
readonly PROVIDER_MODES=(
  'provider|provider:provider|pass|run,schedule|ok'
  'provider-freshcache|provider:provider-freshcache|pass|run|ok'
  'neg-nokey|provider:neg-nokey|pass|run|pass_load_failed'
  'neg-nostore|provider:neg-nostore|pass|run|login_required'
  'n3-busy|provider:provider|busy|run|ok'
  'e4-decoy|provider:e4-decoy|pass|run|ok'
)
# <slot>|<trigger value>|<attested monotonic key>|<attested value>
readonly PP_SLOTS=(
  'now|||'
  't20m|20min|OnActiveUSec|20min'
  't6h15m|6h15min|OnActiveUSec|6h 15min'
  'boot|10min|OnBootUSec|10min'
)

# Record value classes and the closed provider record names.
declare -rA PP_CLASS_RE=(
  [bool]='^(true|false)$'
  [count]='^(0|[1-9][0-9]{0,5}|invalid)$'
  [rc]='^(0|[1-9][0-9]{0,2}|invalid)$'
  [size]='^(0|[1-9][0-9]{0,9}|invalid)$'
  [mtime]='^([1-9][0-9]{0,11}|invalid)$'
  [mode]='^([0-7]{3,4}|invalid)$'
  [probe_mode]='^(provider|provider-freshcache|neg-nokey|neg-nostore|e4-decoy)$'
  [probe_result]='^(pass|fail)$'
  [provider_result]='^(ok|login_required|pass_load_failed|timeout|credential_lock_busy|other)$'
)
readonly PROVIDER_RECORD_NAMES=(
  probe_mode:probe_mode probe_tmp_ok:bool probe_failures:count probe_result:probe_result
  env_initial_exact:bool env_unexpected_count:count env_forbidden_absent:bool
  env_nonce_absent:bool env_systemd_absent:bool
  helper_env_descendant_within_permitted:bool helper_env_pwd_is_workdir:bool
  helper_env_unexpected_count:count helper_env_wrong_value_count:count
  helper_env_forbidden_absent:bool helper_env_nonce_absent:bool helper_env_systemd_absent:bool
  identity_is_svc:bool groups_only_primary:bool stdin_is_tty:bool run_user_absent:bool
  human_sessions:count gpg_agent_count_at_start:count
  entry_present:bool entry_mode:mode entry_size:size entry_mtime:mtime
  fallback_file_count:count log_count:count log_nonprivate_count:count
  cli_present:bool cli_pin_match:bool provider_rc:rc provider_result:provider_result
  freshcache_entry_count:count pinentry_count:count pass_cmd_not_found:bool
  decoy_parent_is_flock:bool decoy_parent_env_readable:bool decoy_parent_decoy_count:count
  decoy_parent_values_exact:bool decoy_marker_dirs_created:bool
  decoy_pdcache_entry_count:count decoy_xdgcache_entry_count:count
)
declare -A PP_CLASS_OF=()
for _e in "${PROVIDER_RECORD_NAMES[@]}"; do PP_CLASS_OF[${_e%%:*}]=${_e#*:}; done
unset _e
readonly PP_CLASS_OF

# Rule groups, `<name> <rule>`: once=<v> exactly one record, equal to <v>;
# once exactly one record; req=<v> at least one, every one equal to <v>;
# opt=<v> every one (if any) equal to <v>; any no constraint. @mode and @label
# are the probe mode and its expected provider_result.
readonly PP_RULES_COMMON=(
  'probe_mode once=@mode' 'probe_tmp_ok any' 'probe_failures once=0' 'probe_result once=pass'
  'provider_result once=@label' 'provider_rc once'
  'env_initial_exact req=true' 'env_unexpected_count req=0' 'env_forbidden_absent req=true'
  'env_nonce_absent req=true' 'env_systemd_absent req=true'
  'helper_env_descendant_within_permitted req=true' 'helper_env_pwd_is_workdir req=true'
  'helper_env_unexpected_count req=0' 'helper_env_wrong_value_count req=0'
  'helper_env_forbidden_absent req=true' 'helper_env_nonce_absent req=true'
  'helper_env_systemd_absent req=true'
  'pinentry_count req=0' 'pass_cmd_not_found req=false' 'cli_pin_match opt=true'
)
readonly PP_RULES_IDENTITY=(
  'identity_is_svc req=true' 'groups_only_primary req=true' 'stdin_is_tty req=false'
  'run_user_absent req=true' 'human_sessions any' 'gpg_agent_count_at_start req=0'
)
readonly PP_RULES_METADATA=(
  'entry_present req=true' 'entry_mode req=600' 'entry_size any' 'entry_mtime any'
  'fallback_file_count req=0' 'log_count any' 'log_nonprivate_count opt=0'
  'cli_present req=true' 'cli_pin_match req=true'
)
readonly PP_RULES_FRESHCACHE=('freshcache_entry_count any')
readonly PP_RULES_E4=(
  'decoy_parent_is_flock once=true' 'decoy_parent_env_readable once=true'
  'decoy_parent_decoy_count once=4' 'decoy_parent_values_exact once=true'
  'decoy_marker_dirs_created once=true' 'decoy_pdcache_entry_count once=0' 'decoy_xdgcache_entry_count once=0'
)
# Probe mode → rule groups; mirrors the probe's case arms (tied by a static test).
readonly PROVIDER_MODE_NAMES=(
  'provider|COMMON IDENTITY METADATA'
  'provider-freshcache|COMMON IDENTITY FRESHCACHE'
  'neg-nokey|COMMON METADATA'
  'neg-nostore|COMMON METADATA'
  'e4-decoy|COMMON IDENTITY METADATA E4'
)

E4_DECOYS=()
PP_PHASE='' PP_CANCELLED=0 PP_T0=0 PP_BOOT='' PP_LOCKHOLD_UNIT=''
PP_ALLOW_ACTIVE=() PP_STEM='' PP_LMODE='' PP_ARMED=''
PP_SCHED_STEM='' PP_SCHED_SLOT='' PP_COLLECT_STEM='' PP_COLLECT_SLOT='' PP_COLLECT_ARMED=''
declare -A PP_ALLOWED=()
PP_RULES_LOADED=()

pp_mode_field() { # pp_mode_field <mode> <field 1-5>
  local spec f=()
  for spec in "${PROVIDER_MODES[@]}"; do
    IFS='|' read -r -a f <<<"$spec"
    [ "${f[0]}" = "$1" ] || continue
    printf '%s' "${f[$(($2 - 1))]-}"
    return 0
  done
  return 1
}
pp_probe_mode() { # pp_probe_mode <launcher mode>: the probe-side mode name
  local parg
  parg=$(pp_mode_field "$1" 2) || return 1
  printf '%s' "${parg#provider:}"
}
pp_slot_field() { # pp_slot_field <slot> <field 1-4>
  local spec f=()
  for spec in "${PP_SLOTS[@]}"; do
    IFS='|' read -r -a f <<<"$spec"
    [ "${f[0]}" = "$1" ] || continue
    printf '%s' "${f[$(($2 - 1))]-}"
    return 0
  done
  return 1
}

pp_rule_group() {
  case "$1" in
    COMMON) printf '%s\n' "${PP_RULES_COMMON[@]}" ;;
    IDENTITY) printf '%s\n' "${PP_RULES_IDENTITY[@]}" ;;
    METADATA) printf '%s\n' "${PP_RULES_METADATA[@]}" ;;
    FRESHCACHE) printf '%s\n' "${PP_RULES_FRESHCACHE[@]}" ;;
    E4) printf '%s\n' "${PP_RULES_E4[@]}" ;;
    *) return 1 ;;
  esac
}
pp_rules() { # pp_rules <probe mode>: its rule lines
  local spec g
  for spec in "${PROVIDER_MODE_NAMES[@]}"; do
    [ "${spec%%|*}" = "$1" ] || continue
    for g in ${spec#*|}; do pp_rule_group "$g" || return 1; done
    return 0
  done
  return 1
}
pp_load_rules() { # pp_load_rules <probe mode>: PP_RULES_LOADED and the allowed record names
  local line
  PP_ALLOWED=() PP_RULES_LOADED=()
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    PP_RULES_LOADED+=("$line")
    PP_ALLOWED[${line%% *}]=1
  done < <(pp_rules "$1")
  [ "${#PP_RULES_LOADED[@]}" -gt 0 ]
}

# record_allowed <line>: `E3J9 <name>=<value>` with <name> emitted by the
# running mode's probe arm and <value> of its class.
record_allowed() {
  local rest=${1#E3J9 } name value class
  name=${rest%%=*}
  value=${rest#*=}
  [ -n "${PP_ALLOWED[$name]+set}" ] || return 1
  class=${PP_CLASS_OF[$name]-}
  [ -n "$class" ] || return 1
  [[ $value =~ ${PP_CLASS_RE[$class]} ]]
}

# pp_rules_hold <probe mode> <label>: every loaded rule holds on B_RECORDS.
pp_rules_hold() {
  local mode=$1 label=$2 rule name spec want kind n bad rec
  for rule in "${PP_RULES_LOADED[@]}"; do
    name=${rule%% *}
    spec=${rule#* }
    kind=${spec%%=*}
    want=''
    [ "$spec" = "$kind" ] || want=${spec#*=}
    want=${want//@mode/$mode}
    want=${want//@label/$label}
    n=0 bad=0
    for rec in "${B_RECORDS[@]}"; do
      [ "${rec%%=*}" = "E3J9 $name" ] || continue
      n=$((n + 1))
      [ -z "$want" ] || [ "${rec#*=}" = "$want" ] || bad=1
    done
    case "$kind" in
      once) [ "$n" -eq 1 ] && [ "$bad" -eq 0 ] || return 1 ;;
      req) [ "$n" -ge 1 ] && [ "$bad" -eq 0 ] || return 1 ;;
      opt) [ "$bad" -eq 0 ] || return 1 ;;
      any) ;;
      *) return 1 ;;
    esac
  done
  return 0
}
# provider_rc is 0 exactly when provider_result is ok.
pp_rc_consistent() {
  local rec rc='' res=''
  for rec in "${B_RECORDS[@]}"; do
    case "$rec" in
      'E3J9 provider_rc='*) rc=${rec#*=} ;;
      'E3J9 provider_result='*) res=${rec#*=} ;;
    esac
  done
  if [ "$res" = ok ]; then [ "$rc" = 0 ]; else [ -n "$rc" ] && [ "$rc" != 0 ]; fi
}
# Scheduled slots ran with no human session: human_sessions present, every one 0.
pp_slot_rules_hold() {
  local rec n=0
  [ "$1" != now ] || return 0
  for rec in "${B_RECORDS[@]}"; do
    case "$rec" in
      'E3J9 human_sessions='*)
        n=$((n + 1))
        [ "${rec#*=}" = 0 ] || return 1
        ;;
    esac
  done
  [ "$n" -ge 1 ]
}

# Classify a bound provider run: pass | busy | fail (design §4.8). Independent of
# the probe's own probe_result.
classify_provider() { # classify_provider <launcher mode> <slot>
  local lmode=$1 slot=$2 pmode label
  pmode=$(pp_probe_mode "$lmode") || { printf fail; return; }
  label=$(pp_mode_field "$lmode" 5) || { printf fail; return; }
  if [ "$B_OK" -ne 1 ] || [ "$B_NONVOCAB" -ne 0 ] || [ "$B_DISALLOWED" -ne 0 ] || [ "$B_NRESTARTS" != 0 ]; then
    printf fail
    return
  fi
  if [ "$B_STATUS" = 75 ] && [ "$B_ACTIVE" = failed ] && [ "${#B_RECORDS[@]}" -eq 0 ] && [ "$B_JN" -eq 0 ]; then
    printf busy
    return
  fi
  if [ "$B_STATUS" != 0 ] || [ "$B_ACTIVE" != active ] || [ "$B_SUB" != exited ] || [ "$B_RESULT" != success ] ||
    [ "$B_JN" -lt 1 ] || [ "${#B_RECORDS[@]}" -eq 0 ]; then
    printf fail
    return
  fi
  [ "${B_RECORDS[0]}" = "E3J9 probe_mode=$pmode" ] || { printf fail; return; }
  pp_rules_hold "$pmode" "$label" || { printf fail; return; }
  pp_rc_consistent || { printf fail; return; }
  pp_slot_rules_hold "$slot" || { printf fail; return; }
  printf pass
}

# ── provenance ──────────────────────────────────────────────────────────────

e4_env_matches() { # e4_env_matches <Environment>: the exact fixed E4 decoy set, marker generated here
  local fixed="PROTON_DRIVE_CACHE_DIR=$E4_PDCACHE XDG_CACHE_HOME=$E4_XDGCACHE PROTON_DRIVE_BASE_URL=$E4_BASE_URL E3J9_INJECTED=e3j9nonce"
  [[ $1 == "$fixed"* ]] && [[ ${1#"$fixed"} =~ ^[0-9a-f]{32}$ ]]
}

# attest_timer <stem> <slot> <fragment> [unit-file-state]: the fixed timer properties.
attest_timer() {
  local t="$1.timer" key val raw mid
  key=$(pp_slot_field "$2" 3) && val=$(pp_slot_field "$2" 4) || return 1
  [ -n "$key" ] || return 1
  [ "$(unit_prop "$t" Unit)" = "$1.service" ] || return 1
  raw=$(unit_prop "$t" TimersMonotonic) || return 1
  [[ $raw != *$'\n'* ]] || return 1
  [[ $raw == "{ $key=$val ; next_elapse="*' }' ]] || return 1
  mid=${raw#"{ $key=$val ; next_elapse="}
  mid=${mid%' }'}
  [[ $mid != *[{}\;]* ]] || return 1
  [ -z "$(unit_prop "$t" TimersCalendar)" ] || return 1
  [ "$(unit_prop "$t" RemainAfterElapse)" = yes ] || return 1
  [ "$(unit_prop "$t" Persistent)" = no ] || return 1
  [ "$(unit_prop "$t" FragmentPath)" = "$3" ] || return 1
  [ -z "${4-}" ] || [ "$(unit_prop "$t" UnitFileState)" = "$4" ] || return 1
}

pp_desc_boot() { # pp_desc_boot <description> <slot>: the 32-hex armed boot id it carries
  local re="^$PP_DESC_BASE \\($2 armed-boot ([0-9a-f]{32})\\)\$"
  [[ $1 =~ $re ]] || return 1
  printf '%s' "${BASH_REMATCH[1]}"
}

# pp_attest_service <stem> <slot> <armed> <launcher mode>: a provider service of this slot.
pp_attest_service() {
  local stem=$1 slot=$2 armed=$3 lmode=$4 dir=$TRANSIENT_DIR env=''
  [ "$slot" != boot ] || dir=$UNIT_DIR
  [ "$lmode" != e4-decoy ] || env=@e4
  attest_service "$stem.service" provider "$WRAPPER --nonblock probe $(pp_mode_field "$lmode" 2)" "$env" \
    "$PP_DESC_BASE ($slot armed-boot $armed)" "$dir/$stem.service"
}
# pp_attest_pair <stem> <slot> <armed> [unit-file-state]: a scheduled service + timer.
pp_attest_pair() {
  local dir=$TRANSIENT_DIR
  [ "$2" != boot ] || dir=$UNIT_DIR
  pp_attest_service "$1" "$2" "$3" provider || return 1
  attest_timer "$1" "$2" "$dir/$1.timer" "${4-}"
}

pp_unit_gone() { [ "$(unit_prop "$1" LoadState)" = not-found ]; }

# pp_parse_stem <stem> <slot>: prints the launcher mode of `<prefix>-<slot>-<mode>-<32 hex>`
# (scheduled slots carry only mode `provider`).
pp_parse_stem() {
  local stem=$1 slot=$2 rest spec mode
  rest=${stem#"$PP_PREFIX-$slot-"}
  [ "$rest" != "$stem" ] || return 1
  for spec in "${PROVIDER_MODES[@]}"; do
    mode=${spec%%|*}
    [ "$slot" = now ] || [ "$mode" = provider ] || continue
    if [[ $rest == "$mode-"* ]] && [[ ${rest#"$mode-"} =~ ^[0-9a-f]{32}$ ]]; then
      printf '%s' "$mode"
      return 0
    fi
  done
  return 1
}
# pp_stem_of <unit or file name> <slot>: the stem of `<stem>.service` / `<stem>.timer`.
pp_stem_of() {
  local name=$1 stem
  case "$name" in
    *.service) stem=${name%.service} ;;
    *.timer) stem=${name%.timer} ;;
    *) return 1 ;;
  esac
  [ "$2" != now ] || [ "$name" = "$stem.service" ] || return 1
  pp_parse_stem "$stem" "$2" >/dev/null || return 1
  printf '%s' "$stem"
}

# pp_object_names: every loaded pprobe unit and every pprobe file (temporary
# files included) in the unit and wants directories, one `unit <name>` or
# `file <path>` per line. Fails on a query error.
pp_object_names() {
  local out name f
  out=$("$SYSTEMCTL" list-units --all --plain --no-legend --full "$PP_PREFIX-*" 2>/dev/null) || return 1
  if [ -n "$out" ]; then
    while read -r name _; do
      [ -z "$name" ] || printf 'unit %s\n' "$name"
    done <<<"$out"
  fi
  for f in "$UNIT_DIR/$PP_PREFIX"-* "$UNIT_DIR/.$PP_PREFIX"-* "$WANTS_DIR/$PP_PREFIX"-*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    printf 'file %s\n' "$f"
  done
}

pp_wants_link_state() { # pp_wants_link_state <stem>: present | absent | bad
  local link="$WANTS_DIR/$1.timer" meta target
  if [ ! -e "$link" ] && [ ! -L "$link" ]; then
    printf absent
    return
  fi
  meta=$(/usr/bin/stat -c '%u %F' -- "$link" 2>/dev/null) || { printf bad; return; }
  [ "$meta" = "$ROOT_UID symbolic link" ] || { printf bad; return; }
  target=$(/usr/bin/readlink -- "$link" 2>/dev/null) || { printf bad; return; }
  if [ "$target" = "$UNIT_DIR/$1.timer" ]; then printf present; else printf bad; fi
}

# The canonical boot pair (design §4.11.1): fixed lines, the stem and the
# normalised armed boot id only.
pp_render_service() { # pp_render_service <stem> <armed boot id>
  local kv
  printf '%s\n' '[Unit]' "Description=$PP_DESC_BASE (boot armed-boot $2)"
  for kv in "${PROVIDER_UNIT_PROPS[@]}"; do
    case "$kv" in After=* | Wants=*) printf '%s\n' "$kv" ;; esac
  done
  printf '%s\n' '' '[Service]'
  for kv in "${PROVIDER_UNIT_PROPS[@]}"; do
    case "$kv" in After=* | Wants=*) ;; *) printf '%s\n' "$kv" ;; esac
  done
  printf '%s\n' "ExecStart=$WRAPPER --nonblock probe $(pp_mode_field provider 2)"
}
pp_render_timer() { # pp_render_timer <stem> <armed boot id>
  printf '%s\n' '[Unit]' "Description=$PP_DESC_BASE (boot armed-boot $2)" '' '[Timer]' \
    "OnBootSec=$(pp_slot_field boot 2)" RemainAfterElapse=yes Persistent=no "Unit=$1.service" \
    '' '[Install]' WantedBy=timers.target
}

pp_file_armed() { # pp_file_armed <file>: the armed boot id of its single Description= line
  local lines
  lines=$(/usr/bin/grep -E '^Description=' -- "$1" 2>/dev/null) || return 1
  [[ $lines != *$'\n'* ]] || return 1
  pp_desc_boot "${lines#Description=}" boot
}
# pp_boot_files_ok <stem> <armed>: both files regular root 0644 with the canonical bytes.
pp_boot_files_ok() {
  local stem=$1 armed=$2 f have want
  for f in service timer; do
    [ "$(/usr/bin/stat -c '%F %a %u %g' -- "$UNIT_DIR/$stem.$f" 2>/dev/null)" = "regular file 644 $ROOT_UID $ROOT_GID" ] || return 1
    have=$(/usr/bin/cat -- "$UNIT_DIR/$stem.$f" 2>/dev/null && printf x) || return 1
    if [ "$f" = service ]; then want=$(pp_render_service "$stem" "$armed" && printf x); else want=$(pp_render_timer "$stem" "$armed" && printf x); fi
    [ "$have" = "$want" ] || return 1
  done
}

# The reviewed publication helper, fixed argv, clean environment, vocabulary lines only.
unit_publish() { # unit_publish <op> [stem]; fds 3/4 come from the caller
  local out rc line
  out=$(/usr/bin/env -i "$PERL" -T -- "$UNIT_PUBLISH" "$@" 2>/dev/null)
  rc=$?
  if [ -n "$out" ]; then
    while IFS= read -r line; do
      if [[ $line =~ $VOCAB ]]; then printf '%s\n' "$line"; fi
    done <<<"$out"
  fi
  return "$rc"
}

pp_set_equal() { # pp_set_equal <array-name> <expected...>: same elements, no extras
  local -n arr_ref=$1
  shift
  local e x found
  [ "${#arr_ref[@]}" -eq "$#" ] || return 1
  for e in "$@"; do
    found=0
    for x in "${arr_ref[@]}"; do [ "$x" != "$e" ] || found=1; done
    [ "$found" -eq 1 ] || return 1
  done
}
pp_subset() { # pp_subset <array-name> <allowed...>
  local -n arr_ref=$1
  shift
  local e x found
  for x in "${arr_ref[@]}"; do
    found=0
    for e in "$@"; do [ "$x" != "$e" ] || found=1; done
    [ "$found" -eq 1 ] || return 1
  done
}

# pp_discover <slot>: the one object of <slot> (read-only). Sets PP_STEM and PP_LMODE.
pp_discover() {
  local slot=$1 names kind name base stem s dup ok
  local stems=() units=() files=() wants=()
  PP_STEM='' PP_LMODE=''
  if ! names=$(pp_object_names); then
    emit pp_provenance unproven
    return 1
  fi
  if [ -n "$names" ]; then
    while read -r kind name; do
      [ -n "$name" ] || continue
      base=${name##*/}
      case "$base" in "$PP_PREFIX-$slot-"* | ".$PP_PREFIX-$slot-"*) ;; *) continue ;; esac
      if ! stem=$(pp_stem_of "$base" "$slot"); then
        emit pp_provenance foreign
        return 1
      fi
      dup=0
      for s in "${stems[@]}"; do [ "$s" != "$stem" ] || dup=1; done
      [ "$dup" -eq 1 ] || stems+=("$stem")
      if [ "$kind" = unit ]; then
        units+=("$base")
      elif [ "$name" = "$WANTS_DIR/$base" ]; then
        wants+=("$base")
      else
        files+=("$base")
      fi
    done <<<"$names"
  fi
  if [ "${#stems[@]}" -eq 0 ]; then
    emit pp_provenance missing
    return 1
  fi
  if [ "${#stems[@]}" -ne 1 ]; then
    emit pp_provenance ambiguous
    return 1
  fi
  stem=${stems[0]}
  ok=1
  case "$slot" in
    now) pp_set_equal units "$stem.service" && [ "${#files[@]}" -eq 0 ] && [ "${#wants[@]}" -eq 0 ] || ok=0 ;;
    t20m | t6h15m) pp_set_equal units "$stem.service" "$stem.timer" && [ "${#files[@]}" -eq 0 ] && [ "${#wants[@]}" -eq 0 ] || ok=0 ;;
    boot) pp_set_equal files "$stem.service" "$stem.timer" && pp_set_equal wants "$stem.timer" && pp_subset units "$stem.service" "$stem.timer" || ok=0 ;;
    *) ok=0 ;;
  esac
  if [ "$ok" -ne 1 ]; then
    emit pp_provenance missing
    return 1
  fi
  PP_STEM=$stem
  PP_LMODE=$(pp_parse_stem "$stem" "$slot")
}

# pp_attest_found <slot>: fixed-property (boot: also byte and link) provenance
# of PP_STEM. Sets PP_ARMED.
pp_attest_found() {
  local slot=$1 stem=$PP_STEM desc armed a2
  PP_ARMED=''
  if [ "$slot" = boot ]; then
    if ! armed=$(pp_file_armed "$UNIT_DIR/$stem.service") || ! a2=$(pp_file_armed "$UNIT_DIR/$stem.timer") ||
      [ "$armed" != "$a2" ] || ! pp_boot_files_ok "$stem" "$armed" ||
      [ "$(pp_wants_link_state "$stem")" != present ] || ! pp_attest_pair "$stem" boot "$armed" enabled; then
      emit pp_provenance mismatch
      return 1
    fi
  else
    if ! desc=$(unit_prop "$stem.service" Description); then
      emit pp_provenance unproven
      return 1
    fi
    if ! armed=$(pp_desc_boot "$desc" "$slot"); then
      emit pp_provenance mismatch
      return 1
    fi
    if [ "$slot" = now ]; then
      pp_attest_service "$stem" now "$armed" "$PP_LMODE" || { emit pp_provenance mismatch; return 1; }
    else
      pp_attest_pair "$stem" "$slot" "$armed" || { emit pp_provenance mismatch; return 1; }
    fi
  fi
  PP_ARMED=$armed
}

# pp_cleanup_pair <stem> <slot> <armed> <launcher mode>: remove a proven object,
# re-attesting each unit immediately before it is stopped and re-proving the
# boot bytes before they are disabled and removed.
pp_cleanup_pair() {
  local stem=$1 slot=$2 armed=$3 lmode=${4:-provider}
  case "$slot" in
    now)
      pp_unit_gone "$stem.service" && return 0
      pp_attest_service "$stem" now "$armed" "$lmode" || { emit pp_provenance mismatch; return 1; }
      cleanup_named "$stem.service"
      ;;
    t20m | t6h15m)
      if ! pp_unit_gone "$stem.timer"; then
        pp_attest_pair "$stem" "$slot" "$armed" || { emit pp_provenance mismatch; return 1; }
        cleanup_named "$stem.timer" || return 1
      fi
      if ! pp_unit_gone "$stem.service"; then
        pp_attest_service "$stem" "$slot" "$armed" provider || { emit pp_provenance mismatch; return 1; }
        cleanup_named "$stem.service" || return 1
      fi
      ;;
    boot)
      pp_boot_files_ok "$stem" "$armed" || { emit pp_provenance mismatch; return 1; }
      pp_attest_pair "$stem" boot "$armed" || { emit pp_provenance mismatch; return 1; }
      cleanup_named "$stem.timer" || return 1
      pp_attest_service "$stem" boot "$armed" provider || { emit pp_provenance mismatch; return 1; }
      cleanup_named "$stem.service" || return 1
      pp_boot_files_ok "$stem" "$armed" || { emit pp_provenance mismatch; return 1; }
      "$SYSTEMCTL" disable -- "$stem.timer" >/dev/null 2>&1 || return 1
      [ "$(pp_wants_link_state "$stem")" = absent ] || return 1
      unit_publish unpublish-pair "$stem" 3< <(pp_render_service "$stem" "$armed") 4< <(pp_render_timer "$stem" "$armed") || return 1
      "$SYSTEMCTL" daemon-reload >/dev/null 2>&1 || return 1
      pp_unit_gone "$stem.service" && pp_unit_gone "$stem.timer" || return 1
      unit_publish fsync-wants
      ;;
    *) return 1 ;;
  esac
}

# ── pre- and postconditions ─────────────────────────────────────────────────

pp_store_extra_count() {
  svc_count "$STORE" ! -path "$STORE/.gpg-id" ! -path "$STORE/ch.proton.drive" \
    ! -path "$STORE/ch.proton.drive/drive-sdk-cli" ! -path "$STORE/$AUTH_ENTRY.gpg"
}
pp_fallback_count() {
  local n a
  n=$(svc_count "$SVC_HOME" -name auth-session.json) || return 1
  a=$(svc_count "$SVC_CACHE" -name auth-session.json) || return 1
  printf '%s' "$((n + a))"
}
# pp_active_units_ok [allowed unit...]: every activating/active/deactivating/
# reloading eanhl-cloud-* unit is one of the allowed names (a query error fails).
pp_active_units_ok() {
  local out name ok a
  out=$("$SYSTEMCTL" list-units --all --plain --no-legend --full \
    --state=activating,active,deactivating,reloading 'eanhl-cloud-*' 2>/dev/null) || return 1
  [ -n "$out" ] || return 0
  while read -r name _; do
    [ -n "$name" ] || continue
    ok=0
    for a in "$@"; do [ "$name" != "$a" ] || ok=1; done
    [ "$ok" -eq 1 ] || return 1
  done <<<"$out"
}
# pp_svc_process_count [allowed unit]: eanhl-cloud processes outside the allowed
# unit's cgroup (metadata only: /proc/<pid>/cgroup). Fails on a pgrep or /proc error.
pp_svc_process_count() {
  local allowed=${1-} pids pid n=0
  local -a cg=()
  pids=$("$PGREP" -u "$SVC" 2>/dev/null)
  case $? in 0 | 1) ;; *) return 1 ;; esac
  for pid in $pids; do
    [[ $pid =~ ^[0-9]+$ ]] || return 1
    if [ -n "$allowed" ]; then
      mapfile -t cg 2>/dev/null <"$PROC_ROOT/$pid/cgroup" || return 1
      if [ "${#cg[@]}" -eq 1 ] && [[ ${cg[0]} == 0::*"/$allowed.service" ]]; then continue; fi
    fi
    n=$((n + 1))
  done
  printf '%s' "$n"
}
# pp_lock_state: 0 free, 75 held; anything else is an error.
pp_lock_state() {
  [ ! -L "$LOCK_FILE" ] && [ -f "$LOCK_FILE" ] || return 2
  as_svc "$FLOCK" --nonblock --exclusive --conflict-exit-code 75 "$LOCK_FILE" /usr/bin/true
}
# pp_find_lockhold: the one lockhold-long unit (during its hold), attested.
pp_find_lockhold() {
  local out name found='' n=0
  out=$("$SYSTEMCTL" list-units --all --plain --no-legend --full --state=activating,active \
    'eanhl-cloud-cred-probe-lockhold-long-*' 2>/dev/null) || return 1
  while read -r name _; do
    [ -n "$name" ] || continue
    n=$((n + 1))
    found=${name%.service}
  done <<<"$out"
  [ "$n" -eq 1 ] && [[ $found =~ ^eanhl-cloud-cred-probe-lockhold-long-[0-9a-f]{16}$ ]] || return 1
  attest_local_keep "$found" lockhold-long || return 1
  printf '%s' "$found"
}
# pp_check_objects <verb> <slot>: pprobe objects permitted before <verb>
# (none; for a delayed `schedule`, only the other delayed slot's loaded units).
# Sets PP_ALLOW_ACTIVE.
pp_check_objects() {
  local verb=$1 slot=$2 other='' names kind name bad=0
  PP_ALLOW_ACTIVE=()
  if [ "$verb" = schedule ]; then
    case "$slot" in t20m) other=t6h15m ;; t6h15m) other=t20m ;; esac
  fi
  if ! names=$(pp_object_names); then
    emit pp_pre_pprobe_object_count invalid
    return 1
  fi
  if [ -n "$names" ]; then
    while read -r kind name; do
      [ -n "$name" ] || continue
      if [ -n "$other" ] && [ "$kind" = unit ] && pp_stem_of "$name" "$other" >/dev/null; then
        PP_ALLOW_ACTIVE+=("$name")
      else
        bad=$((bad + 1))
      fi
    done <<<"$names"
  fi
  emit pp_pre_pprobe_object_count "$bad"
  [ "$bad" -eq 0 ]
}

# pp_preconditions <run|schedule> <launcher mode> <slot>: the pre-contact checks
# (design §4.5.2). Every read inside the service trees runs as eanhl-cloud.
pp_preconditions() {
  local verb=$1 lmode=$2 slot=$3 listing count fpr gpg_id n rc
  local -a allowed=()
  PP_LOCKHOLD_UNIT=''
  if [ -f "$CLI" ] && [ "$(/usr/bin/sha512sum -- "$CLI" 2>/dev/null | /usr/bin/cut -d ' ' -f 1)" = "$CLI_PIN" ]; then
    emit pp_pre_cli_pin_match true
  else
    emit pp_pre_cli_pin_match false
    return 1
  fi
  listing=$(list_secret_keys) || { emit pp_pre_keylist_ok false; return 1; }
  count=$(secret_key_count "$listing")
  emit pp_pre_key_secret_count "$count"
  [ "$count" = 1 ] || return 1
  fpr=$(primary_fpr_upper "$listing")
  store_dir_ok || { emit pp_pre_store_dir_ok false; return 1; }
  gpg_id=$(read_gpg_id) || { emit pp_pre_gpg_id_match false; return 1; }
  if [ "$gpg_id" = "$fpr" ]; then emit pp_pre_gpg_id_match true; else
    emit pp_pre_gpg_id_match false
    return 1
  fi
  if [ "$(svc_meta "$STORE/$AUTH_ENTRY.gpg")" = "regular file 600 $SVC $SVC" ]; then
    emit pp_pre_entry_meta_ok true
  else
    emit pp_pre_entry_meta_ok false
    return 1
  fi
  n=$(pp_store_extra_count) || n=invalid
  emit pp_pre_store_extra_count "$n"
  [ "$n" = 0 ] || return 1
  n=$(pp_fallback_count) || n=invalid
  emit pp_pre_fallback_file_count "$n"
  [ "$n" = 0 ] || return 1
  if [ "$lmode" = n3-busy ]; then
    if ! PP_LOCKHOLD_UNIT=$(pp_find_lockhold); then
      PP_LOCKHOLD_UNIT=''
      emit pp_pre_lockhold_unit_ok false
      return 1
    fi
    emit pp_pre_lockhold_unit_ok true
    allowed+=("$PP_LOCKHOLD_UNIT.service")
  fi
  pp_check_objects "$verb" "$slot" || return 1
  allowed+=("${PP_ALLOW_ACTIVE[@]}")
  if pp_active_units_ok "${allowed[@]}"; then emit pp_pre_no_active_unit true; else
    emit pp_pre_no_active_unit false
    return 1
  fi
  n=$(pp_svc_process_count "$PP_LOCKHOLD_UNIT") || n=invalid
  emit pp_pre_svc_process_count "$n"
  [ "$n" = 0 ] || return 1
  pp_lock_state
  rc=$?
  if [ "$lmode" = n3-busy ]; then
    if [ "$rc" -eq 75 ]; then emit pp_pre_lock_held true; else
      emit pp_pre_lock_held false
      return 1
    fi
  else
    if [ "$rc" -eq 0 ]; then emit pp_pre_lock_free true; else
      emit pp_pre_lock_free false
      return 1
    fi
  fi
  if [ "$verb" = run ]; then
    if [ "$(unit_prop network-online.target ActiveState)" = active ]; then emit pp_pre_network_online true; else
      emit pp_pre_network_online false
      return 1
    fi
  fi
  if PP_BOOT=$(read_boot_id); then emit pp_boot_id_ok true; else
    PP_BOOT=''
    emit pp_boot_id_ok false
    return 1
  fi
  return 0
}

# pp_postconditions <launcher mode> <e4 marker|''>: after cleanup (design §4.5.11).
pp_postconditions() {
  local lmode=$1 bad=0 n hits
  local -a allowed=()
  [ -z "$PP_LOCKHOLD_UNIT" ] || allowed+=("$PP_LOCKHOLD_UNIT.service")
  allowed+=("${PP_ALLOW_ACTIVE[@]}")
  if [ "$(svc_meta "$STORE/$AUTH_ENTRY.gpg")" = "regular file 600 $SVC $SVC" ]; then
    emit pp_post_entry_meta_ok true
  else
    emit pp_post_entry_meta_ok false
    bad=1
  fi
  n=$(pp_fallback_count) || n=invalid
  emit pp_post_fallback_file_count "$n"
  [ "$n" = 0 ] || bad=1
  n=$(pp_store_extra_count) || n=invalid
  emit pp_post_store_extra_count "$n"
  [ "$n" = 0 ] || bad=1
  if pp_active_units_ok "${allowed[@]}"; then emit pp_post_no_active_unit true; else
    emit pp_post_no_active_unit false
    bad=1
  fi
  n=$(pp_svc_process_count "$PP_LOCKHOLD_UNIT") || n=invalid
  emit pp_post_svc_process_count "$n"
  [ "$n" = 0 ] || bad=1
  if [ "$lmode" = e4-decoy ]; then
    hits=$(journal_hits_since "$PP_T0" "$2")
    emit pp_decoy_nonce_journal_hits "$hits"
    [ "$hits" = 0 ] || bad=1
  fi
  return "$bad"
}

# pp_name_fresh <stem> <slot>: the never-reused proof for a new scheduled name.
pp_name_fresh() {
  local stem=$1 slot=$2 u hist
  for u in "$stem.service" "$stem.timer"; do
    [ "$("$SYSTEMCTL" show -p LoadState --value -- "$u" 2>/dev/null)" = not-found ] || return 1
  done
  if [ "$slot" = boot ]; then
    for u in "$UNIT_DIR/$stem.service" "$UNIT_DIR/$stem.timer" "$WANTS_DIR/$stem.timer"; do
      [ ! -e "$u" ] && [ ! -L "$u" ] || return 1
    done
  fi
  if ! hist=$(unit_history_count "$stem.service"); then
    emit bound_unit_history_count invalid
    return 1
  fi
  emit bound_unit_history_count "$hist"
  [ "$hist" = 0 ]
}

# ── cancellation ────────────────────────────────────────────────────────────

pp_other_delayed_units() { # the other delayed slot's loaded units (grammar-checked)
  local other names kind name
  case "$1" in t20m) other=t6h15m ;; t6h15m) other=t20m ;; *) return 0 ;; esac
  names=$(pp_object_names) || return 1
  [ -n "$names" ] || return 0
  while read -r kind name; do
    if [ "$kind" = unit ] && pp_stem_of "$name" "$other" >/dev/null; then printf '%s\n' "$name"; fi
  done <<<"$names"
}

# In-process rollback of a pair this invocation scheduled.
pp_schedule_rollback() {
  local ok=true
  if [ "$PP_SCHED_SLOT" = boot ]; then
    if pp_boot_files_ok "$PP_SCHED_STEM" "$PP_BOOT"; then
      "$SYSTEMCTL" disable -- "$PP_SCHED_STEM.timer" >/dev/null 2>&1
      [ "$(pp_wants_link_state "$PP_SCHED_STEM")" = absent ] || ok=false
      unit_publish unpublish-pair "$PP_SCHED_STEM" 3< <(pp_render_service "$PP_SCHED_STEM" "$PP_BOOT") \
        4< <(pp_render_timer "$PP_SCHED_STEM" "$PP_BOOT") || ok=false
      "$SYSTEMCTL" daemon-reload >/dev/null 2>&1 || ok=false
    else
      ok=false
    fi
  else
    cleanup_named "$PP_SCHED_STEM.timer" || ok=false
    cleanup_named "$PP_SCHED_STEM.service" || ok=false
  fi
  PP_SCHED_STEM=''
  emit pp_rollback_complete "$ok"
  [ "$ok" = true ]
}

pp_on_signal() {
  [ "$PP_CANCELLED" -eq 0 ] || return 0
  PP_CANCELLED=1
  trap '' INT TERM HUP
  emit pp_cancelled true
  case "$PP_PHASE" in
    run)
      if [ -n "$B_UNIT" ]; then
        if [ "$B_OWNED" -eq 1 ]; then bound_cleanup; else bound_cleanup_unowned; fi
      fi
      emit provider_run_result fail
      ;;
    schedule)
      [ -z "$PP_SCHED_STEM" ] || pp_schedule_rollback
      emit pp_scheduled false
      ;;
    collect)
      if [ -n "$PP_COLLECT_STEM" ]; then
        pp_cleanup_pair "$PP_COLLECT_STEM" "$PP_COLLECT_SLOT" "$PP_COLLECT_ARMED" provider || emit pp_rollback_complete false
      fi
      emit provider_run_result fail
      ;;
  esac
  exit 1
}

# ── verbs ───────────────────────────────────────────────────────────────────

cmd_pp_run() { # cmd_pp_run <launcher mode>
  local lmode=$1 parg pmode accept nonce e4_nonce='' outcome e4_ok=1 desc
  local decoys=()
  parg=$(pp_mode_field "$lmode" 2)
  pmode=$(pp_probe_mode "$lmode")
  accept=$(pp_mode_field "$lmode" 3)
  PP_PHASE=run
  trap pp_on_signal INT TERM HUP
  emit pp_mode "$lmode"
  emit pp_slot now
  require_validation_tool eanhl-cloud-credential-probe.sh
  PP_T0=$(/usr/bin/date +%s)
  pp_preconditions run "$lmode" now || refuse preconditions_failed 65
  if ! nonce=$(fresh_nonce 16); then
    emit launcher_failed rand_failed
    exit 70
  fi
  if [ "$lmode" = e4-decoy ]; then
    if ! e4_nonce=$(fresh_nonce 16); then
      emit launcher_failed rand_failed
      exit 70
    fi
    E4_DECOYS=(
      "--setenv=PROTON_DRIVE_CACHE_DIR=$E4_PDCACHE"
      "--setenv=XDG_CACHE_HOME=$E4_XDGCACHE"
      "--setenv=PROTON_DRIVE_BASE_URL=$E4_BASE_URL"
      "--setenv=E3J9_INJECTED=e3j9nonce$e4_nonce"
    )
    decoys=("${E4_DECOYS[@]}")
  fi
  bound_reset
  B_KIND=provider B_FILTER=provider B_MODE=$pmode B_BOOT=$PP_BOOT
  pp_load_rules "$pmode" || refuse usage
  desc="$PP_DESC_BASE (now armed-boot $PP_BOOT)"
  B_EXPECT_ARGV="$WRAPPER --nonblock probe $parg"
  B_EXPECT_ENV=''
  [ "$lmode" != e4-decoy ] || B_EXPECT_ENV=@e4
  B_EXPECT_DESC=$desc
  if ! bound_launch "$PP_PREFIX-now-$lmode-$nonce" PROVIDER_RUN_PROPS decoys "$desc" "$PP_BIND_TRIES" \
    --nonblock probe "$parg"; then
    emit provider_run_result fail
    exit 70
  fi
  if [ "$lmode" = e4-decoy ]; then
    # E4: the parent unit really carries exactly this run's decoys (not vacuous).
    if [ "$(unit_prop "$B_UNIT.service" Environment)" = "$(setenv_values "${E4_DECOYS[@]}")" ]; then
      emit pp_decoy_env_attested true
    else
      emit pp_decoy_env_attested false
      e4_ok=0
    fi
  fi
  bound_wait_read "$PP_WAIT"
  outcome=$(classify_provider "$lmode" now)
  [ "$e4_ok" -eq 1 ] || outcome=fail
  pp_cleanup_bound || outcome=fail
  pp_postconditions "$lmode" "e3j9nonce$e4_nonce" || outcome=fail
  trap - INT TERM HUP
  emit provider_run_result "$outcome"
  case ",$accept," in
    *",$outcome,"*) exit 0 ;;
    *) exit 1 ;;
  esac
}
pp_cleanup_bound() { bound_cleanup; }

cmd_pp_schedule() { # cmd_pp_schedule <slot>
  local slot=$1 nonce stem desc parg rc
  PP_PHASE=schedule
  trap pp_on_signal INT TERM HUP
  emit pp_mode provider
  emit pp_slot "$slot"
  require_validation_tool eanhl-cloud-credential-probe.sh
  if [ "$slot" = boot ]; then [ -f "$UNIT_PUBLISH" ] || refuse validation_tool_missing; fi
  pp_preconditions schedule provider "$slot" || refuse preconditions_failed 65
  if ! nonce=$(fresh_nonce 16); then
    emit launcher_failed rand_failed
    exit 70
  fi
  stem="$PP_PREFIX-$slot-provider-$nonce"
  emit bound_unit "$stem"
  if ! pp_name_fresh "$stem" "$slot"; then
    emit bound_unit_collision true
    exit 70
  fi
  desc="$PP_DESC_BASE ($slot armed-boot $PP_BOOT)"
  parg=$(pp_mode_field provider 2)
  if [ "$slot" != boot ]; then
    if ! "$SYSTEMD_RUN" --quiet --no-block --unit="$stem" --description="$desc" \
      "--on-active=$(pp_slot_field "$slot" 2)" --timer-property=RemainAfterElapse=yes \
      "${PROVIDER_RUN_PROPS[@]}" "$WRAPPER" --nonblock probe "$parg" >/dev/null 2>&1; then
      emit pp_scheduled false
      # A failed start cannot tell a racing foreign object from its own:
      # removal only with the fixed-property attestation.
      if ! { pp_unit_gone "$stem.service" && pp_unit_gone "$stem.timer"; }; then
        pp_cleanup_pair "$stem" "$slot" "$PP_BOOT" provider || emit pp_rollback_complete false
      fi
      exit 70
    fi
    PP_SCHED_STEM=$stem PP_SCHED_SLOT=$slot
    if pp_attest_pair "$stem" "$slot" "$PP_BOOT" && [ "$(unit_prop "$stem.timer" LastTriggerUSecMonotonic)" = 0 ]; then
      emit pp_attest_ok true
    else
      emit pp_attest_ok false
      pp_schedule_rollback
      emit pp_scheduled false
      exit 70
    fi
    PP_SCHED_STEM=''
    trap - INT TERM HUP
    emit pp_scheduled true
    exit 0
  fi
  # boot: the persistent pair, published by the reviewed helper (design §4.11)
  unit_publish publish-pair "$stem" 3< <(pp_render_service "$stem" "$PP_BOOT") 4< <(pp_render_timer "$stem" "$PP_BOOT")
  rc=$?
  if [ "$rc" -ne 0 ]; then
    [ "$rc" -eq 65 ] || [ "$rc" -eq 70 ] || emit pp_rollback_complete false
    emit pp_scheduled false
    exit 70
  fi
  PP_SCHED_STEM=$stem PP_SCHED_SLOT=boot
  if ! "$SYSTEMCTL" daemon-reload >/dev/null 2>&1; then
    emit pp_boot_step_failed daemon_reload
    pp_schedule_rollback
    emit pp_scheduled false
    exit 70
  fi
  if pp_attest_pair "$stem" boot "$PP_BOOT" disabled && [ "$(unit_prop "$stem.timer" ActiveState)" = inactive ]; then
    emit pp_attest_ok true
  else
    emit pp_attest_ok false
    pp_schedule_rollback
    emit pp_scheduled false
    exit 70
  fi
  if ! "$SYSTEMCTL" enable -- "$stem.timer" >/dev/null 2>&1; then
    emit pp_boot_step_failed enable
    pp_schedule_rollback
    emit pp_scheduled false
    exit 70
  fi
  if pp_attest_pair "$stem" boot "$PP_BOOT" enabled && [ "$(pp_wants_link_state "$stem")" = present ] &&
    [ "$(unit_prop "$stem.timer" ActiveState)" = inactive ] && [ "$(pp_object_names | /usr/bin/grep -c -F "file $WANTS_DIR/")" = 1 ]; then
    emit pp_enable_attested true
  else
    emit pp_enable_attested false
    pp_schedule_rollback
    emit pp_scheduled false
    exit 70
  fi
  if ! unit_publish fsync-wants; then
    emit pp_boot_step_failed fsync_wants
    pp_schedule_rollback
    emit pp_scheduled false
    exit 70
  fi
  PP_SCHED_STEM=''
  trap - INT TERM HUP
  emit pp_scheduled true
  exit 0
}

cmd_pp_collect() { # cmd_pp_collect <slot>
  local slot=$1 inv trig cur='' outcome=fail i id
  PP_PHASE=collect
  trap pp_on_signal INT TERM HUP
  emit pp_mode provider
  emit pp_slot "$slot"
  if ! { pp_discover "$slot" && pp_attest_found "$slot"; }; then emit provider_run_result fail; exit 65; fi
  inv=$(unit_prop "$PP_STEM.service" InvocationID)
  trig=$(unit_prop "$PP_STEM.timer" LastTriggerUSecMonotonic)
  if [ -z "$inv" ] && { [ -z "$trig" ] || [ "$trig" = 0 ]; }; then
    emit provider_run_result pending
    exit 65
  fi
  PP_COLLECT_STEM=$PP_STEM PP_COLLECT_SLOT=$slot PP_COLLECT_ARMED=$PP_ARMED
  bound_reset
  B_KIND=provider B_FILTER=provider B_MODE=$(pp_probe_mode provider) B_UNIT=$PP_STEM
  pp_load_rules "$B_MODE" || refuse usage
  B_EXPECT_ARGV="$WRAPPER --nonblock probe $(pp_mode_field provider 2)"
  B_EXPECT_ENV=''
  B_EXPECT_DESC="$PP_DESC_BASE ($slot armed-boot $PP_ARMED)"
  B_EXPECT_FRAG="$TRANSIENT_DIR/$PP_STEM.service"
  [ "$slot" != boot ] || B_EXPECT_FRAG="$UNIT_DIR/$PP_STEM.service"
  if cur=$(read_boot_id); then emit pp_boot_id_ok true; else
    cur=''
    emit pp_boot_id_ok false
  fi
  if [ "$slot" = boot ]; then B_BOOT=$cur; else B_BOOT=$PP_ARMED; fi
  for i in $(/usr/bin/seq 1 "$PP_COLLECT_BIND_TRIES"); do
    id=$(unit_prop "$PP_STEM.service" InvocationID)
    if [[ $id =~ ^[0-9a-f]{32}$ ]]; then
      B_ID=$id
      break
    fi
    /usr/bin/sleep 0.1
  done
  if [ -n "$B_ID" ]; then
    emit bound_invocation true
    bound_wait_read "$PP_WAIT"
    outcome=$(classify_provider provider "$slot")
  else
    emit bound_invocation false
  fi
  if [ -n "$cur" ] && [ "$cur" != "$PP_ARMED" ]; then emit pp_boot_id_changed true; else emit pp_boot_id_changed false; fi
  if [ "$slot" = boot ]; then
    [ -n "$cur" ] && [ "$cur" != "$PP_ARMED" ] || outcome=fail
  else
    [ "$cur" = "$PP_ARMED" ] || outcome=fail
  fi
  if ! pp_cleanup_pair "$PP_STEM" "$slot" "$PP_ARMED" provider; then
    emit pp_rollback_complete false
    outcome=fail
  fi
  PP_COLLECT_STEM=''
  mapfile -t PP_ALLOW_ACTIVE < <(pp_other_delayed_units "$slot")
  pp_postconditions provider '' || outcome=fail
  trap - INT TERM HUP
  emit provider_run_result "$outcome"
  [ "$outcome" = pass ] || exit 1
  exit 0
}

cmd_pp_discard() { # cmd_pp_discard <slot>
  local slot=$1
  PP_PHASE=discard
  emit pp_slot "$slot"
  if ! { pp_discover "$slot" && pp_attest_found "$slot"; }; then emit pp_discarded false; exit 65; fi
  if pp_cleanup_pair "$PP_STEM" "$slot" "$PP_ARMED" "$PP_LMODE"; then
    emit pp_discarded true
    exit 0
  fi
  emit pp_discarded false
  exit 1
}

# Exact whole-argument matches against the closed tables; anything else is
# refused before any systemd, journal, /proc or file access.
cmd_provider_probe() { # cmd_provider_probe <verb> <argument>
  local verb=$1 arg=$2 spec found=0
  case "$verb" in
    run)
      for spec in "${PROVIDER_MODES[@]}"; do [ "${spec%%|*}" != "$arg" ] || found=1; done
      [ "$found" -eq 1 ] || refuse usage
      cmd_pp_run "$arg"
      ;;
    schedule | collect)
      case "$arg" in t20m | t6h15m | boot) ;; *) refuse usage ;; esac
      if [ "$verb" = schedule ]; then cmd_pp_schedule "$arg"; else cmd_pp_collect "$arg"; fi
      ;;
    discard)
      case "$arg" in now | t20m | t6h15m | boot) ;; *) refuse usage ;; esac
      cmd_pp_discard "$arg"
      ;;
    *) refuse usage ;;
  esac
}

