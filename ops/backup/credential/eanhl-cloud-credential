#!/usr/bin/bash -p
# /usr/local/sbin/eanhl-cloud-credential — E3J9 root-only credential launcher
# (design §4, §6, §8, §11, §12). Install root:root 0750. Non-secret.
#
#   sudo eanhl-cloud-credential keygen
#   sudo eanhl-cloud-credential pass-init <primary-fingerprint>
#   sudo eanhl-cloud-credential probe <local-mode>     (validation only)
#   sudo eanhl-cloud-credential probe-stop <unit>      (validation only)
#   sudo eanhl-cloud-credential pty-marker             (validation only; needs a terminal)
#   sudo eanhl-cloud-credential env-proof              (validation only)
#   sudo eanhl-cloud-credential auth-login             (operator ceremony, E3J9D; PTY)
#   sudo eanhl-cloud-credential auth-logout            (local logout only; rollback)
#   sudo eanhl-cloud-credential entry-remove           (rollback/recovery only)
#   sudo eanhl-cloud-credential canary-remove          (rollback only)
#   sudo eanhl-cloud-credential key-delete <fpr>       (rollback/rotation only)
#
# Fixed subcommands only; there is no generic command runner. Every unit it
# builds runs the wrapper /usr/local/lib/eanhl-cloud/credential-exec as its
# only command, so every credential command runs under the credential lock and
# starts from the wrapper's twelve literals. No unit gets EnvironmentFile=; the
# only --setenv values (transient Environment=) are the validation-only nonce
# and decoys of pty-marker and env-proof, which stay in the wrapper's own
# environment.
#
# Exit status: every subcommand exits 0 ONLY when every required operation AND
# every stated postcondition succeeded. A printed result line never stands in
# for success; a failed operation, a failed check or an indeterminate result
# exits non-zero (64 usage/refusal, 65 precondition, 70 operation or
# postcondition, 1 validation result not accepted).
#
# Every subcommand is a template capability, not an authorization: each host
# use is separately authorized (design §10, §12, §13). The destructive
# subcommands (entry-remove, canary-remove, key-delete) are fixed and
# precondition-checked, and belong to rollback, recovery or rotation only.
#
# Root never opens, reads or searches a path inside the eanhl-cloud-owned trees
# directly: those reads run as eanhl-cloud through setpriv, so a symlink or FIFO
# planted by that identity cannot redirect a root read.
#
# This launcher is a consistency control for root-authored units. It is not
# access control against code already running as eanhl-cloud.
#
# Output: only lines matching ^E3J9 [a-z_]+=[a-z0-9_.:-]+$ (public key metadata,
# booleans, counts, exit codes). auth-login is the exception by design: the
# CLI's own PTY output goes to the operator's terminal and nowhere else.

set -u
set -o pipefail
umask 077
PATH=/usr/sbin:/usr/bin
export PATH

readonly SVC=eanhl-cloud
readonly WRAPPER=/usr/local/lib/eanhl-cloud/credential-exec
readonly VALIDATION_DIR=/usr/local/lib/eanhl-cloud/validation
readonly SVC_HOME=/var/lib/eanhl-cloud
readonly SVC_CACHE=/var/cache/eanhl-cloud
readonly STORE=/var/lib/eanhl-cloud/password-store
readonly GNUPG_DIR=/var/lib/eanhl-cloud/gnupg
readonly LOCK_FILE=/var/lib/eanhl-cloud/locks/credential.lock
readonly CLI=/opt/eanhl-cloud/bin/proton-drive
readonly CLI_PIN=cf61c2688c45e1055d8add6221d9471a5a5b64bf3bcdb86460f5cb18414596cc4df3cdb6627c9097c94bec32a3c9915ada3211ef2ae5be33c46ebbc996ccaa28
readonly AUTH_ENTRY=ch.proton.drive/drive-sdk-cli/auth-session
readonly CANARY_ENTRY=e3j9-canary/probe
readonly KEY_UID='EANHL cloud uploader credential store (Hotel-Echo)'
readonly VOCAB='^E3J9 [a-z_]+=[a-z0-9_.:-]+$'
readonly PROC_ROOT=/proc
# The store and GNUPGHOME relative to SVC_HOME: the fixed contract paths that
# svc_exists looks up from its trusted root (checked against the absolute
# constants at startup).
readonly STORE_REL=password-store
readonly GNUPG_REL=gnupg

# Resident GnuPG daemons the auth-login preflight may tolerate. One entry per
# permitted daemon: `<final executable path>|<exact PPid>|<cgroup v2 path regex>`.
# Each rule must come from host evidence collected at M8/L2 (design §6,
# [VALIDATE]); none has been observed, so the list is EMPTY and ANY resident
# eanhl-cloud process refuses the ceremony. Filling it is a template revision
# (its sha256 changes) citing that evidence.
readonly RESIDENT_AGENT_RULES=()

# External tools, by absolute path.
readonly SYSTEMCTL=/usr/bin/systemctl
readonly SYSTEMD_RUN=/usr/bin/systemd-run
readonly JOURNALCTL=/usr/bin/journalctl
readonly SETPRIV=/usr/bin/setpriv
readonly PGREP=/usr/bin/pgrep
readonly FLOCK=/usr/bin/flock

emit() { # emit <name> <value>; a value outside the vocabulary prints as `invalid`
  local value=$2
  [[ $value =~ ^[a-z0-9_.:-]+$ ]] || value=invalid
  printf 'E3J9 %s=%s\n' "$1" "$value"
}
refuse() { # refuse <reason> [exit-code]
  emit launcher_refused "$1"
  exit "${2:-64}"
}
fail_post() { # fail_post <reason>: a failed operation or postcondition
  emit launcher_failed "$1"
  exit 70
}

[ "$(/usr/bin/id -u)" = 0 ] || refuse not_root
/usr/bin/getent passwd "$SVC" >/dev/null || refuse identity_missing
[ -x "$WRAPPER" ] || refuse wrapper_missing
[ "$STORE" = "$SVC_HOME/$STORE_REL" ] && [ "$GNUPG_DIR" = "$SVC_HOME/$GNUPG_REL" ] || refuse layout_inconsistent 70

# Run a command as eanhl-cloud (no supplementary groups). Used for every read,
# lock acquisition and deletion inside the eanhl-cloud-owned trees.
#
# Safe working directory (E3J9C §19.5): setpriv keeps the caller's cwd. Run
# from an operator home (e.g. /home/utiz, 0750) the service identity cannot use
# it, and GNU find exits 1 ("Failed to restore initial working directory"), so
# keygen refused gnupghome_unreadable on Hotel-Echo. The subshell enters / —
# fixed, traversable by every identity — before exec'ing setpriv, so no
# privilege-dropped command inherits the caller's cwd. It is function-local
# (the launcher's own cwd is unchanged), adds no shell after the privilege drop
# (exec replaces the subshell with setpriv), and passes argv, redirections and
# the exit status through unchanged. Failing to enter / exits 70 without
# running setpriv: every caller treats that as a failure (fail closed).
as_svc() ( cd / || exit 70; exec "$SETPRIV" --reuid="$SVC" --regid="$SVC" --clear-groups -- "$@" )

# The §8 property set shared by every unit this launcher builds. There is
# deliberately no StateDirectory=/CacheDirectory=: M3 creates the directories,
# and a missing one fails unit setup (ReadWritePaths=, WorkingDirectory=)
# instead of being created or recursively re-owned by systemd.
readonly BASE_PROPS=(
  --uid="$SVC"
  --gid="$SVC"
  --property=WorkingDirectory=/var/lib/eanhl-cloud
  --property=UMask=0077
  --property=PrivateTmp=yes
  --property=ProtectHome=yes
  --property=ProtectSystem=strict
  "--property=ReadWritePaths=/var/lib/eanhl-cloud /var/cache/eanhl-cloud"
  --property=NoNewPrivileges=yes
  --property=KillMode=control-group
  --property=Type=oneshot
)
# Local-only units: no network namespace access at all (design §8).
readonly LOCAL_PROPS=(
  "${BASE_PROPS[@]}"
  --property=PrivateNetwork=yes
  --property=TimeoutStartSec=300
)
# Units that start the Proton CLI (auth-login, auth-logout) only.
readonly NETWORK_PROPS=(
  --property=After=network-online.target
  --property=Wants=network-online.target
)

rand_hex() { /usr/bin/od -An -N"$1" -tx1 /dev/urandom | /usr/bin/tr -d ' \n'; }
new_unit() { printf 'eanhl-cloud-cred-%s-%s' "$1" "$(rand_hex 4)"; }

# Output discarded; returns the unit's exit status.
run_quiet() { # run_quiet <label> <lockmode> <command-id> [args...]
  local label=$1
  shift
  "$SYSTEMD_RUN" --quiet --wait --collect --unit="$(new_unit "$label")" \
    --description="eanhl-cloud credential $label" "${LOCAL_PROPS[@]}" \
    --property=StandardInput=null --property=StandardOutput=null --property=StandardError=null \
    "$WRAPPER" "$@"
}

# Stdout returned to this script (parsed, never printed raw); stderr discarded.
run_capture() { # run_capture <label> <lockmode> <command-id> [args...]
  local label=$1
  shift
  "$SYSTEMD_RUN" --quiet --wait --collect --pipe --unit="$(new_unit "$label")" \
    --description="eanhl-cloud credential $label" "${LOCAL_PROPS[@]}" \
    "$WRAPPER" "$@" </dev/null 2>/dev/null
}

# Global journal search for a marker. Prints a count, or `invalid` when the
# journal cannot be read (fail closed: `invalid` never equals 0).
journal_hits_since() { # journal_hits_since <epoch> <marker>
  local out rc
  "$JOURNALCTL" --sync >/dev/null 2>&1
  out=$("$JOURNALCTL" --no-pager --quiet --since "@$1" -o json --all 2>/dev/null)
  rc=$?
  if [ "$rc" -ne 0 ]; then
    printf invalid
    return
  fi
  printf '%s\n' "$out" | /usr/bin/grep -c -F -- "$2"
}

# ── unit cleanup (part of every result) ─────────────────────────────────────
# cleanup_unit <unit>: stop + reset. Succeeds only if the unit ends inactive (or
# is no longer loaded). A unit that is already not loaded needs nothing. A show,
# stop or reset failure is a cleanup failure.
cleanup_unit() {
  local u="$1.service" load state
  load=$("$SYSTEMCTL" show -p LoadState --value -- "$u" 2>/dev/null) || return 1
  [ "$load" = not-found ] && return 0
  "$SYSTEMCTL" stop -- "$u" >/dev/null 2>&1 || return 1
  load=$("$SYSTEMCTL" show -p LoadState --value -- "$u" 2>/dev/null) || return 1
  [ "$load" = not-found ] && return 0
  if ! "$SYSTEMCTL" reset-failed -- "$u" >/dev/null 2>&1; then
    load=$("$SYSTEMCTL" show -p LoadState --value -- "$u" 2>/dev/null) || return 1
    [ "$load" = not-found ] && return 0
    return 1
  fi
  load=$("$SYSTEMCTL" show -p LoadState --value -- "$u" 2>/dev/null) || return 1
  [ "$load" = not-found ] && return 0
  state=$("$SYSTEMCTL" show -p ActiveState --value -- "$u" 2>/dev/null) || return 1
  [ "$state" = inactive ]
}

# ── invocation-bound unit runner (design §11) ───────────────────────────────
# A unit with a fresh, never-reused name is started once; its InvocationID is
# bound; the runner waits for that invocation to finish and reads ONLY its
# journal records. Results land in the B_* globals. The caller decides whether
# a successful unit is kept; every other path cleans up via bound_cleanup,
# whose result is printed and is part of the outcome.
B_UNIT='' B_ID='' B_STATUS='' B_RECORDS=() B_NONVOCAB=0 B_OK=0

bound_cleanup() {
  [ -n "$B_UNIT" ] || return 0
  if cleanup_unit "$B_UNIT"; then
    emit bound_cleanup_ok true
    return 0
  fi
  emit bound_cleanup_ok false
  return 1
}

bound_start() { # bound_start <label> <decoy-array-name> <wrapper-args...>
  local label=$1 i id load
  local -n decoys_ref=$2
  shift 2
  B_UNIT='' B_ID='' B_STATUS='' B_RECORDS=() B_NONVOCAB=0 B_OK=0
  local candidate="eanhl-cloud-cred-$label-$(rand_hex 8)"
  emit bound_unit "$candidate"
  load=$("$SYSTEMCTL" show -p LoadState --value -- "$candidate.service" 2>/dev/null)
  if [ "$load" != not-found ]; then
    # Not ours: never stop or reset a unit this run did not start.
    emit bound_unit_collision true
    return 1
  fi
  B_UNIT=$candidate
  if ! "$SYSTEMD_RUN" --quiet --no-block --unit="$B_UNIT" \
    --description="eanhl-cloud credential validation" "${LOCAL_PROPS[@]}" \
    --property=RemainAfterExit=yes --property=StandardInput=null \
    --property=StandardOutput=journal --property=StandardError=journal \
    "${decoys_ref[@]}" "$WRAPPER" "$@" >/dev/null 2>&1; then
    emit bound_start_ok false
    bound_cleanup
    return 1
  fi
  emit bound_start_ok true
  for i in $(/usr/bin/seq 1 100); do
    id=$("$SYSTEMCTL" show -p InvocationID --value -- "$B_UNIT.service" 2>/dev/null)
    if [[ $id =~ ^[0-9a-f]{32}$ ]]; then
      B_ID=$id
      emit bound_invocation true
      return 0
    fi
    /usr/bin/sleep 0.1
  done
  emit bound_invocation false
  bound_cleanup
  return 1
}

# Waits and reads. On a timeout, a changed invocation or a journal failure it
# returns 1 with B_OK=0; the CALLER then cleans up (and reports that result).
bound_wait_read() { # bound_wait_read <seconds-bound>
  local limit=$1 end state sub id out rc line
  end=$((SECONDS + limit))
  while :; do
    state=$("$SYSTEMCTL" show -p ActiveState --value -- "$B_UNIT.service" 2>/dev/null)
    sub=$("$SYSTEMCTL" show -p SubState --value -- "$B_UNIT.service" 2>/dev/null)
    if [ "$state" = failed ] || [ "$state" = inactive ] || { [ "$state" = active ] && [ "$sub" = exited ]; }; then
      break
    fi
    if [ "$SECONDS" -ge "$end" ]; then
      emit bound_wait_timeout true
      return 1
    fi
    /usr/bin/sleep 0.2
  done
  id=$("$SYSTEMCTL" show -p InvocationID --value -- "$B_UNIT.service" 2>/dev/null)
  if [ "$id" != "$B_ID" ]; then
    emit bound_invocation_changed true
    return 1
  fi
  B_STATUS=$("$SYSTEMCTL" show -p ExecMainStatus --value -- "$B_UNIT.service" 2>/dev/null)
  [[ $B_STATUS =~ ^[0-9]+$ ]] || B_STATUS=unknown
  emit bound_exit_status "$B_STATUS"
  "$JOURNALCTL" --sync >/dev/null 2>&1
  out=$("$JOURNALCTL" --no-pager --quiet -o cat \
    "_SYSTEMD_UNIT=$B_UNIT.service" "_SYSTEMD_INVOCATION_ID=$B_ID" 2>/dev/null)
  rc=$?
  if [ "$rc" -ne 0 ]; then
    emit bound_journal_ok false
    return 1
  fi
  emit bound_journal_ok true
  if [ -n "$out" ]; then
    while IFS= read -r line; do
      if [[ $line =~ $VOCAB ]]; then B_RECORDS+=("$line"); else B_NONVOCAB=$((B_NONVOCAB + 1)); fi
    done <<<"$out"
  fi
  for line in "${B_RECORDS[@]}"; do printf '%s\n' "$line"; done
  emit bound_nonvocab_lines "$B_NONVOCAB"
  B_OK=1
  return 0
}

# Classify a bound probe run: pass | busy | fail (design §11).
classify_probe() { # classify_probe <mode>
  local mode=$1 line modes=0 passes=0 fails=0
  if [ "$B_OK" -ne 1 ]; then printf fail; return; fi
  if [ "$B_STATUS" = 75 ] && [ "${#B_RECORDS[@]}" -eq 0 ] && [ "$B_NONVOCAB" -eq 0 ]; then
    printf busy
    return
  fi
  if [ "$B_NONVOCAB" -ne 0 ] || [ "${#B_RECORDS[@]}" -eq 0 ] || [ "$B_STATUS" != 0 ]; then
    printf fail
    return
  fi
  [ "${B_RECORDS[0]}" = "E3J9 probe_mode=$mode" ] || { printf fail; return; }
  for line in "${B_RECORDS[@]}"; do
    case "$line" in
      'E3J9 probe_mode='*) modes=$((modes + 1)) ;;
      'E3J9 probe_result=pass') passes=$((passes + 1)) ;;
      'E3J9 probe_result='*) fails=$((fails + 1)) ;;
    esac
  done
  if [ "$modes" -eq 1 ] && [ "$passes" -eq 1 ] && [ "$fails" -eq 0 ]; then printf pass; else printf fail; fi
}

# Classify a bound non-probe run (env-inspect boundary): pass | fail.
classify_plain() {
  if [ "$B_OK" -eq 1 ] && [ "$B_STATUS" = 0 ] && [ "$B_NONVOCAB" -eq 0 ] && [ "${#B_RECORDS[@]}" -gt 0 ]; then
    printf pass
  else
    printf fail
  fi
}

# ── key metadata ─────────────────────────────────────────────────────────────

list_secret_keys() {
  run_capture keylist --nonblock gpg --batch --with-colons --fixed-list-mode --list-secret-keys
}

secret_key_count() { # secret_key_count <listing>
  local n
  n=$(printf '%s\n' "$1" | /usr/bin/grep -c '^sec:')
  printf '%s' "${n:-0}"
}

lower_or_none() { local v=${1,,}; printf '%s' "${v:-none}"; }
own_caps() { printf '%s' "${1//[!a-z]/}"; }
total_caps() { local u=${1//[!A-Z]/}; printf '%s' "${u,,}"; }
secret_flag() {
  case "$1" in
    +) printf present ;;
    '#') printf stub ;;
    '') printf none ;;
    *) printf token ;;
  esac
}

# Public metadata only: fingerprints, algorithm ids, capability letters,
# creation/expiry fields, counts. Keygrips and user-ID text are not printed.
emit_key_metadata() { # emit_key_metadata <listing>
  local listing=$1 line last="" sec=0 ssb=0 uids=0 uid_match=false
  local f=()
  while IFS= read -r line; do
    IFS=: read -r -a f <<<"$line"
    case "${f[0]-}" in
      sec | ssb)
        if [ "${f[0]}" = sec ]; then
          sec=$((sec + 1))
          last=primary
        else
          ssb=$((ssb + 1))
          last=subkey
        fi
        emit "key_${last}_algo" "${f[3]-}"
        emit "key_${last}_curve" "$(lower_or_none "${f[16]-}")"
        emit "key_${last}_usage" "$(own_caps "${f[11]-}")"
        [ "$last" = primary ] && emit key_total_caps "$(total_caps "${f[11]-}")"
        emit "key_${last}_created" "${f[5]-}"
        emit "key_${last}_expires" "${f[6]:-never}"
        emit "key_${last}_secret" "$(secret_flag "${f[14]-}")"
        ;;
      fpr)
        [ -n "$last" ] && emit "key_${last}_fpr" "$(lower_or_none "${f[9]-}")"
        last=""
        ;;
      uid)
        uids=$((uids + 1))
        [ "${f[9]-}" = "$KEY_UID" ] && uid_match=true
        ;;
    esac
  done <<<"$listing"
  emit key_secret_count "$sec"
  emit key_subkey_count "$ssb"
  emit key_uid_count "$uids"
  emit key_uid_match "$uid_match"
}

# The keygen postcondition (design §5): exactly one primary secret key with its
# certify capability and a 40-hex fingerprint, exactly one encryption-capable
# secret subkey and no other subkey, exactly one user ID equal to KEY_UID, both
# secret parts present, and no expiry. Algorithms are recorded, not asserted
# (future-default is [VALIDATE]). Returns 0 only if all hold.
check_key_topology() { # check_key_topology <listing>
  local listing=$1 line last="" sec=0 ssb=0 enc=0 uids=0 uid_ok=0 fpr_ok=0 certify=0 secret_ok=1 expiry_ok=1
  local f=()
  while IFS= read -r line; do
    IFS=: read -r -a f <<<"$line"
    case "${f[0]-}" in
      sec)
        sec=$((sec + 1))
        last=primary
        [[ $(own_caps "${f[11]-}") == *c* ]] && certify=1
        [ "${f[14]-}" = + ] || secret_ok=0
        [ -z "${f[6]-}" ] || expiry_ok=0
        ;;
      ssb)
        ssb=$((ssb + 1))
        last=subkey
        [[ $(own_caps "${f[11]-}") == *e* ]] && enc=$((enc + 1))
        [ "${f[14]-}" = + ] || secret_ok=0
        [ -z "${f[6]-}" ] || expiry_ok=0
        ;;
      fpr)
        if [ "$last" = primary ] && [[ ${f[9]-} =~ ^[0-9A-F]{40}$ ]]; then fpr_ok=1; fi
        last=""
        ;;
      uid)
        uids=$((uids + 1))
        [ "${f[9]-}" = "$KEY_UID" ] && uid_ok=1
        ;;
    esac
  done <<<"$listing"
  if [ "$sec" -eq 1 ] && [ "$fpr_ok" -eq 1 ] && [ "$certify" -eq 1 ] && [ "$ssb" -eq 1 ] \
    && [ "$enc" -eq 1 ] && [ "$uids" -eq 1 ] && [ "$uid_ok" -eq 1 ] && [ "$secret_ok" -eq 1 ] \
    && [ "$expiry_ok" -eq 1 ]; then
    emit key_topology_ok true
    return 0
  fi
  emit key_topology_ok false
  return 1
}

primary_fpr_upper() { # primary_fpr_upper <listing>: the fingerprint after the first sec record
  printf '%s\n' "$1" | /usr/bin/awk -F: '$1 == "sec" { want = 1; next } want && $1 == "fpr" { print toupper($10); exit }'
}

# ── metadata helpers (all reads as eanhl-cloud) ──────────────────────────────

svc_meta() { # svc_meta <path>: `%F %a %U %G` without following symlinks, or empty
  as_svc /usr/bin/stat -c '%F %a %U %G' -- "$1" 2>/dev/null
}

# svc_exists <relative path under SVC_HOME>: prints present | absent | error.
#
# Presence proof, run as eanhl-cloud (setpriv). Starting at the trusted root
# SVC_HOME (a real directory, `cd -P`, `pwd -P` must equal it), each component is
# looked up by LISTING the current directory with the fixed expression
# `find . -mindepth 1 -maxdepth 1 -print` and comparing whole lines with
# `./<component>`; the caller's text never enters the find expression.
#   - listed as the final component            → present (a symlink, dangling
#                                                 or not, counts as present);
#   - not listed, and that listing succeeded   → absent;
#   - any listing that fails (unreadable directory, I/O), an intermediate
#     component that is a symlink or not a directory, a failed `cd` into it
#     (e.g. mode 000), or a malformed path     → error.
# "absent" is therefore only ever reported after the containing directory was
# reached from the root and listed successfully. No native error text is read.
# The path is validated here and again in the script: components of
# [A-Za-z0-9._-], no empty, `.`, `..` or leading-`-` component, no leading or
# trailing `/`. NOT race-free: each component is listed, checked (`-L`, `-d`)
# and entered in separate steps, so a concurrent change by eanhl-cloud itself
# (outside the protection boundary) can race them. What holds: an intermediate
# symlink seen at check time is refused; after every `cd -P` the physical cwd
# must still be inside SVC_HOME, so a swap that escapes the tree is detected
# as `error`. A swap that redirects WITHIN SVC_HOME, or a change right after the
# final listing, can give an answer that is stale for that instant.
readonly SVC_EXISTS_SCRIPT='
set -u
root=$1 rel=$2
case "$root" in /*) ;; *) exit 12 ;; esac
case "$rel" in "" | /* | */ | *//*) exit 12 ;; esac
[ -d "$root" ] && [ ! -L "$root" ] || exit 12
cd -P -- "$root" 2>/dev/null || exit 12
[ "$(pwd -P)" = "$root" ] || exit 12
IFS=/ read -r -a parts <<<"$rel"
n=${#parts[@]}
[ "$n" -ge 1 ] || exit 12
i=0
for part in "${parts[@]}"; do
  i=$((i + 1))
  case "$part" in "" | . | .. | -*) exit 12 ;; esac
  [[ $part =~ ^[A-Za-z0-9._-]+$ ]] || exit 12
  listing=$(/usr/bin/find . -mindepth 1 -maxdepth 1 -print 2>/dev/null) || exit 12
  found=0
  while IFS= read -r entry; do
    [ "$entry" = "./$part" ] && found=1
  done <<<"$listing"
  [ "$found" -eq 1 ] || exit 11
  [ "$i" -eq "$n" ] && exit 10
  [ -L "$part" ] && exit 12
  [ -d "$part" ] || exit 12
  cd -P -- "$part" 2>/dev/null || exit 12
  case "$(pwd -P)/" in "$root"/*) ;; *) exit 12 ;; esac
done
exit 12
'
svc_exists() {
  local rel=$1 part
  case "$rel" in "" | /* | */ | *//*)
    printf error
    return
    ;;
  esac
  local parts=()
  IFS=/ read -r -a parts <<<"$rel"
  for part in "${parts[@]}"; do
    case "$part" in "" | . | .. | -*)
      printf error
      return
      ;;
    esac
    [[ $part =~ ^[A-Za-z0-9._-]+$ ]] || {
      printf error
      return
    }
  done
  as_svc /usr/bin/bash -p -c "$SVC_EXISTS_SCRIPT" _ "$SVC_HOME" "$rel" >/dev/null 2>&1
  case $? in
    10) printf present ;;
    11) printf absent ;;
    *) printf error ;;
  esac
}

# Count entries below <dir> (find as eanhl-cloud). Prints the count, or fails
# (non-zero) when find fails, so an unreadable tree never counts as empty.
svc_count() { # svc_count <dir> [find-predicates...]
  local dir=$1 out rc lines=()
  shift
  out=$(as_svc /usr/bin/find "$dir" -mindepth 1 "$@" -print 2>/dev/null)
  rc=$?
  [ "$rc" -eq 0 ] || return 1
  if [ -z "$out" ]; then
    printf 0
  else
    mapfile -t lines <<<"$out"
    printf '%s' "${#lines[@]}"
  fi
}

# Read the single-line .gpg-id as eanhl-cloud after proving it a regular file.
read_gpg_id() {
  local meta
  meta=$(svc_meta "$STORE/.gpg-id")
  case "$meta" in
    "regular file 600 $SVC $SVC") ;;
    *) return 1 ;;
  esac
  as_svc /usr/bin/cat -- "$STORE/.gpg-id" 2>/dev/null
}

store_dir_ok() { [ "$(svc_meta "$STORE")" = "directory 700 $SVC $SVC" ]; }

no_active_credential_unit() {
  local out
  out=$("$SYSTEMCTL" list-units --all --plain --no-legend \
    --state=activating,active,deactivating,reloading 'eanhl-cloud-*' 2>/dev/null) || return 1
  [ -z "$out" ]
}

# ── subcommands ──────────────────────────────────────────────────────────────

cmd_keygen() {
  local listing count rc n
  # GNUPGHOME must be the M3 directory, still empty, checked before any gpg run
  # creates files in it.
  [ "$(svc_meta "$GNUPG_DIR")" = "directory 700 $SVC $SVC" ] || refuse gnupghome_wrong 65
  n=$(svc_count "$GNUPG_DIR") || refuse gnupghome_unreadable 70
  emit gnupghome_entry_count_before "$n"
  [ "$n" = 0 ] || refuse gnupghome_not_empty 65
  listing=$(list_secret_keys) || refuse keylist_failed 70
  count=$(secret_key_count "$listing")
  if [ "$count" != 0 ]; then
    emit keygen_existing_secret_keys "$count"
    refuse keyring_not_empty 65
  fi
  # The empty passphrase is not a secret: the key is deliberately unprotected
  # (§5). A dropped empty argv element makes gpg fail (fail closed); L1 under
  # `pinentry-mode error` then proves the key needs no passphrase.
  run_quiet keygen --nonblock gpg --batch --pinentry-mode loopback --passphrase '' \
    --quick-generate-key "$KEY_UID" future-default default never
  rc=$?
  emit keygen_unit_rc "$rc"
  [ "$rc" -eq 0 ] || fail_post keygen_unit
  listing=$(list_secret_keys) || fail_post keylist_after_keygen
  emit_key_metadata "$listing"
  check_key_topology "$listing" || fail_post key_topology
  emit keygen_postconditions_ok true
}

cmd_pass_init() {
  local fpr=${1^^} listing count entries rc gpg_id
  [[ $fpr =~ ^[0-9A-F]{40}$ ]] || refuse bad_fingerprint
  # A9: the store is the M3 directory, correctly owned, and empty now. That it
  # is the one M3 created is established by the session record, not metadata.
  store_dir_ok || refuse store_dir_wrong 65
  entries=$(svc_count "$STORE") || refuse store_unreadable 70
  emit store_entry_count_before "$entries"
  [ "$entries" = 0 ] || refuse store_not_empty 65
  listing=$(list_secret_keys) || refuse keylist_failed 70
  count=$(secret_key_count "$listing")
  emit key_secret_count "$count"
  [ "$count" = 1 ] || refuse key_count_not_one 65
  [ "$(primary_fpr_upper "$listing")" = "$fpr" ] || refuse fingerprint_mismatch 65
  emit pass_init_key_match true
  run_quiet pass-init --nonblock pass init "$fpr"
  rc=$?
  emit pass_init_unit_rc "$rc"
  [ "$rc" -eq 0 ] || fail_post pass_init_unit
  # Postconditions: .gpg-id is a 0600 regular file owned by the identity,
  # holding exactly the one fingerprint, and it is the store's only entry.
  if ! gpg_id=$(read_gpg_id); then
    emit gpg_id_meta_ok false
    fail_post gpg_id_unreadable
  fi
  emit gpg_id_meta_ok true
  if [ "$gpg_id" != "$fpr" ]; then
    emit gpg_id_single_line_match false
    fail_post gpg_id_mismatch
  fi
  emit gpg_id_single_line_match true
  entries=$(svc_count "$STORE" ! -path "$STORE/.gpg-id") || fail_post store_unreadable_after
  emit store_other_entry_count_after "$entries"
  [ "$entries" = 0 ] || fail_post store_not_gpg_id_only
  emit pass_init_postconditions_ok true
}

require_validation_tool() {
  [ -x "$VALIDATION_DIR/$1" ] || refuse validation_tool_missing
}

# Local probe modes the launcher may start: <mode>:<accepted outcomes>:<keep>.
# Provider modes are deliberately absent (they run only through the provider
# template, installed and authorized in E3J9D/E3J9E). A keep-mode unit is left
# running ONLY after it reached `pass`; any other outcome is cleaned up.
readonly PROBE_MODES=(
  precheck:pass:0
  local:pass:0
  canary:pass:1
  canary-a:pass,busy:0
  canary-b:pass,busy:0
  neg-uninit:pass:0
  lockhold-hold:pass:0
  lockhold-long:pass:1
  lockhold-detach:pass:1
  busy-a:busy:0
  busy-b:busy:0
  busy-c:busy:0
  busy-d:busy:0
)

cmd_probe() {
  local mode=$1 spec accept="" keep=0 outcome none=()
  for spec in "${PROBE_MODES[@]}"; do
    if [ "${spec%%:*}" = "$mode" ]; then
      accept=${spec#*:}
      keep=${accept#*:}
      accept=${accept%:*}
    fi
  done
  [ -n "$accept" ] || refuse usage
  require_validation_tool eanhl-cloud-credential-probe.sh
  emit probe_requested_mode "$mode"
  if ! bound_start "probe-$mode" none --nonblock probe "local:$mode"; then
    emit probe_run_result fail
    exit 70
  fi
  bound_wait_read 330
  outcome=$(classify_probe "$mode")
  if [ "$keep" -eq 1 ] && [ "$outcome" = pass ]; then
    emit probe_unit_kept true
  else
    bound_cleanup || outcome=fail
  fi
  emit probe_run_result "$outcome"
  case ",$accept," in
    *",$outcome,"*) exit 0 ;;
    *) exit 1 ;;
  esac
}

# Stop a kept probe unit. It must exist (a typo never "succeeds"), and both the
# stop and the reset/cleanup must succeed.
cmd_probe_stop() {
  local unit=$1 load
  [[ $unit =~ ^eanhl-cloud-cred-probe-[a-z0-9-]+$ ]] || refuse usage
  load=$("$SYSTEMCTL" show -p LoadState --value -- "$unit.service" 2>/dev/null) || load=error
  if [ "$load" != loaded ]; then
    emit probe_unit_found false
    emit probe_stopped false
    exit 1
  fi
  if cleanup_unit "$unit"; then
    emit probe_stopped true
  else
    emit probe_stopped false
    exit 1
  fi
}

cmd_pty_marker() {
  local nonce t0 rc hits
  require_validation_tool pty-marker
  [ -t 0 ] && [ -t 1 ] || refuse no_terminal
  nonce=$(rand_hex 16)
  t0=$(/usr/bin/date +%s)
  "$SYSTEMD_RUN" --quiet --pty --wait --collect --unit="$(new_unit pty)" \
    --description="eanhl-cloud credential pty-marker" "${LOCAL_PROPS[@]}" \
    --setenv=E3J9_PTY_NONCE="$nonce" "$WRAPPER" --nonblock pty-marker
  rc=$?
  /usr/bin/sleep 2
  emit pty_marker_unit_rc "$rc"
  hits=$(journal_hits_since "$t0" "$nonce")
  emit pty_marker_journal_hits "$hits"
  if [ "$rc" -eq 0 ] && [ "$hits" = 0 ]; then
    emit pty_marker_result pass
    return 0
  fi
  emit pty_marker_result fail
  exit 1
}

cmd_env_proof() {
  local nonce t0 result hits all=pass
  require_validation_tool env-inspect
  require_validation_tool eanhl-cloud-credential-probe.sh
  require_validation_tool lockhold
  nonce="e3j9nonce$(rand_hex 16)"
  # E3: effect-bearing decoys on the unit. They reach the wrapper's environment
  # only; env -i must keep every one of them away from the credential command.
  local decoys=(
    --setenv=E3J9_INJECTED="$nonce"
    --setenv=GNUPGHOME=/nonexistent-e3j9
    --setenv=PASSWORD_STORE_DIR=/nonexistent-e3j9
    --setenv=PASSWORD_STORE_GPG_OPTS=--e3j9-invalid
    --setenv=PATH=/nonexistent-e3j9
    --setenv=GPG_TTY=/dev/e3j9-decoy
    --setenv=PROTON_DRIVE_BASE_URL=http://127.0.0.1:9
  )
  t0=$(/usr/bin/date +%s)

  # E1(b) + E2 wrapper side: env-inspect exec'd directly as the credential command.
  emit envproof_step boundary
  if bound_start envproof-boundary decoys --nonblock env-inspect boundary; then
    bound_wait_read 330
    result=$(classify_plain)
    bound_cleanup || result=fail
  else
    result=fail
  fi
  emit envproof_step_result "$result"
  [ "$result" = pass ] || all=fail

  # E3(b)(c) + E2 downstream: the probe (local mode, L1 canary) under the decoys.
  emit envproof_step canary
  if bound_start envproof-canary decoys --nonblock probe local:local; then
    bound_wait_read 330
    result=$(classify_probe local)
    bound_cleanup || result=fail
  else
    result=fail
  fi
  emit envproof_step_result "$result"
  [ "$result" = pass ] || all=fail

  # Supplementary only: root reads /proc/<pid>/environ of live pass/GPG processes
  # while a lockhold canary runs under the same decoys. Its own output never
  # decides the outcome; the step's probe result does.
  emit envproof_step observe
  if bound_start envproof-observe decoys --nonblock probe local:lockhold-hold; then
    "$VALIDATION_DIR/env-inspect" observe "$B_UNIT.service" 60
    bound_wait_read 330
    result=$(classify_probe lockhold-hold)
    bound_cleanup || result=fail
  else
    result=fail
  fi
  emit envproof_step_result "$result"
  [ "$result" = pass ] || all=fail

  /usr/bin/sleep 1
  hits=$(journal_hits_since "$t0" "$nonce")
  emit envproof_nonce_journal_hits "$hits"
  [ "$hits" = 0 ] || all=fail
  emit envproof_result "$all"
  [ "$all" = pass ] || exit 1
}

# One resident-agent rule check. Returns 0 only if <pid>'s evidence satisfies
# <rule> = `<exe>|<ppid>|<cgroup regex>`: the exe was matched by the caller;
# here the PPid must equal the rule and /proc/<pid>/cgroup must be exactly one
# cgroup v2 line `0::<path>` whose path matches the rule's regex.
agent_rule_holds() { # agent_rule_holds <pid> <rule>
  local pid=$1 rule=$2 r_exe r_ppid r_cg ppid_line ppid cg_lines=()
  IFS='|' read -r r_exe r_ppid r_cg <<<"$rule"
  [[ $r_ppid =~ ^[0-9]+$ ]] && [ -n "$r_cg" ] || return 1
  ppid_line=$(/usr/bin/grep -m 1 '^PPid:' "$PROC_ROOT/$pid/status" 2>/dev/null) || return 1
  read -r _ ppid _ <<<"$ppid_line"
  [ "$ppid" = "$r_ppid" ] || {
    emit preflight_agent_parent_mismatch true
    return 1
  }
  mapfile -t cg_lines <"$PROC_ROOT/$pid/cgroup" 2>/dev/null || return 1
  if [ "${#cg_lines[@]}" -ne 1 ] || [[ ${cg_lines[0]} != 0::* ]] || ! [[ ${cg_lines[0]#0::} =~ $r_cg ]]; then
    emit preflight_agent_cgroup_mismatch true
    return 1
  fi
  return 0
}

# §6 fail-closed preflight for the ceremony. Metadata only: per process it
# reads /proc/<pid>/exe (readlink), the Uid:/PPid: lines of status, and cgroup —
# never cmdline or environ, and never a credential.
preflight_auth_login() {
  local listing count fpr gpg_id n a pids pid exe uid_line u1 u2 u3 u4 svc_uid seen_exes=() rule matched dup
  # 1. static checks
  if [ -f "$CLI" ] && [ "$(/usr/bin/sha512sum -- "$CLI" 2>/dev/null | /usr/bin/cut -d ' ' -f 1)" = "$CLI_PIN" ]; then
    emit preflight_cli_pin_match true
  else
    emit preflight_cli_pin_match false
    return 1
  fi
  listing=$(list_secret_keys) || { emit preflight_keylist_ok false; return 1; }
  count=$(secret_key_count "$listing")
  emit preflight_key_secret_count "$count"
  [ "$count" = 1 ] || return 1
  fpr=$(primary_fpr_upper "$listing")
  store_dir_ok || { emit preflight_store_dir_ok false; return 1; }
  n=$(svc_count "$STORE" ! -path "$STORE/.gpg-id") || { emit preflight_store_readable false; return 1; }
  emit preflight_store_other_entries "$n"
  [ "$n" = 0 ] || return 1
  gpg_id=$(read_gpg_id) || { emit preflight_gpg_id_ok false; return 1; }
  if [ "$gpg_id" = "$fpr" ]; then emit preflight_gpg_id_match true; else
    emit preflight_gpg_id_match false
    return 1
  fi
  n=$(svc_count "$SVC_HOME" -name auth-session.json) || { emit preflight_fallback_scan_ok false; return 1; }
  a=$(svc_count "$SVC_CACHE" -name auth-session.json) || { emit preflight_fallback_scan_ok false; return 1; }
  emit preflight_fallback_file_count "$((n + a))"
  [ "$((n + a))" -eq 0 ] || return 1
  # 2. no credential unit is active
  if no_active_credential_unit; then emit preflight_no_active_unit true; else
    emit preflight_no_active_unit false
    return 1
  fi
  # 3. every eanhl-cloud process satisfies a resident-agent rule, at most once
  svc_uid=$(/usr/bin/id -u "$SVC") || return 1
  pids=$("$PGREP" -u "$SVC" 2>/dev/null)
  case $? in
    0 | 1) ;;
    *)
      emit preflight_process_scan_ok false
      return 1
      ;;
  esac
  for pid in $pids; do
    [[ $pid =~ ^[0-9]+$ ]] || { emit preflight_process_scan_ok false; return 1; }
    if ! exe=$(/usr/bin/readlink -- "$PROC_ROOT/$pid/exe" 2>/dev/null); then
      if [ ! -d "$PROC_ROOT/$pid" ]; then emit preflight_scan_race true; else emit preflight_unexpected_process true; fi
      return 1
    fi
    uid_line=$(/usr/bin/grep -m 1 '^Uid:' "$PROC_ROOT/$pid/status" 2>/dev/null) || { emit preflight_scan_race true; return 1; }
    read -r _ u1 u2 u3 u4 <<<"$uid_line"
    if [ "$u1" != "$svc_uid" ] || [ "$u2" != "$svc_uid" ] || [ "$u3" != "$svc_uid" ] || [ "$u4" != "$svc_uid" ]; then
      emit preflight_unexpected_process true
      return 1
    fi
    case "$exe" in *' (deleted)')
      emit preflight_unexpected_process true
      return 1
      ;;
    esac
    if [ "$exe" = "$CLI" ]; then
      emit preflight_cli_running true
      return 1
    fi
    matched=''
    for rule in "${RESIDENT_AGENT_RULES[@]}"; do
      [ "${rule%%|*}" = "$exe" ] && matched=$rule
    done
    if [ -z "$matched" ]; then
      emit preflight_unexpected_process true
      return 1
    fi
    agent_rule_holds "$pid" "$matched" || {
      emit preflight_unexpected_process true
      return 1
    }
    for dup in "${seen_exes[@]}"; do
      if [ "$dup" = "$exe" ]; then
        emit preflight_unexpected_process true
        return 1
      fi
    done
    seen_exes+=("$exe")
  done
  emit preflight_resident_agent_count "${#seen_exes[@]}"
  emit preflight_unexpected_process false
  # 4. the lock can be acquired (as eanhl-cloud; the path is never opened as root)
  if [ -L "$LOCK_FILE" ] || [ ! -f "$LOCK_FILE" ]; then
    emit preflight_lock_file_ok false
    return 1
  fi
  if as_svc "$FLOCK" --nonblock --exclusive --conflict-exit-code 75 "$LOCK_FILE" /usr/bin/true; then
    emit preflight_lock_free true
  else
    emit preflight_lock_free false
    return 1
  fi
  return 0
}

# E3J9D only, operator-performed (§6). The agent never runs this.
cmd_auth_login() {
  local rc
  [ -t 0 ] && [ -t 1 ] || refuse no_terminal
  preflight_auth_login || refuse preflight_failed 65
  "$SYSTEMD_RUN" --quiet --pty --wait --collect --unit="$(new_unit auth-login)" \
    --description="eanhl-cloud credential auth-login" "${BASE_PROPS[@]}" "${NETWORK_PROPS[@]}" \
    --property=TimeoutStartSec=900 \
    "$WRAPPER" --nonblock proton-drive auth login
  rc=$?
  emit auth_login_unit_rc "$rc"
  [ "$rc" -eq 0 ] || exit 1
}

# Local logout only: pass rm -f + cleared caches. Not remote revocation (§12).
# Succeeds only if the unit succeeded AND the entry is proven absent afterwards.
cmd_auth_logout() {
  local rc state
  "$SYSTEMD_RUN" --quiet --wait --collect --unit="$(new_unit auth-logout)" \
    --description="eanhl-cloud credential auth-logout" "${BASE_PROPS[@]}" "${NETWORK_PROPS[@]}" \
    --property=TimeoutStartSec=300 \
    --property=StandardInput=null --property=StandardOutput=null --property=StandardError=null \
    "$WRAPPER" --nonblock proton-drive auth logout
  rc=$?
  emit auth_logout_unit_rc "$rc"
  [ "$rc" -eq 0 ] || fail_post auth_logout_unit
  state=$(svc_exists "$STORE_REL/$AUTH_ENTRY.gpg")
  emit auth_entry_after_logout "$state"
  [ "$state" = absent ] || fail_post auth_entry_not_proven_absent
}

# Rollback/recovery: remove one fixed pass entry with `pass rm -f`.
remove_fixed_entry() { # remove_fixed_entry <label> <entry>
  local label=$1 entry=$2 rc meta state
  no_active_credential_unit || refuse credential_unit_active 65
  store_dir_ok || refuse store_dir_wrong 65
  meta=$(svc_meta "$STORE/$entry.gpg")
  case "$meta" in
    "regular file 600 $SVC $SVC") ;;
    *) refuse entry_not_regular_file 65 ;;
  esac
  run_quiet "$label" --nonblock pass rm -f "$entry"
  rc=$?
  emit "${label//-/_}_unit_rc" "$rc"
  state=$(svc_exists "$STORE_REL/$entry.gpg")
  emit entry_after "$state"
  [ "$rc" -eq 0 ] || fail_post "${label//-/_}_unit"
  [ "$state" = absent ] || fail_post entry_not_proven_absent
}

# Rollback/rotation: delete the one secret key, only once no entry needs it.
cmd_key_delete() {
  local fpr=${1^^} listing count n gpg_id rc state rev
  [[ $fpr =~ ^[0-9A-F]{40}$ ]] || refuse bad_fingerprint
  no_active_credential_unit || refuse credential_unit_active 65
  listing=$(list_secret_keys) || refuse keylist_failed 70
  count=$(secret_key_count "$listing")
  emit key_secret_count "$count"
  [ "$count" = 1 ] || refuse key_count_not_one 65
  [ "$(primary_fpr_upper "$listing")" = "$fpr" ] || refuse fingerprint_mismatch 65
  state=$(svc_exists "$STORE_REL")
  case "$state" in
    absent) ;;
    present)
      n=$(svc_count "$STORE" -name '*.gpg') || refuse store_unreadable 70
      emit store_gpg_entry_count "$n"
      [ "$n" = 0 ] || refuse store_has_entries 65
      state=$(svc_exists "$STORE_REL/.gpg-id")
      case "$state" in
        absent) ;;
        present)
          gpg_id=$(read_gpg_id) || refuse gpg_id_wrong 65
          [ "$gpg_id" = "$fpr" ] || refuse gpg_id_mismatch 65
          ;;
        *) refuse gpg_id_state_unknown 70 ;;
      esac
      ;;
    *) refuse store_state_unknown 70 ;;
  esac
  run_quiet key-delete --nonblock gpg --batch --yes --delete-secret-and-public-key "$fpr"
  rc=$?
  emit key_delete_unit_rc "$rc"
  [ "$rc" -eq 0 ] || fail_post key_delete_unit
  rev="$GNUPG_DIR/openpgp-revocs.d/$fpr.rev"
  as_svc /usr/bin/rm -f -- "$rev" || fail_post revocation_file_remove
  state=$(svc_exists "$GNUPG_REL/openpgp-revocs.d/$fpr.rev")
  emit revocation_file_after "$state"
  [ "$state" = absent ] || fail_post revocation_file_not_proven_absent
  listing=$(list_secret_keys) || fail_post keylist_after_delete
  count=$(secret_key_count "$listing")
  emit key_secret_count_after "$count"
  [ "$count" = 0 ] || fail_post secret_key_remains
  emit key_delete_postconditions_ok true
}

case "${1-}" in
  keygen)
    [ "$#" -eq 1 ] || refuse usage
    cmd_keygen
    ;;
  pass-init)
    [ "$#" -eq 2 ] || refuse usage
    cmd_pass_init "$2"
    ;;
  probe)
    [ "$#" -eq 2 ] || refuse usage
    cmd_probe "$2"
    ;;
  probe-stop)
    [ "$#" -eq 2 ] || refuse usage
    cmd_probe_stop "$2"
    ;;
  pty-marker)
    [ "$#" -eq 1 ] || refuse usage
    cmd_pty_marker
    ;;
  env-proof)
    [ "$#" -eq 1 ] || refuse usage
    cmd_env_proof
    ;;
  auth-login)
    [ "$#" -eq 1 ] || refuse usage
    cmd_auth_login
    ;;
  auth-logout)
    [ "$#" -eq 1 ] || refuse usage
    cmd_auth_logout
    ;;
  entry-remove)
    [ "$#" -eq 1 ] || refuse usage
    remove_fixed_entry entry-remove "$AUTH_ENTRY"
    ;;
  canary-remove)
    [ "$#" -eq 1 ] || refuse usage
    remove_fixed_entry canary-remove "$CANARY_ENTRY"
    ;;
  key-delete)
    [ "$#" -eq 2 ] || refuse usage
    cmd_key_delete "$2"
    ;;
  *) refuse usage ;;
esac
