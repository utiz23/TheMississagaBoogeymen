#!/usr/bin/bash -p
# /usr/local/lib/eanhl-cloud/validation/owned-inventory — E3J9 validation only
# (design §11 "Owned-inventory", §12 step 11). Install root:root 0755. Removed
# after E3J9E (D8); for rollback, run a copy from a root-only temporary path
# (e.g. /run/eanhl-cloud-rollback/) and remove it afterwards.
#
# Run as root. Finds every object owned by the eanhl-cloud uid OR gid on each
# filesystem holding /, /var, /var/tmp, /opt, /etc, /usr/local, /tmp, /home,
# /run and /dev/shm, and compares the result IN MEMORY with an expected set.
# The result is evidence only within those scan roots.
#
#   owned-inventory               expected set = the design §2 layout.
#   owned-inventory expect-none   §12 step 11 (account removal): the expected
#                                 set is EMPTY.
#
# Preconditions (both modes, fail closed, scan code 4): NO process runs as
# eanhl-cloud at all (`pgrep -u` must report none; a pgrep or /proc error is a
# failure), and no eanhl-cloud-* unit is activating, active, deactivating or
# reloading (a systemctl error is a failure). This is deliberately stricter
# than the auth-login preflight: no resident-agent exception exists here until
# a design revision adds the same evidence-bound rule.
#
# Prints only:
#
#   E3J9 owned_expected_set_match=true|false
#   E3J9 owned_unexpected_count=<n>
#   E3J9 owned_scan_code=<n>   0 ok · 1 scan error · 2 identity missing ·
#                              3 a required §2 object is missing or wrong ·
#                              4 precondition failed · 64 usage
#
# It never prints a path or a name. On a mismatch, only the operator inspects.
set -u
umask 077

emit() { # emit <name> <value>; a value outside the vocabulary prints as `invalid`
  local value=$2
  [[ $value =~ ^[a-z0-9_.:-]+$ ]] || value=invalid
  printf 'E3J9 %s=%s\n' "$1" "$value"
}

report() { # report <unexpected> <code>
  local match=false
  [ "$1" -eq 0 ] && [ "$2" -eq 0 ] && match=true
  emit owned_expected_set_match "$match"
  emit owned_unexpected_count "$1"
  emit owned_scan_code "$2"
  [ "$match" = true ]
  exit $?
}

[ "$(/usr/bin/id -u)" = 0 ] || exit 64

scan_mode=default
case "$#:${1-}" in
  0:) ;;
  1:expect-none) scan_mode=none ;;
  *) report 0 64 ;;
esac

svc_uid=$(/usr/bin/getent passwd eanhl-cloud | /usr/bin/cut -d: -f3)
svc_gid=$(/usr/bin/getent group eanhl-cloud | /usr/bin/cut -d: -f3)
if ! [[ $svc_uid =~ ^[0-9]+$ ]] || ! [[ $svc_gid =~ ^[0-9]+$ ]]; then
  report 0 2
fi

# Preconditions: a running process or unit (private /tmp, live state) would give
# false results. pgrep exits 1 for "none", 0 for "found", >1 on error; only 1
# passes. A systemctl failure is a precondition failure.
/usr/bin/pgrep -u "$svc_uid" >/dev/null 2>&1
[ "$?" -eq 1 ] || report 0 4
active=$(/usr/bin/systemctl list-units --all --plain --no-legend \
  --state=activating,active,deactivating,reloading 'eanhl-cloud-*' 2>/dev/null) || report 0 4
[ -z "$active" ] || report 0 4

readonly H=/var/lib/eanhl-cloud
readonly C=/var/cache/eanhl-cloud

# §2 objects that must exist, owned eanhl-cloud:eanhl-cloud, with this type
# and mode (default mode only).
readonly REQUIRED=(
  "d 700 $H"
  "d 700 $H/gnupg"
  "d 700 $H/password-store"
  "d 700 $H/config"
  "d 700 $H/data"
  "d 700 $H/locks"
  "f 600 $H/locks/credential.lock"
  "d 700 $C"
)

# Is <path> inside the expected set for owned objects? (expect-none: never.)
expected_path() {
  local p=$1
  [ "$scan_mode" = none ] && return 1
  case "$p" in
    "$H" | "$H/gnupg" | "$H/password-store" | "$H/config" | "$H/data" | "$H/locks" | "$C") return 0 ;;
    "$H/locks/credential.lock") return 0 ;;
    "$H/gnupg/"*) return 0 ;;
    "$H/config/"* | "$H/data/"* | "$C/"*) return 0 ;;
    "$H/password-store/.gpg-id") return 0 ;;
    "$H/password-store/ch.proton.drive" | "$H/password-store/ch.proton.drive/drive-sdk-cli") return 0 ;;
    "$H/password-store/ch.proton.drive/drive-sdk-cli/auth-session.gpg") return 0 ;;
    "$H/.local" | "$H/.local/state" | "$H/.local/state/proton-drive-cli") return 0 ;;
    "$H/.local/state/proton-drive-cli/proton-drive.log"*)
      case "${p#"$H/.local/state/proton-drive-cli/"}" in */*) return 1 ;; esac
      return 0
      ;;
  esac
  return 1
}

code=0
required=()
[ "$scan_mode" = none ] || required=("${REQUIRED[@]}")
for spec in "${required[@]}"; do
  read -r kind mode path <<<"$spec"
  meta=$(/usr/bin/stat -c '%F %a %u %g' -- "$path" 2>/dev/null) || {
    code=3
    continue
  }
  case "$kind:$meta" in
    "d:directory $mode $svc_uid $svc_gid") ;;
    "f:regular file $mode $svc_uid $svc_gid" | "f:regular empty file $mode $svc_uid $svc_gid") ;;
    *) code=3 ;;
  esac
done

# Filesystems holding the scan roots (deduplicated).
declare -A mounts=()
for root in / /var /var/tmp /opt /etc /usr/local /tmp /home /run /dev/shm; do
  m=$(/usr/bin/findmnt -n -o TARGET -T "$root" 2>/dev/null) || {
    [ "$code" -eq 0 ] && code=1
    continue
  }
  mounts["$m"]=1
done

unexpected=0
for m in "${!mounts[@]}"; do
  # The last record carries find's own exit status.
  found=()
  mapfile -d '' -t found < <(
    /usr/bin/find "$m" -xdev \( -uid "$svc_uid" -o -gid "$svc_gid" \) -print0 2>/dev/null
    printf '%s\0' "e3j9-find-rc=$?"
  )
  if [ "${found[-1]-}" != "e3j9-find-rc=0" ] && [ "$code" -eq 0 ]; then
    code=1
  fi
  unset 'found[-1]'
  for p in "${found[@]}"; do
    expected_path "$p" || unexpected=$((unexpected + 1))
  done
  # Required and expected objects must carry BOTH the uid and the gid.
  for p in "${found[@]}"; do
    if expected_path "$p"; then
      [ "$(/usr/bin/stat -c '%u:%g' -- "$p" 2>/dev/null)" = "$svc_uid:$svc_gid" ] || unexpected=$((unexpected + 1))
    fi
  done
done

report "$unexpected" "$code"
