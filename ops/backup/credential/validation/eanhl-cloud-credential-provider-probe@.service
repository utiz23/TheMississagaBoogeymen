# /etc/systemd/system/eanhl-cloud-credential-provider-probe@.service — E3J9
# validation only (design §8, §11). PROVIDER modes only: every instance
# executes the Proton CLI and can contact Proton.
#
# Install root:root 0644, then `systemctl daemon-reload` — ONLY in E3J9D/E3J9E,
# each under its own authorization (P0–P5, and the E3J9E boot timer). It is
# NOT installed in E3J9C. Never enabled: there is deliberately no [Install]
# section. Removed from the host after E3J9E (D8).
#
# Local modes have no unit file: they run only through
# `eanhl-cloud-credential probe <mode>` (PrivateNetwork transient units whose
# probe argument is always `local:<mode>`). This unit always passes
# `provider:%i`, and the probe accepts only its closed provider set.
#
# The credential command's initial environment comes only from the wrapper's
# literals: no Environment= and no EnvironmentFile=, by design (§7, §8). There
# is no StateDirectory=/CacheDirectory=: M3 creates the directories, and a
# missing one fails unit setup instead of being created or re-owned.
#
# Output handling: there is deliberately NO operator recipe here for reading
# this unit's journal. Provider runs can emit CLI-derived text, and a raw
# journal read could print it. Before this template is installed or started,
# E3J9D/E3J9E must supply — and have separately reviewed — an invocation-bound,
# vocabulary-filtered reader equivalent to the launcher's `probe` operation
# (fresh unit, bound InvocationID, only that invocation's records, vocabulary
# lines only, other lines counted never printed, cleanup part of the result).
# Until then it stays uninstalled and unexecuted.

[Unit]
Description=EANHL cloud credential PROVIDER probe (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300
User=eanhl-cloud
Group=eanhl-cloud
ExecStart=/usr/local/lib/eanhl-cloud/credential-exec --nonblock probe provider:%i
WorkingDirectory=/var/lib/eanhl-cloud
UMask=0077
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/eanhl-cloud /var/cache/eanhl-cloud
NoNewPrivileges=yes
StandardInput=null
StandardOutput=journal
StandardError=journal
KillMode=control-group
