#!/usr/bin/perl -T
# /usr/local/lib/eanhl-cloud/validation/unit-publish — E3J9 validation only
# (design §20, E3J9D-R). Install root:root 0755. Removed from the host after
# E3J9E (D8). Non-secret.
#
# Publishes, removes and syncs the ONE persistent unit pair that the
# launcher's `provider-probe schedule boot` needs: <stem>.service and
# <stem>.timer in /etc/systemd/system, where <stem> is
# eanhl-cloud-cred-pprobe-boot-provider-<32 lowercase hex>. Only the launcher
# /usr/local/sbin/eanhl-cloud-credential invokes it, always as
#
#   /usr/bin/env -i /usr/bin/perl -T -- <this file> <op> [<stem>]
#
# (env -i and -T together neutralise PERL5OPT, PERL5LIB and PERLLIB). It runs
# no other program and uses only the core modules Fcntl, POSIX and IO::Handle.
#
#   publish-pair <stem>    the service bytes on fd 3, the timer bytes on fd 4
#   unpublish-pair <stem>  the EXPECTED service bytes on fd 3, timer bytes on fd 4
#   fsync-wants            fsync timers.target.wants after the launcher's enable
#
# Why a helper exists: the shell cannot create a file with O_EXCL|O_NOFOLLOW,
# fstat the descriptor it wrote, publish a name without replacing an existing
# one (`mv` is rename(2), which replaces), or fsync a directory with defined
# semantics on Hotel-Echo's mixed GNU/uutils userland.
#
# Rules (design §4.11):
#  - Trust: every directory of the fixed chain is a real directory (lstat, not
#    a symlink) owned root:root with no group or other write bit. The unit
#    directory is opened O_DIRECTORY|O_NOFOLLOW and its fstat identity must
#    equal the lstat identity.
#  - Publication: both destinations must be absent (a symlink, dangling or
#    not, counts as present). Each file is created under a fresh temporary
#    name with O_EXCL|O_NOFOLLOW, written in full, chowned 0:0 and chmodded
#    0644 through the descriptor, fsynced, and its identity (dev/ino, nlink 1,
#    owner, mode, size) rechecked by lstat. It is then published with link(2),
#    which never replaces an existing name; the temporary name is removed and
#    the directory is fsynced before success is reported.
#  - Rollback: only an object THIS call created is removed, and only when its
#    lstat identity equals the recorded one AND a no-follow re-read gives the
#    exact intended bytes. Anything else stays where it is (exit 71).
#  - Removal (unpublish): both files are proven (regular, not a symlink, 0:0,
#    0644, nlink 1, fstat identity = lstat identity, exact expected bytes)
#    BEFORE either is unlinked.
#  - Descriptors: Perl marks every descriptor above $^F close-on-exec itself
#    (O_CLOEXEC is not exported by Fcntl), and this helper executes nothing.
#
# Output: only lines matching ^E3J9 [a-z_]+=[a-z0-9_.:-]+$
#   unit_publish_result=ok|refused|failed
#   unit_publish_reason=<closed word>
#   unit_publish_rollback_complete=true|false   (after a failed publication)
# Exit: 0 ok · 64 usage · 65 refused, nothing changed · 70 failed and fully
# rolled back · 71 failed, rollback incomplete (unproven bytes left in place).
#
# Residual (documented, not closed): root can still change these root-only
# directories between a check and an unlink. The identity and byte rechecks
# narrow that window; they do not close it. That actor is outside the
# protection boundary.

use strict;
use warnings;
use Fcntl qw(O_RDONLY O_WRONLY O_CREAT O_EXCL O_NOFOLLOW O_DIRECTORY :mode);
use POSIX qw(EEXIST ENOENT);
use IO::Handle;

my $UNIT_DIR    = '/etc/systemd/system';
my $WANTS_DIR   = '/etc/systemd/system/timers.target.wants';
my @TRUST_CHAIN = ('/', '/etc', '/etc/systemd', '/etc/systemd/system');
my $OWNER_UID   = 0;
my $OWNER_GID   = 0;
my $URANDOM     = '/dev/urandom';
my $MAX_PAYLOAD = 8192;
my $STEM_RE     = qr/\A(eanhl-cloud-cred-pprobe-boot-provider-[0-9a-f]{32})\z/;

# Objects this call created: { path, dev, ino, bytes, removed }.
my @CREATED;

sub emit {
    my ($name, $value) = @_;
    $value = 'invalid' unless defined $value && $value =~ /\A[a-z0-9_.:-]+\z/;
    print "E3J9 $name=$value\n";
    return;
}

sub finish {
    my ($result, $reason, $code, $rollback) = @_;
    emit('unit_publish_result', $result);
    emit('unit_publish_reason', $reason);
    emit('unit_publish_rollback_complete', $rollback) if defined $rollback;
    exit $code;
}

sub refused { finish('refused', $_[0], 65); return; }

sub dir_trusted {
    my ($path) = @_;
    my @st = lstat($path);
    return 0 unless @st;
    return 0 if S_ISLNK($st[2]) || !S_ISDIR($st[2]);
    return 0 unless $st[4] == $OWNER_UID && $st[5] == $OWNER_GID;
    return 0 if S_IMODE($st[2]) & 022;
    return 1;
}

sub chain_trusted {
    for my $dir (@TRUST_CHAIN, @_) {
        return 0 unless dir_trusted($dir);
    }
    return 1;
}

# A directory handle whose fstat identity equals the path's lstat identity.
sub open_dir {
    my ($path) = @_;
    my @l = lstat($path);
    return unless @l;
    sysopen(my $dh, $path, O_RDONLY | O_DIRECTORY | O_NOFOLLOW) or return;
    my @f = stat($dh);
    return unless @f && $f[0] == $l[0] && $f[1] == $l[1];
    return $dh;
}

# The complete content of an inherited descriptor: at most $MAX_PAYLOAD bytes,
# non-empty, no NUL.
sub read_input {
    my ($fd) = @_;
    open(my $in, '<&=', $fd) or return;
    binmode($in);
    my $buf = '';
    while (1) {
        my $n = sysread($in, my $chunk, 4096);
        return unless defined $n;
        last if $n == 0;
        $buf .= $chunk;
        return if length($buf) > $MAX_PAYLOAD;
    }
    return if $buf eq '' || index($buf, "\0") >= 0;
    return $buf;
}

sub rand_hex {
    sysopen(my $r, $URANDOM, O_RDONLY) or return;
    my $n = sysread($r, my $raw, 8);
    return unless defined $n && $n == 8;
    my ($hex) = unpack('H*', $raw) =~ /\A([0-9a-f]{16})\z/;
    return $hex;
}

# The complete content of <path>, opened without following a symlink, only if
# the opened object is the one identified by <dev>/<ino>.
sub read_exact_no_follow {
    my ($path, $dev, $ino) = @_;
    sysopen(my $fh, $path, O_RDONLY | O_NOFOLLOW) or return;
    my @f = stat($fh);
    return unless @f && $f[0] == $dev && $f[1] == $ino;
    my $buf = '';
    while (1) {
        my $n = sysread($fh, my $chunk, 4096);
        return unless defined $n;
        last if $n == 0;
        $buf .= $chunk;
        return if length($buf) > $MAX_PAYLOAD;
    }
    return $buf;
}

# Remove one object this call created, only when its identity and its bytes
# are proven. An object already gone counts as removed.
sub remove_proven {
    my ($rec) = @_;
    return 1 if $rec->{removed};
    my @l = lstat($rec->{path});
    unless (@l) {
        return 0 unless ($! + 0) == ENOENT;
        $rec->{removed} = 1;
        return 1;
    }
    return 0 unless defined $rec->{dev} && S_ISREG($l[2]) && $l[0] == $rec->{dev} && $l[1] == $rec->{ino};
    # TEST-POINT after_lstat $rec->{path}
    my $have = read_exact_no_follow($rec->{path}, $l[0], $l[1]);
    return 0 unless defined $have && $have eq $rec->{bytes};
    unlink($rec->{path}) or return 0;
    return 0 if lstat($rec->{path});
    $rec->{removed} = 1;
    return 1;
}

sub rollback {
    # TEST-POINT rollback
    my $complete = 1;
    for my $rec (reverse @CREATED) {
        $complete = 0 unless remove_proven($rec);
    }
    my $dh = open_dir($UNIT_DIR);
    $complete = 0 unless $dh && $dh->sync;
    return $complete;
}

sub failed_rollback {
    my ($why) = @_;
    my $complete = rollback();
    finish('failed', $why, $complete ? 70 : 71, $complete ? 'true' : 'false');
    return;
}

# Create, fill, fsync and verify one temporary file. Returns its record.
sub create_temp {
    my ($stem, $suffix, $bytes) = @_;
    my $hex = rand_hex();
    return unless defined $hex;
    my $tmp = "$UNIT_DIR/.$stem.$suffix.$hex.tmp";
    sysopen(my $fh, $tmp, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) or return;
    my @f = stat($fh);
    my $rec = { path => $tmp, dev => $f[0], ino => $f[1], bytes => $bytes };
    push @CREATED, $rec;
    return unless @f;
    my $off = 0;
    while ($off < length $bytes) {
        my $w = syswrite($fh, $bytes, length($bytes) - $off, $off);
        return unless defined $w && $w > 0;
        $off += $w;
    }
    chown($OWNER_UID, $OWNER_GID, $fh) or return;
    chmod(0644, $fh) or return;
    $fh->sync or return;
    @f = stat($fh);
    return unless @f && $f[0] == $rec->{dev} && $f[1] == $rec->{ino} && $f[7] == length $bytes;
    close($fh) or return;
    my @l = lstat($tmp);
    return unless @l && S_ISREG($l[2]) && $l[0] == $rec->{dev} && $l[1] == $rec->{ino} && $l[3] == 1;
    return unless $l[4] == $OWNER_UID && $l[5] == $OWNER_GID && S_IMODE($l[2]) == 0644 && $l[7] == length $bytes;
    return $rec;
}

# Publish one verified temporary file under its final name without ever
# replacing an existing name. Returns undef on success, else a reason.
sub publish_one {
    my ($rec, $final) = @_;
    # TEST-POINT before_link $final
    unless (link($rec->{path}, $final)) {
        return (($! + 0) == EEXIST) ? 'dest_exists' : 'link_failed';
    }
    push @CREATED, { path => $final, dev => $rec->{dev}, ino => $rec->{ino}, bytes => $rec->{bytes} };
    my @l = lstat($final);
    return 'identity_mismatch' unless @l && S_ISREG($l[2]) && $l[0] == $rec->{dev} && $l[1] == $rec->{ino} && $l[3] == 2;
    remove_proven($rec) or return 'temp_remove_failed';
    @l = lstat($final);
    return 'identity_mismatch' unless @l && $l[0] == $rec->{dev} && $l[1] == $rec->{ino} && $l[3] == 1;
    return;
}

sub op_publish {
    my ($stem) = @_;
    my $svc = read_input(3);
    my $tmr = read_input(4);
    refused('input_invalid') unless defined $svc && defined $tmr;
    refused('untrusted_directory') unless chain_trusted();
    my $dh = open_dir($UNIT_DIR);
    refused('untrusted_directory') unless $dh;
    my @pair = (['service', $svc], ['timer', $tmr]);
    for my $p (@pair) {
        my $final = "$UNIT_DIR/$stem.$p->[0]";
        refused('dest_exists') if lstat($final);
        refused('dest_unproven') unless ($! + 0) == ENOENT;
    }
    for my $p (@pair) {
        my ($suffix, $bytes) = @$p;
        my $rec = create_temp($stem, $suffix, $bytes);
        failed_rollback('temp_create_failed') unless $rec;
        my $why = publish_one($rec, "$UNIT_DIR/$stem.$suffix");
        failed_rollback($why) if defined $why;
    }
    $dh->sync or failed_rollback('dir_sync_failed');
    finish('ok', 'published', 0);
    return;
}

# The identity of a regular 0:0 0644 single-link file holding exactly <want>.
sub prove_file {
    my ($path, $want) = @_;
    my @l = lstat($path);
    return unless @l && S_ISREG($l[2]) && $l[3] == 1;
    return unless $l[4] == $OWNER_UID && $l[5] == $OWNER_GID && S_IMODE($l[2]) == 0644;
    # TEST-POINT after_lstat $path
    my $have = read_exact_no_follow($path, $l[0], $l[1]);
    return unless defined $have && $have eq $want;
    return [$l[0], $l[1]];
}

sub op_unpublish {
    my ($stem) = @_;
    my $svc = read_input(3);
    my $tmr = read_input(4);
    refused('input_invalid') unless defined $svc && defined $tmr;
    refused('untrusted_directory') unless chain_trusted();
    my $dh = open_dir($UNIT_DIR);
    refused('untrusted_directory') unless $dh;
    my %want = (service => $svc, timer => $tmr);
    my %id;
    for my $suffix (qw(service timer)) { # prove both before removing either
        $id{$suffix} = prove_file("$UNIT_DIR/$stem.$suffix", $want{$suffix});
        refused('unproven_bytes') unless $id{$suffix};
    }
    my $complete = 1;
    for my $suffix (sort keys %id) {
        my $path = "$UNIT_DIR/$stem.$suffix";
        my @l = lstat($path);
        if (@l && $l[0] == $id{$suffix}[0] && $l[1] == $id{$suffix}[1]) {
            unlink($path) or $complete = 0;
        } else {
            $complete = 0;
        }
        $complete = 0 if lstat($path);
    }
    $dh->sync or $complete = 0;
    finish('ok', 'unpublished', 0) if $complete;
    finish('failed', 'unlink_failed', 71, 'false');
    return;
}

sub op_fsync_wants {
    refused('untrusted_directory') unless chain_trusted($WANTS_DIR);
    my $dh = open_dir($WANTS_DIR);
    refused('untrusted_directory') unless $dh;
    $dh->sync or finish('failed', 'dir_sync_failed', 70, 'true');
    finish('ok', 'synced', 0);
    return;
}

my $op = defined $ARGV[0] ? $ARGV[0] : '';
if (($op eq 'publish-pair' || $op eq 'unpublish-pair') && @ARGV == 2) {
    my ($stem) = $ARGV[1] =~ $STEM_RE;
    finish('refused', 'usage', 64) unless defined $stem;
    op_publish($stem) if $op eq 'publish-pair';
    op_unpublish($stem);
} elsif ($op eq 'fsync-wants' && @ARGV == 1) {
    op_fsync_wants();
}
finish('refused', 'usage', 64);
