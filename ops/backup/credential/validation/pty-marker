#!/usr/bin/bash -p
# /usr/local/lib/eanhl-cloud/validation/pty-marker <nonce> — E3J9 validation
# only (design §11, A6). Install root:root 0755. Removed after E3J9E (D8).
#
# Started through the wrapper by `eanhl-cloud-credential pty-marker` in a
# `systemd-run --pty` unit. The wrapper hands the launcher's nonce over as the
# single positional argument (never as an environment value). The nonce is
# written to stdout and to stderr; both must reach the operator's PTY and
# neither may reach the journal (the launcher then counts journal hits). The
# nonce is not secret: it also appears in this process's argv (visible to ps);
# its only role is detecting journal absence.
set -u
nonce=${1-}
[[ $nonce =~ ^[0-9a-f]{32}$ ]] || exit 64
[ "$#" -eq 1 ] || exit 64
printf 'E3J9 pty_marker_stdout=%s\n' "$nonce"
printf 'E3J9 pty_marker_stderr=%s\n' "$nonce" >&2
