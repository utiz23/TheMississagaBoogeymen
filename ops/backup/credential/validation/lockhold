#!/usr/bin/bash -p
# /usr/local/lib/eanhl-cloud/validation/lockhold — E3J9 validation only
# (design §4, §11: K1–K6, A8). Install root:root 0755. Removed after E3J9E (D8).
#
# As eanhl-cloud (inside a credential unit, under the wrapper's lock; reached
# only through the probe's lockhold-*/busy-* modes, which print probe_mode):
#   hold <1-600>      run the probe's nested canary, then hold the foreground
#                     for N s; prints the single probe_result line
#   detach            leave a detached `setsid` descendant (sleep 300); prints
#                     probe_result=pass
#   busy              reached only if a lock that should be busy was acquired:
#                     prints unexpected_acquire=true, probe_result=fail, exits 1
# As root (never inside a credential unit):
#   held              is the credential lock currently held? (/proc/locks,
#                     matched on device and inode; a query: exit 0 either way)
#   free              nonblocking acquire + immediate release (A8, K2, K3, K5);
#                     exits non-zero unless the lock is free
#   fdcheck <unit>    processes of <unit>'s cgroup: count, gpg-agent count,
#                     detached-descendant count, and how many hold an open
#                     descriptor on the lock file; then `free`. Exits non-zero
#                     unless no process holds the lock and it is free
#
# Root never opens the lock path: it lives in an eanhl-cloud-owned directory,
# so a symlink could redirect a root open. `free` refuses a symlink or
# non-regular file and then acquires AS eanhl-cloud through setpriv.
#
# Output: only lines matching ^E3J9 [a-z_]+=[a-z0-9_.:-]+$.

set -u
readonly LOCK_FILE=/var/lib/eanhl-cloud/locks/credential.lock
readonly PROBE=/usr/local/lib/eanhl-cloud/validation/eanhl-cloud-credential-probe.sh
readonly SETPRIV=/usr/bin/setpriv
readonly FLOCK=/usr/bin/flock

emit() { # emit <name> <value>; a value outside the vocabulary prints as `invalid`
  local value=$2
  [[ $value =~ ^[a-z0-9_.:-]+$ ]] || value=invalid
  printf 'E3J9 %s=%s\n' "$1" "$value"
}
require_svc() { [ "$(/usr/bin/id -un)" = eanhl-cloud ] || exit 64; }
require_root() { [ "$(/usr/bin/id -u)" = 0 ] || exit 64; }

# /proc/locks prints "<major>:<minor>:<inode>" with major/minor as %02x.
lock_held() {
  local dev ino major minor
  [ -L "$LOCK_FILE" ] && return 2
  dev=$(/usr/bin/stat -c %d -- "$LOCK_FILE") || return 2
  ino=$(/usr/bin/stat -c %i -- "$LOCK_FILE") || return 2
  major=$(((dev >> 8) & 0xfff))
  minor=$(((dev & 0xff) | ((dev >> 12) & 0xfff00)))
  /usr/bin/grep -q -E "FLOCK +ADVISORY +WRITE +[0-9]+ +$(printf '%02x:%02x' "$major" "$minor"):${ino} " /proc/locks
}

# Nonblocking exclusive acquire and immediate release, as eanhl-cloud. The file
# is never created (checked first) and never opened by root.
lock_free() {
  [ -L "$LOCK_FILE" ] && return 2
  [ -f "$LOCK_FILE" ] || return 2
  "$SETPRIV" --reuid=eanhl-cloud --regid=eanhl-cloud --clear-groups -- \
    "$FLOCK" --nonblock --exclusive --conflict-exit-code 75 "$LOCK_FILE" /usr/bin/true
}

tf_rc() { if [ "$1" -eq 0 ]; then printf true; else printf false; fi; }

mode=${1-}
case "$mode" in
  hold)
    require_svc
    secs=${2-}
    [[ $secs =~ ^[1-9][0-9]{0,2}$ ]] && [ "$secs" -le 600 ] || exit 64
    "$PROBE" local:canary-nested
    rc=$?
    emit lockhold_hold_seconds "$secs"
    /usr/bin/sleep "$secs"
    emit lockhold_hold_done true
    if [ "$rc" -eq 0 ]; then emit probe_result pass; else emit probe_result fail; fi
    exit "$rc"
    ;;
  detach)
    require_svc
    /usr/bin/setsid -f /usr/bin/sleep 300 </dev/null >/dev/null 2>&1
    emit lockhold_detached true
    emit probe_result pass
    exit 0
    ;;
  busy)
    emit unexpected_acquire true
    emit probe_result fail
    exit 1
    ;;
  held)
    require_root
    lock_held
    emit lock_held "$(tf_rc $?)"
    ;;
  free)
    require_root
    lock_free
    rc=$?
    emit lock_free_nonblock "$(tf_rc "$rc")"
    [ "$rc" -eq 0 ] || exit 1
    ;;
  fdcheck)
    require_root
    unit=${2-}
    [[ $unit =~ ^eanhl-cloud-[a-z0-9-]+(@[a-z0-9-]+)?\.service$ ]] || exit 64
    cg=$(/usr/bin/systemctl show -p ControlGroup --value -- "$unit" 2>/dev/null)
    procs=0 agents=0 sleepers=0 holders=0
    if [ -n "$cg" ] && [ -d "/sys/fs/cgroup$cg" ]; then
      while IFS= read -r -d '' procs_file; do
        mapfile -t pids <"$procs_file" 2>/dev/null || continue
        for pid in "${pids[@]}"; do
          comm=$(/usr/bin/cat "/proc/$pid/comm" 2>/dev/null) || continue
          procs=$((procs + 1))
          [ "$comm" = gpg-agent ] && agents=$((agents + 1))
          [ "$comm" = sleep ] && sleepers=$((sleepers + 1))
          for fd_link in "/proc/$pid/fd/"*; do
            if [ "$(/usr/bin/readlink -- "$fd_link" 2>/dev/null)" = "$LOCK_FILE" ]; then
              holders=$((holders + 1))
              break
            fi
          done
        done
      done < <(/usr/bin/find "/sys/fs/cgroup$cg" -name cgroup.procs -print0 2>/dev/null)
    else
      emit unit_cgroup_found false
    fi
    emit unit_proc_count "$procs"
    emit unit_agent_count "$agents"
    emit unit_descendant_count "$sleepers"
    emit lock_fd_holder_count "$holders"
    lock_free
    rc=$?
    emit lock_free_nonblock "$(tf_rc "$rc")"
    # Exit 0 only if nothing in the unit holds the lock and it is free (K2/K3/K5).
    [ "$rc" -eq 0 ] && [ "$holders" -eq 0 ] || exit 1
    ;;
  *) exit 64 ;;
esac
