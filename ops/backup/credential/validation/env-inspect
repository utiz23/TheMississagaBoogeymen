#!/usr/bin/bash -p
# /usr/local/lib/eanhl-cloud/validation/env-inspect — E3J9 validation only
# (design §7, §11: E1, E2, E3 and the supplementary /proc observation).
# Install root:root 0755. Removed from the host after E3J9E (D8).
#
# Modes:
#   boundary             as eanhl-cloud, exec'd DIRECTLY by the wrapper's
#                        `env -i`: analyses its own exec-time environment
#                        (E1(b)) and the NAMES present in its parent's (the
#                        flock parent's, i.e. the wrapper's) environment (E2).
#   descendant           as eanhl-cloud, started by a bash descendant (the
#                        probe): analyses its own environment against the §7
#                        permitted union (E2 helper child). Prefix `helper_`.
#   stdin-boundary       as eanhl-cloud: analyses a NUL-separated environment
#   stdin-descendant     read from stdin (the probe passes its own).
#   observe <unit> <s>   as root: SUPPLEMENTARY observation of live pass/GPG
#                        processes in <unit>'s cgroup for up to <s> seconds.
#
# Output: only lines matching ^E3J9 [a-z_]+=[a-z0-9_.:-]+$ — booleans, counts
# and fixed words. No environment name or value is ever printed.

# Read the exec-time environment before doing anything else (E1(b)).
mapfile -d '' -t SELF_ENV </proc/self/environ
set -u

# Must equal ops/backup/credential/credential-child-env.manifest.
readonly CREDENTIAL_ENV=(
  PATH=/opt/eanhl-cloud/credential-bin
  HOME=/var/lib/eanhl-cloud
  XDG_CONFIG_HOME=/var/lib/eanhl-cloud/config
  XDG_DATA_HOME=/var/lib/eanhl-cloud/data
  XDG_CACHE_HOME=/var/cache/eanhl-cloud
  GNUPGHOME=/var/lib/eanhl-cloud/gnupg
  PASSWORD_STORE_DIR=/var/lib/eanhl-cloud/password-store
  LANG=C.UTF-8
  LC_ALL=C.UTF-8
  TMPDIR=/tmp
  PROTON_DRIVE_CREDENTIALS_STORE=pass
  PROTON_DRIVE_LOG_LEVEL=ERROR
)
readonly WORKDIR=/var/lib/eanhl-cloud
readonly GIT_CEILING_EXPECTED=/var/lib/eanhl-cloud/password-store/..
readonly NONCE_MARK=e3j9nonce
readonly RUNTIME_NAMES=(PWD SHLVL _ OLDPWD)
readonly SYSTEMD_NAMES=(
  INVOCATION_ID SYSTEMD_EXEC_PID JOURNAL_STREAM NOTIFY_SOCKET MANAGERPID
  MAINPID WATCHDOG_PID WATCHDOG_USEC STATE_DIRECTORY CACHE_DIRECTORY
  RUNTIME_DIRECTORY LOGS_DIRECTORY CONFIGURATION_DIRECTORY CREDENTIALS_DIRECTORY
  MEMORY_PRESSURE_WATCH MEMORY_PRESSURE_WRITE USER LOGNAME SHELL
)
readonly FORBIDDEN_NAMES=(
  E3J9_INJECTED E3J9_PTY_NONCE
  PASSWORD_STORE_GPG_OPTS PASSWORD_STORE_KEY PASSWORD_STORE_UMASK
  PASSWORD_STORE_SIGNING_KEY PASSWORD_STORE_ENABLE_EXTENSIONS
  PASSWORD_STORE_EXTENSIONS_DIR
  PROTON_DRIVE_BASE_URL PROTON_DRIVE_CACHE_DIR PROTON_DRIVE_UNSAFE_CACHE
  TERM DISPLAY WAYLAND_DISPLAY BROWSER SSH_ASKPASS GIT_ASKPASS
  DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR XDG_STATE_HOME GPG_AGENT_INFO LC_CTYPE
  LD_PRELOAD LD_LIBRARY_PATH NODE_OPTIONS
)

declare -A LITERAL_BY_NAME=()
for entry in "${CREDENTIAL_ENV[@]}"; do
  LITERAL_BY_NAME["${entry%%=*}"]=${entry#*=}
done
unset entry

emit() { # emit <name> <value>; a value outside the vocabulary prints as `invalid`
  local value=$2
  [[ $value =~ ^[a-z0-9_.:-]+$ ]] || value=invalid
  printf 'E3J9 %s=%s\n' "$1" "$value"
}
tf() { if [ "$1" -eq 0 ]; then printf true; else printf false; fi; }

in_list() { # in_list <word> <list...>
  local word=$1 item
  shift
  for item in "$@"; do
    [ "$item" = "$word" ] && return 0
  done
  return 1
}

is_systemd_name() {
  case "$1" in LISTEN_*) return 0 ;; esac
  in_list "$1" "${SYSTEMD_NAMES[@]}"
}

# Results of the last analyse_* call (globals, integers).
A_UNEXPECTED=0 A_WRONG=0 A_FORBIDDEN=0 A_NONCE=0 A_SYSTEMD=0 A_EXACT=1
A_PWD_PRESENT=0 A_PWD_OK=1 A_TTY_OK=1 A_GIT_OK=1 A_PASS_EXPORTS_SEEN=0

reset_results() {
  A_UNEXPECTED=0 A_WRONG=0 A_FORBIDDEN=0 A_NONCE=0 A_SYSTEMD=0 A_EXACT=1
  A_PWD_PRESENT=0 A_PWD_OK=1 A_TTY_OK=1 A_GIT_OK=1 A_PASS_EXPORTS_SEEN=0
}

common_markers() { # common_markers <name> <entry>
  local name=$1 entry=$2
  case "$entry" in *"$NONCE_MARK"*) A_NONCE=$((A_NONCE + 1)) ;; esac
  [ "$name" = E3J9_INJECTED ] && A_NONCE=$((A_NONCE + 1))
  if is_systemd_name "$name"; then A_SYSTEMD=$((A_SYSTEMD + 1)); fi
  if in_list "$name" "${FORBIDDEN_NAMES[@]}" || is_systemd_name "$name"; then
    A_FORBIDDEN=$((A_FORBIDDEN + 1))
  fi
}

# The initial exec environment must be exactly the twelve literals.
analyse_boundary() { # analyse_boundary <array-name>
  local -n env_ref=$1
  local entry name
  local -A remaining=()
  reset_results
  for entry in "${CREDENTIAL_ENV[@]}"; do remaining["$entry"]=1; done
  [ "${#env_ref[@]}" -eq "${#CREDENTIAL_ENV[@]}" ] || A_EXACT=0
  for entry in "${env_ref[@]}"; do
    name=${entry%%=*}
    common_markers "$name" "$entry"
    # At the boundary the two pass exports are not yet legitimate.
    case "$name" in GPG_TTY | GIT_CEILING_DIRECTORIES) A_FORBIDDEN=$((A_FORBIDDEN + 1)) ;; esac
    if [ -z "${LITERAL_BY_NAME[$name]+set}" ]; then
      A_UNEXPECTED=$((A_UNEXPECTED + 1))
    fi
    if [ -n "${remaining[$entry]+set}" ]; then
      unset "remaining[$entry]"
    else
      A_EXACT=0
    fi
  done
  [ "${#remaining[@]}" -eq 0 ] || A_EXACT=0
}

# A descendant may carry the twelve (unchanged), bash runtime names and the two
# pass-generated exports with their fixed expected values (§7).
analyse_descendant() { # analyse_descendant <array-name>
  local -n env_ref=$1
  local entry name value
  local -A seen=()
  reset_results
  for entry in "${env_ref[@]}"; do
    name=${entry%%=*}
    value=${entry#*=}
    common_markers "$name" "$entry"
    if [ -n "${seen[$name]+set}" ]; then
      A_WRONG=$((A_WRONG + 1))
    fi
    seen["$name"]=1
    if [ -n "${LITERAL_BY_NAME[$name]+set}" ]; then
      [ "$value" = "${LITERAL_BY_NAME[$name]}" ] || A_WRONG=$((A_WRONG + 1))
    elif [ "$name" = PWD ]; then
      A_PWD_PRESENT=1
      [ "$value" = "$WORKDIR" ] || A_PWD_OK=0
    elif in_list "$name" "${RUNTIME_NAMES[@]}"; then
      :
    elif [ "$name" = GPG_TTY ]; then
      A_PASS_EXPORTS_SEEN=$((A_PASS_EXPORTS_SEEN + 1))
      [ -z "$value" ] || A_TTY_OK=0
    elif [ "$name" = GIT_CEILING_DIRECTORIES ]; then
      A_PASS_EXPORTS_SEEN=$((A_PASS_EXPORTS_SEEN + 1))
      [ "$value" = "$GIT_CEILING_EXPECTED" ] || A_GIT_OK=0
    else
      A_UNEXPECTED=$((A_UNEXPECTED + 1))
    fi
  done
  for name in "${!LITERAL_BY_NAME[@]}"; do
    [ -n "${seen[$name]+set}" ] || A_WRONG=$((A_WRONG + 1))
  done
}

print_boundary() { # print_boundary <prefix>; returns 0 only if every check passed
  local p=$1 ok=0
  emit "${p}env_initial_exact" "$(tf $((1 - A_EXACT)))"
  emit "${p}env_unexpected_count" "$A_UNEXPECTED"
  emit "${p}env_forbidden_absent" "$(tf "$A_FORBIDDEN")"
  emit "${p}env_nonce_absent" "$(tf "$A_NONCE")"
  emit "${p}env_systemd_absent" "$(tf "$A_SYSTEMD")"
  [ "$A_EXACT" -eq 1 ] && [ "$A_UNEXPECTED" -eq 0 ] && [ "$A_FORBIDDEN" -eq 0 ] \
    && [ "$A_NONCE" -eq 0 ] && [ "$A_SYSTEMD" -eq 0 ] || ok=1
  return "$ok"
}

print_descendant() { # print_descendant <prefix> <require-pwd 0|1>
  local p=$1 require_pwd=$2 within=0 pwd_ok=0 ok=0
  [ "$A_UNEXPECTED" -eq 0 ] && [ "$A_WRONG" -eq 0 ] && [ "$A_TTY_OK" -eq 1 ] \
    && [ "$A_GIT_OK" -eq 1 ] && [ "$A_PWD_OK" -eq 1 ] && [ "$A_FORBIDDEN" -eq 0 ] || within=1
  if [ "$require_pwd" -eq 1 ] && [ "$A_PWD_PRESENT" -eq 0 ]; then pwd_ok=1; fi
  [ "$A_PWD_OK" -eq 1 ] || pwd_ok=1
  emit "${p}env_descendant_within_permitted" "$(tf "$within")"
  emit "${p}env_pwd_is_workdir" "$(tf "$pwd_ok")"
  emit "${p}env_unexpected_count" "$A_UNEXPECTED"
  emit "${p}env_wrong_value_count" "$A_WRONG"
  emit "${p}env_forbidden_absent" "$(tf "$A_FORBIDDEN")"
  emit "${p}env_nonce_absent" "$(tf "$A_NONCE")"
  emit "${p}env_systemd_absent" "$(tf "$A_SYSTEMD")"
  [ "$within" -eq 0 ] && [ "$pwd_ok" -eq 0 ] && [ "$A_NONCE" -eq 0 ] && [ "$A_SYSTEMD" -eq 0 ] || ok=1
  return "$ok"
}

require_svc() { [ "$(/usr/bin/id -un)" = eanhl-cloud ] || exit 64; }

mode_boundary() {
  require_svc
  local rc=0 parent_names=() entry has_inv=1 has_js=1 readable=1 parent_is_flock=1
  analyse_boundary SELF_ENV
  print_boundary "" || rc=1
  # Wrapper side (E2): the flock parent kept the wrapper's environment across exec.
  if [ "$(/usr/bin/cat "/proc/$PPID/comm" 2>/dev/null)" = flock ]; then parent_is_flock=0; fi
  if mapfile -d '' -t parent_names <"/proc/$PPID/environ" 2>/dev/null && [ "${#parent_names[@]}" -gt 0 ]; then
    readable=0
    for entry in "${parent_names[@]}"; do
      case "${entry%%=*}" in
        INVOCATION_ID) has_inv=0 ;;
        JOURNAL_STREAM) has_js=0 ;;
      esac
    done
  fi
  unset parent_names
  emit wrapper_parent_is_flock "$(tf "$parent_is_flock")"
  emit wrapper_env_readable "$(tf "$readable")"
  emit wrapper_has_invocation_id "$(tf "$has_inv")"
  emit wrapper_has_journal_stream "$(tf "$has_js")"
  [ "$parent_is_flock" -eq 0 ] && [ "$readable" -eq 0 ] && [ "$has_inv" -eq 0 ] && [ "$has_js" -eq 0 ] || rc=1
  return "$rc"
}

mode_descendant() {
  require_svc
  analyse_descendant SELF_ENV
  print_descendant helper_ 1
}

mode_stdin() { # mode_stdin boundary|descendant
  require_svc
  local given=()
  mapfile -d '' -t given
  if [ "$1" = boundary ]; then
    analyse_boundary given
    print_boundary ""
  else
    analyse_descendant given
    print_descendant "" 0
  fi
}

# SUPPLEMENTARY only (§11): a miss (`not_observed`) proves nothing either way.
mode_observe() { # mode_observe <unit> <seconds>
  [ "$(/usr/bin/id -u)" = 0 ] || exit 64
  local unit=${1-} secs=${2-}
  [[ $unit =~ ^eanhl-cloud-[a-z0-9-]+(@[a-z0-9-]+)?\.service$ ]] || exit 64
  [[ $secs =~ ^[1-9][0-9]{0,2}$ ]] || exit 64
  local -A seen=()
  local observed=0 nonce_hits=0 forbidden=0 wrong=0 tty_bad=0 git_bad=0
  local end=$((SECONDS + secs)) cg procs_file pid comm started=0
  local pids=() penv=()
  while [ "$SECONDS" -lt "$end" ]; do
    cg=$(/usr/bin/systemctl show -p ControlGroup --value -- "$unit" 2>/dev/null)
    if [ -n "$cg" ] && [ -d "/sys/fs/cgroup$cg" ]; then
      started=1
      while IFS= read -r -d '' procs_file; do
        mapfile -t pids <"$procs_file" 2>/dev/null || continue
        for pid in "${pids[@]}"; do
          [ -n "${seen[$pid]+set}" ] && continue
          comm=$(/usr/bin/cat "/proc/$pid/comm" 2>/dev/null) || continue
          case "$comm" in pass | gpg | gpg-agent | keyboxd | scdaemon | dirmngr) ;; *) continue ;; esac
          mapfile -d '' -t penv <"/proc/$pid/environ" 2>/dev/null || continue
          [ "${#penv[@]}" -gt 0 ] || continue
          seen["$pid"]=1
          observed=$((observed + 1))
          analyse_descendant penv
          [ "$A_NONCE" -eq 0 ] || nonce_hits=$((nonce_hits + 1))
          [ "$A_UNEXPECTED" -eq 0 ] && [ "$A_FORBIDDEN" -eq 0 ] || forbidden=$((forbidden + 1))
          [ "$A_WRONG" -eq 0 ] && [ "$A_PWD_OK" -eq 1 ] || wrong=$((wrong + 1))
          [ "$A_TTY_OK" -eq 1 ] || tty_bad=$((tty_bad + 1))
          [ "$A_GIT_OK" -eq 1 ] || git_bad=$((git_bad + 1))
          penv=()
        done
      done < <(/usr/bin/find "/sys/fs/cgroup$cg" -name cgroup.procs -print0 2>/dev/null)
    elif [ "$started" -eq 1 ]; then
      break
    fi
    /usr/bin/sleep 0.05
  done
  if [ "$observed" -eq 0 ]; then
    emit proc_obs not_observed
    return 0
  fi
  emit proc_obs observed
  emit proc_observed_count "$observed"
  emit proc_nonce_hits "$nonce_hits"
  emit proc_forbidden_names "$forbidden"
  emit proc_wrong_values "$wrong"
  emit proc_gpg_tty_empty "$(tf "$tty_bad")"
  emit proc_git_ceiling_expected "$(tf "$git_bad")"
  [ "$nonce_hits" -eq 0 ] && [ "$forbidden" -eq 0 ] && [ "$wrong" -eq 0 ] \
    && [ "$tty_bad" -eq 0 ] && [ "$git_bad" -eq 0 ]
}

case "${1-}" in
  boundary) mode_boundary ;;
  descendant) mode_descendant ;;
  stdin-boundary) mode_stdin boundary ;;
  stdin-descendant) mode_stdin descendant ;;
  observe) mode_observe "${2-}" "${3-}" ;;
  *) exit 64 ;;
esac
