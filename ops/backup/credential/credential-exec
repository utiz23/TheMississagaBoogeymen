#!/usr/bin/bash -p
# /usr/local/lib/eanhl-cloud/credential-exec — E3J9 credential lock + environment
# wrapper (design §4, §7). Install root:root 0755. Non-secret.
#
# Usage (only as a unit's ExecStart=, running as eanhl-cloud):
#   credential-exec <lockmode> <command-id> [args...]
#     <lockmode>    --nonblock | --wait=<1-3600>
#     <command-id>  gpg | pass | proton-drive
#                   probe | env-inspect | lockhold | pty-marker  (validation
#                   only; refused unless the validation tool is installed)
#
# What it does:
#   1. refuses (exit 64) unless /usr/bin/id -un is eanhl-cloud;
#   2. maps the command id to one fixed absolute executable; unknown ids and
#      malformed lock modes exit 64;
#   3. refuses (exit 64) unless the lock file exists as a regular file and is
#      not a symlink, so flock never creates it (flock opens with O_CREAT);
#   4. execs command-form `/usr/bin/flock --exclusive --close <lockmode>
#      --conflict-exit-code 75 <lock> /usr/bin/env -i <twelve literals>
#      <absolute command> [args...]`.
#
# The twelve literals below are the credential command's ENTIRE initial
# environment. Nothing from this script's own environment is copied: each value
# is a fixed literal, never an expansion. They must equal
# ops/backup/credential/credential-child-env.manifest line for line.
#
# Boundary, stated precisely (design §7):
#   - `bash -p` disables Bash's own startup mechanisms: BASH_ENV/ENV sourcing,
#     function import from the environment, and SHELLOPTS, BASHOPTS, CDPATH
#     and GLOBIGNORE taken from the environment.
#   - It cannot neutralise the dynamic loader, which acts before Bash starts:
#     LD_* and similar variables in this script's environment would affect
#     bash, flock and /usr/bin/env itself. The supported claim ("no variable
#     from this environment reaches the credential command") assumes execution
#     by a root-authored system unit whose environment and the manager's hold
#     no untrusted loader variables. That is an assumption, not a test result.
#   - This wrapper is a consistency control for root-authored units. It is NOT
#     access control against code already running as eanhl-cloud, which can run
#     gpg, pass or the CLI directly with any environment.
#
# Exit 75 means lock busy or wait expired, but a wrapped command could also
# exit 75 itself. Evidence of "busy" is exit 75 AND no command output (K1, N3).
#
# Never add --no-fork (it is incompatible with --close). With --close the lock
# descriptor is closed in the forked child before exec, so no descendant ever
# holds it; the flock parent keeps it until the foreground command exits.
#
# The validation ids are inert once the validation tools are removed (D8). The
# E3J10 production revision of this wrapper drops them (its sha256 changes).

readonly LOCK_FILE=/var/lib/eanhl-cloud/locks/credential.lock
readonly VALIDATION_DIR=/usr/local/lib/eanhl-cloud/validation

if [ "$(/usr/bin/id -un)" != "eanhl-cloud" ]; then
  exit 64
fi
if [ "$#" -lt 2 ]; then
  exit 64
fi

lockmode=$1
command_id=$2
shift 2

case "$lockmode" in
  --nonblock) ;;
  --wait=[1-9] | --wait=[1-9][0-9] | --wait=[1-9][0-9][0-9] | --wait=[1-3][0-9][0-9][0-9])
    if [ "${lockmode#--wait=}" -gt 3600 ]; then
      exit 64
    fi
    ;;
  *) exit 64 ;;
esac

validation_only=0
case "$command_id" in
  gpg) command_path=/opt/eanhl-cloud/credential-bin/gpg ;;
  pass) command_path=/opt/eanhl-cloud/credential-bin/pass ;;
  proton-drive) command_path=/opt/eanhl-cloud/bin/proton-drive ;;
  probe) command_path=$VALIDATION_DIR/eanhl-cloud-credential-probe.sh validation_only=1 ;;
  env-inspect) command_path=$VALIDATION_DIR/env-inspect validation_only=1 ;;
  lockhold) command_path=$VALIDATION_DIR/lockhold validation_only=1 ;;
  pty-marker)
    command_path=$VALIDATION_DIR/pty-marker validation_only=1
    # Validation-only exception (design §11, A6): the launcher places a nonce in
    # this wrapper's environment via --setenv; it is handed to the scrubbed
    # child as its single positional argument, never as an environment value.
    # The nonce is not secret; it only detects journal absence.
    pty_nonce=${E3J9_PTY_NONCE-}
    case "$pty_nonce" in
      [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
      *) exit 64 ;;
    esac
    set -- "$pty_nonce"
    unset pty_nonce
    ;;
  *) exit 64 ;;
esac

if [ "$validation_only" -eq 1 ] && [ ! -x "$command_path" ]; then
  exit 64
fi

# The lock must pre-exist (M3). Same-identity replacement races are out of
# scope: the lock prevents accidental concurrency, not the identity itself.
if [ -L "$LOCK_FILE" ] || [ ! -f "$LOCK_FILE" ]; then
  exit 64
fi

exec /usr/bin/flock --exclusive --close "$lockmode" --conflict-exit-code 75 "$LOCK_FILE" \
  /usr/bin/env -i \
  PATH=/opt/eanhl-cloud/credential-bin \
  HOME=/var/lib/eanhl-cloud \
  XDG_CONFIG_HOME=/var/lib/eanhl-cloud/config \
  XDG_DATA_HOME=/var/lib/eanhl-cloud/data \
  XDG_CACHE_HOME=/var/cache/eanhl-cloud \
  GNUPGHOME=/var/lib/eanhl-cloud/gnupg \
  PASSWORD_STORE_DIR=/var/lib/eanhl-cloud/password-store \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  TMPDIR=/tmp \
  PROTON_DRIVE_CREDENTIALS_STORE=pass \
  PROTON_DRIVE_LOG_LEVEL=ERROR \
  "$command_path" "$@"
