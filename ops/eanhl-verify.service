# systemd --user service: nightly OCR verification (Tier 0 WS0.2).
#
# Runs the full verify harness (incl. the heavy reprocess E2E) as the catch-all
# that exercises the end-to-end path the advisory pre-push hook skips.
#
# Install (machine-local, one-time):
#   mkdir -p ~/.config/systemd/user
#   ln -sf "$PWD/ops/eanhl-verify.service" ~/.config/systemd/user/eanhl-verify.service
#   ln -sf "$PWD/ops/eanhl-verify.timer"   ~/.config/systemd/user/eanhl-verify.timer
#   systemctl --user daemon-reload
#   systemctl --user enable --now eanhl-verify.timer
#
# Edit WorkingDirectory below to the repo's absolute path on this machine.
#
# ENVIRONMENT — read this before changing EnvironmentFile.
# -------------------------------------------------------
# This unit loads a SEPARATE, operator-created verification env file. It must
# NEVER load the application `.env`: that file carries the production
# DATABASE_URL, and this unit runs suites that write.
#
#   file:  %h/.config/eanhl/verify.env       (chmod 600, owned by the user)
#   template: ops/verify.env.example
#   contents: TEST_DATABASE_URL + TEST_DB_CONTAINER + TEST_DB_COMPOSE_PROJECT
#             + TEST_DB_COMPOSE_SERVICE. No DATABASE_URL. See ops/README.md.
#
# The path has NO leading "-", so a missing verification env file fails the unit
# instead of silently starting a run with no isolation configuration. The
# harness would refuse anyway; failing here makes the cause obvious in the
# journal. `UnsetEnvironment=DATABASE_URL` is belt-and-braces against a
# DATABASE_URL inherited from the user manager's environment.

[Unit]
Description=EANHL OCR verification (nightly, full)
After=docker.service

[Service]
Type=oneshot
# --- EDIT THIS to the repo's absolute path on this machine ---
WorkingDirectory=%h/projects/eanhl-team-website
EnvironmentFile=%h/.config/eanhl/verify.env
UnsetEnvironment=DATABASE_URL
ExecStart=/usr/bin/env bash scripts/verify-ocr.sh --full
# Keep a bounded log; journal captures stdout/stderr.
StandardOutput=journal
StandardError=journal
