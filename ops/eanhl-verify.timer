# systemd --user timer: run eanhl-verify.service nightly (Tier 0 WS0.2).
#
# See eanhl-verify.service for the one-time install. After linking both units:
#   systemctl --user daemon-reload
#   systemctl --user enable --now eanhl-verify.timer
#   systemctl --user list-timers eanhl-verify.timer   # confirm next run
#
# Requires lingering so it runs while logged out:
#   loginctl enable-linger "$USER"

[Unit]
Description=Nightly EANHL OCR verification

[Timer]
# 03:30 local time daily, with catch-up if the machine was asleep.
OnCalendar=*-*-* 03:30:00
Persistent=true
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
