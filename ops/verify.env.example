# Template for the VERIFICATION environment file.
#
# Copy to ~/.config/eanhl/verify.env, fill it in, and chmod 600 it:
#
#   mkdir -p ~/.config/eanhl
#   cp ops/verify.env.example ~/.config/eanhl/verify.env
#   chmod 600 ~/.config/eanhl/verify.env
#   $EDITOR ~/.config/eanhl/verify.env
#
# RULES (enforced by apps/worker/scripts/lib/test-db-guard.mjs, not by trust):
#   * This file is NOT the application .env, and must never be merged into it.
#     Nothing in the verification path reads the application .env.
#   * Do NOT put DATABASE_URL in here. The harness never reads DATABASE_URL as a
#     source; it sets it for its own children, pointing at a disposable clone.
#   * TEST_DATABASE_URL must address a loopback port of the dedicated
#     verification cluster (docker-compose.test.yml), and its database must be
#     inside the approved namespace: eanhl_test / eanhl_dev / eanhl_ci /
#     eanhl_scratch (never `eanhl`, `postgres`, `template0`, `template1`).
#   * The container/project identity must name itself nonproduction (one of:
#     test, tests, dev, ci, scratch, verify) and must contain no production
#     marker (prod, production, live, prd, release, main, master, primary,
#     public). The container must also carry eanhl.nonproduction="true".
#   * A loopback address is not proof: before any CREATE/DROP DATABASE the
#     harness compares the cluster system_identifier seen over
#     TEST_DATABASE_URL against the one seen through `docker exec`, and refuses
#     on any mismatch. That is what an SSH tunnel cannot forge.

# The verification cluster's DSN. The role must be able to execute
# pg_control_system() (the compose superuser satisfies this).
TEST_DATABASE_URL=postgresql://eanhl_test:CHANGE_ME@127.0.0.1:5434/eanhl_test

# Destructive-target identity. All three are mandatory; none has a default.
# These are the values produced by docker-compose.test.yml as shipped.
TEST_DB_CONTAINER=eanhl-verify-test-db-test-1
TEST_DB_COMPOSE_PROJECT=eanhl-verify-test
TEST_DB_COMPOSE_SERVICE=db-test

# Consumed by docker-compose.test.yml when bringing the cluster up. Keep the
# password identical to the one in TEST_DATABASE_URL above.
TEST_DB_USER=eanhl_test
TEST_DB_PASSWORD=CHANGE_ME
TEST_DB_HOST_PORT=5434
