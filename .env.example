# ---------------------------------------------------------------
# Copy this file to .env and fill in values before running.
# ---------------------------------------------------------------

# Database — local dev (connecting from host machine to Docker container)
DATABASE_URL=postgresql://eanhl:changeme@localhost:5432/eanhl

# Database — used inside Docker containers (web / worker containers connect to db service)
# DATABASE_URL=postgresql://eanhl:changeme@db:5432/eanhl

# PostgreSQL password used by Docker Compose to initialise the db container.
# Must match the password in DATABASE_URL above.
POSTGRES_PASSWORD=changeme

# Auth — generate a long random secret before deploying.
BETTER_AUTH_SECRET=change-this-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# EA Pro Clubs API — do not change these for club #19224
EA_CLUB_ID=19224
EA_PLATFORM=common-gen5

# Worker tuning (milliseconds) — defaults shown
POLL_INTERVAL_MS=300000
EA_REQUEST_DELAY_MS=1000
INGEST_CYCLE_TIMEOUT_MS=120000

# OCR ingest
# Set OCR_RECONCILE_ENABLED=false to disable the Action Tracker position
# reconciliation post-pass that runs at the end of each OCR batch (default: on).
OCR_RECONCILE_ENABLED=true
# Set OCR_IDENTITY_RECOVERY_ENABLED=false to disable WS4 orphan-identity recovery
# (recovering garbled-clock Action Tracker events as pending_review rows) within
# that post-pass, independently of position reconciliation (default: on).
OCR_IDENTITY_RECOVERY_ENABLED=true
# Override the Python interpreter used for the OCR + reconciliation subprocesses
# (e.g. a venv path). Defaults to python3.
OCR_PYTHON=python3

# Set OCR_DIAGNOSTICS=1 to show the OCR provenance/confidence footers on the
# game sheet without an admin account. They are operator diagnostics and are
# hidden from everyone by default (admin-only once accounts exist). Server-only
# on purpose — do NOT rename this to NEXT_PUBLIC_*.
# OCR_DIAGNOSTICS=1

# Worker health endpoint
HEALTH_PORT=3001
HEALTH_STALE_MS=1800000

# ---------------------------------------------------------------
# Host port exposure
# ---------------------------------------------------------------
# Every published port binds to 127.0.0.1 by default. Docker publishes ports
# with DNAT rules that bypass most host firewalls, so a wider binding really is
# reachable off-box regardless of ufw/firewalld. Change one of these ONLY as a
# deliberate exposure decision, and never to 0.0.0.0 in production.
#
# Public web traffic arrives through the Cloudflare Tunnel over the compose
# network, so WEB_BIND_ADDR does not need to change on a public host.
# WEB_BIND_ADDR=127.0.0.1
# WEB_HOST_PORT=3000
#
# The worker health endpoint is an operator diagnostic. Keep it on loopback and
# reach it over SSH/Tailscale, not by binding it wider.
# HEALTH_BIND_ADDR=127.0.0.1
#
# PostgreSQL. If the OCR/video-ingest pipeline on another machine needs direct
# database access, set this to THIS host's own Tailscale address — a specific
# address on the private tailnet, not 0.0.0.0. Verify afterwards with the
# port-exposure checks in DEPLOY.md; an absent tunnel route does not prove a
# published port is private.
# DB_BIND_ADDR=127.0.0.1
# DB_HOST_PORT=5433

# ---------------------------------------------------------------
# Cloudflare Tunnel (optional, opt-in)
# ---------------------------------------------------------------
# Routes the public domain to the web container without port-forwarding. Only
# hosts that publish the site need this; the tunnel is behind the `public`
# compose profile and does not start otherwise:
#
#   docker compose --profile public up -d
#
# The token is delivered as a FILE, never on the command line or in this file.
# Generate the token from the Cloudflare dashboard (Zero Trust -> Networks ->
# Tunnels) or via the API, then write it — and nothing else — into the file:
#
#   install -m 600 /dev/null ./secrets/cloudflared-tunnel-token
#   printf %s '<token>' > ./secrets/cloudflared-tunnel-token
#
# Set this only to override that default location. ./secrets/ is gitignored.
# TUNNEL_TOKEN_FILE=./secrets/cloudflared-tunnel-token
